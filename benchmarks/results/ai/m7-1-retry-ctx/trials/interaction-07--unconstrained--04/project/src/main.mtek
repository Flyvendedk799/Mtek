prefab Pip {
    param x: f32;
    position: vec3(x, 0.0, 0.0);
    mesh: Box { size: vec3(0.8, 0.8, 0.5) };
    material: Unlit { color: #38bdf8 };
}

scene Demo {
    clear_color: #202020;

    state pip_count: i32 = 0;
    state pip_refs: array<entity_ref, 5> = [Rail, Rail, Rail, Rail, Rail];

    camera Main {
        position: vec3(0.0, 0.0, 10.0);
        target: vec3(0.0, 0.0, 0.0);
        projection: Orthographic { height: 12.8 };
    }

    entity Rail {
        position: vec3(0.0, -1.5, 0.0);
        mesh: Box { size: vec3(12.0, 0.2, 0.2) };
        material: Unlit { color: #404040 };
    }

    on key_down(key_member) {
        if key_member == Key.Space {
            if pip_count < 5 {
                let x_pos: f32 = -4.0 + 2.0 * (pip_count as f32);
                pip_refs[pip_count] = spawn(Pip { x: x_pos; });
                pip_count = pip_count + 1;
            }
        }
        if key_member == Key.Backspace {
            if pip_count > 0 {
                pip_count = pip_count - 1;
                destroy(pip_refs[pip_count]);
            }
        }
        if key_member == Key.Enter {
            if pip_count > 0 {
                destroy(pip_refs[0]);
            }
            if pip_count > 1 {
                destroy(pip_refs[1]);
            }
            if pip_count > 2 {
                destroy(pip_refs[2]);
            }
            if pip_count > 3 {
                destroy(pip_refs[3]);
            }
            if pip_count > 4 {
                destroy(pip_refs[4]);
            }
            pip_count = 0;
        }
    }
}
