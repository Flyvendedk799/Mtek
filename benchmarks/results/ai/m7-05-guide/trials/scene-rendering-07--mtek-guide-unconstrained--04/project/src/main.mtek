scene Demo {
    clear_color: #10131a;

    camera Main {
        position: vec3(0.0, 3.0, 8.0);
        target: vec3(0.0, 0.5, 0.0);
        projection: Perspective {
            fov_y: 0.8;
            near: 0.1;
            far: 1000.0;
        };
    }

    entity Ball {
        position: vec3(0.0, 1.0, 0.0);
        mesh: Sphere { radius: 1.0; segments: 64 };
        material: Pbr {
            base_color: color.srgb(vec3(0.88, 0.11, 0.28), 1.0);
            metallic: 0.0;
            roughness: 0.7;
        };
    }

    entity Floor {
        position: vec3(0.0, 0.0, 0.0);
        scale: vec3(7.0, 1.0, 7.0);
        mesh: Plane { size: vec2(2.0, 2.0) };
        material: Pbr {
            base_color: color.srgb(vec3(0.6, 0.65, 0.69), 1.0);
            metallic: 0.0;
            roughness: 0.9;
        };
    }

    entity Lamp {
        position: vec3(1.5, 3.0, 2.5);
        light: PointLight {
            color: #ffffff;
            intensity: 9.0;
        };
    }

    entity AmbientLight {
        light: DirectionalLight {
            color: #ffffff;
            intensity: 0.45;
        };
    }
}
