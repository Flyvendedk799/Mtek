material Gauge {
    param level: f32 = 0.0;

    fragment(surface: SurfaceInput) -> color {
        return color.linear(vec3(level), 1.0);
    }
}

scene Demo {
    state charge: i32 = 0;
    state space_was_down: bool = false;
    state backspace_was_down: bool = false;

    clear_color: #202020;

    camera Main {
        position: vec3(0.0, 0.0, 6.0);
        target: vec3(0.0, 0.0, 0.0);
    }

    entity Meter {
        mesh: Box { size: vec3(1.0, 1.0, 1.0) };
        material: Gauge { level: bind(f32(charge) * 0.25); };
    }

    on key_down(Key.Space) {
        if !space_was_down {
            if charge < 4 {
                charge += 1;
            }
            space_was_down = true;
        }
    }

    on key_up(Key.Space) {
        space_was_down = false;
    }

    on key_down(Key.Backspace) {
        if !backspace_was_down {
            if charge > 0 {
                charge -= 1;
            }
            backspace_was_down = true;
        }
    }

    on key_up(Key.Backspace) {
        backspace_was_down = false;
    }
}
