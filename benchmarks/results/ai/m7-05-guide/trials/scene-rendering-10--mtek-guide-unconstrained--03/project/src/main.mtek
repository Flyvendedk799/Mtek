// Scene with a white ball and floor lit by red and blue point lights and tinted ambient light

scene Demo {
    camera Main {
        position: vec3(0.0, 3.0, 9.0);
        target: vec3(0.0, 0.5, 0.0);
    }

    entity Ball {
        mesh: Sphere { radius: 1.0 };
        material: BallMaterial {};
        position: vec3(0.0, 1.0, 0.0);
    }

    entity Floor {
        mesh: Plane { size: vec2(12.0, 12.0) };
        material: FloorMaterial {};
        position: vec3(0.0, 0.0, 0.0);
    }

    entity LampLeft {
        position: vec3(-3.0, 2.5, 2.0);
        light: PointLight { color: #ff3030; intensity: 9.0 };
    }

    entity LampRight {
        position: vec3(3.0, 2.5, 2.0);
        light: PointLight { color: #3050ff; intensity: 9.0 };
    }
}

material BallMaterial {
    fragment(input: SurfaceInput) -> color {
        let base_color_linear = color.linear(vec3(0.953, 0.957, 0.965), 1.0);
        let roughness = 0.7;
        let result = lighting.pbr(input, base_color_linear, 0.0, roughness);
        return result;
    }
}

material FloorMaterial {
    fragment(input: SurfaceInput) -> color {
        let base_color_linear = color.linear(vec3(0.898, 0.906, 0.925), 1.0);
        let roughness = 0.9;
        let result = lighting.pbr(input, base_color_linear, 0.0, roughness);
        return result;
    }
}
