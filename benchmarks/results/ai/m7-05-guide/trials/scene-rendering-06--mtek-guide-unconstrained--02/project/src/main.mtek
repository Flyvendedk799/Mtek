material PbrWithAmbient {
    param base_color: color = #ffffff;
    param metallic: f32 = 0.0;
    param roughness: f32 = 0.8;

    fragment(input: SurfaceInput) -> color {
        let lit = lighting.pbr(input, color.linear(base_color.rgb, 1.0), metallic, roughness);
        let ambient = base_color.rgb * 0.1;
        return color.srgb(lit.rgb + ambient, lit.a);
    }
}

scene Demo {
    state clear_color: color = #0b0d12;

    camera Main {
        position: vec3(2.5, 2.5, 5.0);
        target: vec3(0.0, 0.0, 0.0);
        projection: Perspective {
            fov_y: 0.9;
            near: 0.1;
            far: 1000.0;
        };
    }

    entity Cube {
        mesh: Box { size: vec3(2.0, 2.0, 2.0) };
        material: PbrWithAmbient {
            base_color: #c8a27a;
            metallic: 0.0;
            roughness: 0.8;
        };
        position: vec3(0.0, 0.0, 0.0);
    }

    entity Floor {
        mesh: Plane { size: vec2(10.0, 10.0) };
        material: PbrWithAmbient {
            base_color: #8a929c;
            metallic: 0.0;
            roughness: 0.9;
        };
        position: vec3(0.0, -1.0, 0.0);
    }

    entity Sun {
        light: DirectionalLight {
            color: #ffffff;
            intensity: 1.0;
        };
        rotation: quat.axis_angle(vec3(1.0, 0.0, 0.0), 0.6435011087932844);
    }
}
