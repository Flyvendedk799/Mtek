material Sweep {
    param time: f32 = 0.0;

    fragment(input: SurfaceInput) -> color {
        let x = input.local_position.x;
        let t = time;
        let w = 0.5 + 0.5 * sin(0.8 * x + t);
        
        let A = color.linear(#1a237e);
        let B = color.linear(#ffb300);
        
        let blended = (1.0 - w) * A.rgb + w * B.rgb;
        
        return color.linear(blended, 1.0);
    }
}

scene Demo {
    camera Main {
        position: vec3(0.0, 0.0, 6.0);
        target: vec3(0.0, 0.0, 0.0);
        projection: Perspective {
            fov_y: 0.9;
            near: 0.1;
            far: 1000.0;
        };
    }

    entity Panel {
        position: vec3(0.4, 0.0, 0.0);
        scale: vec3(4.0, 2.0, 0.2);
        mesh: Box { size: vec3(1.0, 1.0, 1.0) };
        material: Sweep { time: bind(frame.time) };
    }
}
