scene Demo {
    camera Main {
        position: vec3(0.0, 3.0, 8.0);
        target: vec3(0.0, 0.5, 0.0);
        projection: Perspective {
            fov_y: 0.8;
            near: 0.1;
            far: 1000.0;
        };
    }

    clear_color: #10131a;

    entity Ball {
        mesh: Sphere { radius: 1.0; };
        material: BallMaterial {};
        position: vec3(0.0, 1.0, 0.0);
    }

    entity Floor {
        mesh: Plane { size: vec2(14.0, 14.0); };
        material: FloorMaterial {};
        position: vec3(0.0, 0.0, 0.0);
    }

    entity Lamp {
        position: vec3(1.5, 3.0, 2.5);
        light: PointLight {
            color: #ffffff;
            intensity: 1.0;
        };
    }
}

material BallMaterial {
    fragment(input: SurfaceInput) -> color {
        let albedo = color.linear(vec3(0.882, 0.114, 0.282), 1.0);
        let metallic = 0.0;
        let roughness = 0.7;
        return lighting.pbr(input, albedo, metallic, roughness);
    }
}

material FloorMaterial {
    fragment(input: SurfaceInput) -> color {
        let albedo = color.linear(vec3(0.604, 0.647, 0.694), 1.0);
        let metallic = 0.0;
        let roughness = 0.9;
        return lighting.pbr(input, albedo, metallic, roughness);
    }
}
