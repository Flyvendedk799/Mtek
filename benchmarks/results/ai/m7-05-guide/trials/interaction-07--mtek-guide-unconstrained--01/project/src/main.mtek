prefab Pip {
    param x: f32;
    position: vec3(x, 0.0, 0.0);
    mesh: Box { size: vec3(0.8, 0.8, 0.5) };
    material: Unlit { color: #38bdf8 };
}

scene Demo {
    clear_color: #202020;

    camera Main {
        position: vec3(0.0, 0.0, 10.0);
        target: vec3(0.0, 0.0, 0.0);
        projection: Orthographic { height: 12.8 };
    }

    entity Rail {
        position: vec3(0.0, -1.5, 0.0);
        mesh: Box { size: vec3(12.0, 0.2, 0.2) };
        material: Unlit { color: #404040 };
    }

    state pip_count: i32 = 0;

    on key_down(Key.Space) {
        if pip_count == 0 {
            pips[0] = spawn(Pip { x: -4.0 });
            pip_count = 1;
        } else if pip_count == 1 {
            pips[1] = spawn(Pip { x: -2.0 });
            pip_count = 2;
        } else if pip_count == 2 {
            pips[2] = spawn(Pip { x: 0.0 });
            pip_count = 3;
        } else if pip_count == 3 {
            pips[3] = spawn(Pip { x: 2.0 });
            pip_count = 4;
        } else if pip_count == 4 {
            pips[4] = spawn(Pip { x: 4.0 });
            pip_count = 5;
        }
    }

    on key_down(Key.Backspace) {
        if pip_count == 5 {
            destroy(pips[4]);
            pip_count = 4;
        } else if pip_count == 4 {
            destroy(pips[3]);
            pip_count = 3;
        } else if pip_count == 3 {
            destroy(pips[2]);
            pip_count = 2;
        } else if pip_count == 2 {
            destroy(pips[1]);
            pip_count = 1;
        } else if pip_count == 1 {
            destroy(pips[0]);
            pip_count = 0;
        }
    }

    on key_down(Key.Enter) {
        if pip_count >= 1 {
            destroy(pips[0]);
        }
        if pip_count >= 2 {
            destroy(pips[1]);
        }
        if pip_count >= 3 {
            destroy(pips[2]);
        }
        if pip_count >= 4 {
            destroy(pips[3]);
        }
        if pip_count >= 5 {
            destroy(pips[4]);
        }
        pip_count = 0;
    }

    var pips: array<entity_ref, 5>;
}
