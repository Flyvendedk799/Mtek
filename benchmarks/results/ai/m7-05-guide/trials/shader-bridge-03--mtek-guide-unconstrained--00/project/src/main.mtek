material Sweep {
    param time: f32 = 0.0;

    fragment(input: SurfaceInput) -> color {
        let x = input.local_position.x * 4.0;
        let w = 0.5 + 0.5 * sin(0.8 * x + time);
        
        let a_srgb = vec3(0.10196078, 0.13725490, 0.49411764);
        let b_srgb = vec3(1.0, 0.70196078, 0.0);
        
        let a_linear = color.linear(a_srgb, 1.0).rgb;
        let b_linear = color.linear(b_srgb, 1.0).rgb;
        
        let mixed = (1.0 - w) * a_linear + w * b_linear;
        
        return color.srgb(mixed, 1.0);
    }
}

scene Demo {
    camera Main {
        position: vec3(0.0, 0.0, 6.0);
        target: vec3(0.0, 0.0, 0.0);
        projection: Perspective {
            fov_y: 0.9;
            near: 0.1;
            far: 1000.0;
        };
    }

    entity Panel {
        position: vec3(0.4, 0.0, 0.0);
        scale: vec3(4.0, 2.0, 0.2);
        mesh: Box { size: vec3(1.0, 1.0, 1.0) };
        material: Sweep { time: bind(frame.time) };
    }
}
