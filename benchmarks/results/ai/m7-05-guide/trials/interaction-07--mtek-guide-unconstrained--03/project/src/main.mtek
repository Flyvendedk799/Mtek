prefab Pip {
    param x: f32;
    position: vec3(x, 0.0, 0.0);
    mesh: Box { size: vec3(0.8, 0.8, 0.5) };
    material: Unlit { color: #38bdf8 };
}

scene Demo {
    state pip_count: i32 = 0;
    state pips: array<entity_ref, 5>;

    clear_color: #202020;

    camera Main {
        position: vec3(0.0, 0.0, 10.0);
        target: vec3(0.0, 0.0, 0.0);
        projection: Orthographic { height: 12.8 };
    }

    entity Rail {
        position: vec3(0.0, -1.5, 0.0);
        mesh: Box { size: vec3(12.0, 0.2, 0.2) };
        material: Unlit { color: #404040 };
    }

    on key_down(Key.Space) {
        if pip_count < 5 {
            let x_pos: f32 = -4.0 + 2.0 * f32(pip_count);
            let pip_ref: entity_ref = spawn(Pip { x: x_pos; });
            pips[pip_count] = pip_ref;
            pip_count += 1;
        }
    }

    on key_down(Key.Backspace) {
        if pip_count > 0 {
            pip_count -= 1;
            destroy(pips[pip_count]);
        }
    }

    on key_down(Key.Enter) {
        if pip_count > 0 { destroy(pips[0]); }
        if pip_count > 1 { destroy(pips[1]); }
        if pip_count > 2 { destroy(pips[2]); }
        if pip_count > 3 { destroy(pips[3]); }
        if pip_count > 4 { destroy(pips[4]); }
        pip_count = 0;
    }
}
