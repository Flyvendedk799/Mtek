scene Demo {
    clear_color: #202020;

    state accumulator: f32 = 0.0;
    state tick_count: i32 = 0;
    state program_time: f32 = 0.0;

    camera Main {
        position: vec3(0.0, 0.0, 10.0);
        target: vec3(0.0, 0.0, 0.0);
        projection: Orthographic { height: 12.8 };
    }

    entity Ticker {
        position: vec3(-5.5, 3.0, 0.0);
        mesh: Box { size: vec3(1.0, 1.0, 0.5) };
        material: Unlit { color: #ef4444 };
    }

    entity Glider {
        position: vec3(-5.5, -3.0, 0.0);
        mesh: Box { size: vec3(1.0, 1.0, 0.5) };
        material: Unlit { color: #38bdf8 };
    }

    update(dt: f32) {
        let capped_dt = min(dt, 0.1);
        program_time = program_time + capped_dt;
        accumulator = accumulator + capped_dt;

        let TICK_TIME = 1.0 / 60.0;
        var ticks_this_frame = 0;

        for i in 0..4 {
            if accumulator >= TICK_TIME && ticks_this_frame < 4 {
                accumulator = accumulator - TICK_TIME;
                tick_count = tick_count + 1;
                ticks_this_frame = ticks_this_frame + 1;
            }
        }

        if accumulator >= TICK_TIME {
            accumulator = 0.0;
        }

        Ticker.position.x = -5.5 + f32(tick_count) * 0.1;
        Glider.position.x = -5.5 + program_time * 6.0;
    }
}
