material Gauge {
    param level: f32 = 0.0;

    fragment(surface: SurfaceInput) -> color {
        return color.linear(vec3(level), 1.0);
    }
}

scene Demo {
    state charge: f32 = 0.0;
    state space_down: bool = false;
    state backspace_down: bool = false;

    clear_color: #202020;

    camera Main {
        position: vec3(0.0, 0.0, 6.0);
        target: vec3(0.0, 0.0, 0.0);
    }

    entity Meter {
        mesh: Box { size: vec3(1.0, 1.0, 1.0) };
        material: Gauge { level: bind(charge * 0.25); };
    }

    on key_down(event) bind(key: event) {
        if key == Key.Space && !space_down {
            space_down = true;
            if charge < 4.0 {
                charge = charge + 1.0;
            }
        } else if key == Key.Backspace && !backspace_down {
            backspace_down = true;
            if charge > 0.0 {
                charge = charge - 1.0;
            }
        }
    }

    on key_up(event) bind(key: event) {
        if key == Key.Space {
            space_down = false;
        } else if key == Key.Backspace {
            backspace_down = false;
        }
    }
}
