const picture: texture = asset.texture("./assets/swatch.png");

material PlainMaterial {
  param tex: texture = picture;
  param samp: sampler = sampler.nearest_clamp();

  fragment(input: SurfaceInput) -> color {
    let uv: vec2 = vec2(input.uv.x, 1.0 - input.uv.y);
    let tex_color: vec4 = sample(tex, samp, uv);
    return color.linear(vec3(tex_color.x, tex_color.y, tex_color.z), tex_color.w);
  }
}

material TiledMaterial {
  param tex: texture = picture;
  param samp: sampler = sampler.nearest_repeat();

  fragment(input: SurfaceInput) -> color {
    let uv: vec2 = vec2(input.uv.x, 1.0 - input.uv.y);
    let tex_color: vec4 = sample(tex, samp, uv);
    return color.linear(vec3(tex_color.x, tex_color.y, tex_color.z), tex_color.w);
  }
}

material SmoothMaterial {
  param tex: texture = picture;
  param samp: sampler = sampler.linear_clamp();

  fragment(input: SurfaceInput) -> color {
    let uv: vec2 = vec2(input.uv.x, 1.0 - input.uv.y);
    let tex_color: vec4 = sample(tex, samp, uv);
    return color.linear(vec3(tex_color.x, tex_color.y, tex_color.z), tex_color.w);
  }
}

scene Demo {
  clear_color: #1b2430;

  camera Main {
    position: vec3(0.0, 11.0, 3.0);
    target: vec3(0.0, 0.0, 0.0);
    projection: Perspective {
      fov_y: 0.72;
      near: 0.1;
      far: 1000.0;
    };
  }

  entity Plain {
    position: vec3(-2.0, 0.0, -2.0);
    mesh: Plane { size: vec2(3.6, 3.6); };
    material: PlainMaterial {};
  }

  entity Tiled {
    position: vec3(0.0, 0.0, 2.0);
    mesh: Plane { size: vec2(3.6, 3.6); };
    material: TiledMaterial {};
  }

  entity Smooth {
    position: vec3(2.0, 0.0, -2.0);
    mesh: Plane { size: vec2(3.6, 3.6); };
    material: SmoothMaterial {};
  }
}
