const A = color.srgb(vec3(0.10196078, 0.13725490, 0.49411764), 1.0);
const B = color.srgb(vec3(1.0, 0.7019608, 0.0), 1.0);

material Sweep {
  param time: f32 = 0.0;

  fragment(surface: SurfaceInput) -> color {
    let x = surface.local_position.x;
    let w = 0.5 + 0.5 * sin(0.8 * x + time);
    let blended_rgb = (1.0 - w) * A.rgb + w * B.rgb;
    return color.linear(blended_rgb, 1.0);
  }
}

scene Demo {
  clear_color: #202020;

  camera Main {
    position: vec3(0.0, 0.0, 6.0);
    projection: Perspective {
      fov_y: 0.9;
      near: 0.1;
      far: 1000.0;
    };
  }

  entity Panel {
    position: vec3(0.4, 0.0, 0.0);
    mesh: Box {
      size: vec3(4.0, 2.0, 0.2);
    };
    material: Sweep {
      time: bind(frame.time);
    };
  }
}
