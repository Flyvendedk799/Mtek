scene Demo {
    clear_color: #202020;

    state accumulator: f32 = 0.0;
    const TICK_DURATION: f32 = 0.016666668;
    const MAX_TICKS: i32 = 4;
    const MAX_FRAME_TIME: f32 = 0.1;

    camera Main {
        position: vec3(0.0, 0.0, 10.0);
        target: vec3(0.0, 0.0, 0.0);
        projection: Orthographic { height: 12.8 };
    }

    entity Ticker {
        position: vec3(-5.5, 3.0, 0.0);
        mesh: Box { size: vec3(1.0, 1.0, 0.5) };
        material: Unlit { color: #ef4444 };

        fixed_update(dt: f32) {
            self.position.x += 0.1;
        }
    }

    entity Glider {
        position: vec3(-5.5, -3.0, 0.0);
        mesh: Box { size: vec3(1.0, 1.0, 0.5) };
        material: Unlit { color: #38bdf8 };

        update(dt: f32) {
            self.position.x += 6.0 * dt;
        }
    }

    update(dt: f32) {
        let clamped_dt = min(dt, MAX_FRAME_TIME);
        accumulator += clamped_dt;
        var ticks = 0;
        for i in 0..MAX_TICKS {
            if accumulator >= TICK_DURATION {
                accumulator -= TICK_DURATION;
                ticks = ticks + 1;
            }
        }
    }
}
