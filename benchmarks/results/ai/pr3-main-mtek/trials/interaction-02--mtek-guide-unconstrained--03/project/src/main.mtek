scene Demo {
    clear_color: #202020;

    state handle_x: f32 = 0.0;

    camera Main {
        position: vec3(0.0, 0.0, 10.0);
        target: vec3(0.0, 0.0, 0.0);
        projection: Orthographic { height: 12.8 };
    }

    entity Track {
        position: vec3(0.0, -1.0, 0.0);
        mesh: Box { size: vec3(10.0, 0.2, 0.2) };
        material: Unlit { color: #404040 };
    }

    entity Handle {
        mesh: Box { size: vec3(0.8, 0.8, 0.5) };
        material: Unlit { color: bind(color.srgb(mix(color.linear(#ffd24a, 1.0).rgb, color.linear(#ef4444, 1.0).rgb, step(0.5, 0.5 + step(0.5, abs(handle_x - 4.0)) * step(0.5, abs(handle_x + 4.0)))), 1.0)); };
        position: bind(vec3(handle_x, 0.0, 0.0));
    }

    on key_down(Key.ArrowRight) {
        handle_x = min(handle_x + 1.0, 4.0);
    }

    on key_down(Key.ArrowLeft) {
        handle_x = max(handle_x - 1.0, -4.0);
    }

    on key_down(Key.Enter) {
        handle_x = 0.0;
    }
}
