scene Demo {
    clear_color: #202020;
    state accumulator: f32 = 0.0;
    state last_dt: f32 = 0.0;

    camera Main {
        position: vec3(0.0, 0.0, 10.0);
        target: vec3(0.0, 0.0, 0.0);
        projection: Orthographic { height: 12.8 };
    }

    entity Ticker {
        position: vec3(-5.5, 3.0, 0.0);
        mesh: Box { size: vec3(1.0, 1.0, 0.5) };
        material: Unlit { color: #ef4444 };

        update(dt: f32) {
            let capped_dt: f32 = min(dt, 0.1);
            last_dt = capped_dt;
            accumulator = accumulator + capped_dt;
            let step_duration: f32 = 1.0 / 60.0;
            
            if accumulator >= step_duration {
                accumulator = accumulator - step_duration;
                self.position = self.position + vec3(0.1, 0.0, 0.0);
            }
            
            if accumulator >= step_duration {
                accumulator = accumulator - step_duration;
                self.position = self.position + vec3(0.1, 0.0, 0.0);
            }
            
            if accumulator >= step_duration {
                accumulator = accumulator - step_duration;
                self.position = self.position + vec3(0.1, 0.0, 0.0);
            }
            
            if accumulator >= step_duration {
                accumulator = accumulator - step_duration;
                self.position = self.position + vec3(0.1, 0.0, 0.0);
            }
        }
    }

    entity Glider {
        position: vec3(-5.5, -3.0, 0.0);
        mesh: Box { size: vec3(1.0, 1.0, 0.5) };
        material: Unlit { color: #38bdf8 };

        update(dt: f32) {
            let glider_distance: f32 = 6.0 * last_dt;
            self.position = self.position + vec3(glider_distance, 0.0, 0.0);
        }
    }
}
