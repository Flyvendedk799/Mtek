material Sweep {
    param time: f32 = 0.0;

    fragment(input: SurfaceInput) -> color {
        // Get x coordinate in object space
        let x = input.local_position.x;
        
        // Compute the blend weight
        let w = 0.5 + 0.5 * sin(0.8 * x + time);
        
        // Define colors in sRGB and convert to linear
        let a_srgb = #1a237e;
        let b_srgb = #ffb300;
        
        // Convert sRGB colors to linear
        let a_linear = color.linear(a_srgb.rgb, 1.0);
        let b_linear = color.linear(b_srgb.rgb, 1.0);
        
        // Blend in linear light: (1 - w) * A + w * B
        let blended_rgb = (1.0 - w) * a_linear.rgb + w * b_linear.rgb;
        
        // Return as linear color
        return color.linear(blended_rgb, 1.0);
    }
}

scene Demo {
    clear_color: #202020;

    camera Main {
        position: vec3(0.0, 0.0, 6.0);
        target: vec3(0.0, 0.0, 0.0);
        projection: Perspective { fov_y: 0.9; near: 0.1; far: 1000.0 };
    }

    entity Panel {
        position: vec3(0.4, 0.0, 0.0);
        mesh: Box { size: vec3(4.0, 2.0, 0.2) };
        material: Sweep { time: bind(frame.time) };
    }
}
