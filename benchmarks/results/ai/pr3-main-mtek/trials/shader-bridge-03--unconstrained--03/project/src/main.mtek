material Sweep {
  param time: f32;
  
  fragment(surface: SurfaceInput) -> color {
    let x = surface.local_position.x;
    let w = 0.5 + 0.5 * sin(0.8 * x + time);
    
    let A_srgb = vec3(26.0 / 255.0, 35.0 / 255.0, 126.0 / 255.0);
    let B_srgb = vec3(255.0 / 255.0, 179.0 / 255.0, 0.0 / 255.0);
    
    let A_linear = color.srgb(A_srgb, 1.0);
    let B_linear = color.srgb(B_srgb, 1.0);
    
    let result = color.linear(
      (1.0 - w) * A_linear.rgb + w * B_linear.rgb,
      1.0
    );
    
    return result;
  }
}

scene Demo {
  clear_color: #202020;
  ambient_color: #ffffff;
  ambient_intensity: 0.0;
  
  camera Main {
    position: vec3(0.0, 0.0, 6.0);
    projection: Perspective {
      fov_y: 0.9;
      near: 0.1;
      far: 1000.0;
    };
  }
  
  entity Panel {
    position: vec3(0.4, 0.0, 0.0);
    mesh: Box { size: vec3(4.0, 2.0, 0.2); };
    material: Sweep {
      time: bind(frame.time);
    };
  }
}
