fn charge_to_level(c: i32) -> f32 {
    return f32(c) * 0.25;
}

material Gauge {
    param level: f32 = 0.0;

    fragment(surface: SurfaceInput) -> color {
        return color.linear(vec3(level), 1.0);
    }
}

scene Demo {
    clear_color: #202020;
    state charge: i32 = 0;
    state space_down: bool = false;
    state backspace_down: bool = false;

    camera Main {
        position: vec3(0.0, 0.0, 6.0);
        target: vec3(0.0, 0.0, 0.0);
    }

    entity Meter {
        mesh: Box { size: vec3(1.0, 1.0, 1.0) };
        material: Gauge { level: bind(charge_to_level(charge)); };
    }

    on key_down(_) {
        if is_key_down(Key.Space) {
            if !space_down {
                space_down = true;
                if charge < 4 {
                    charge = charge + 1;
                }
            }
        }
        if is_key_down(Key.Backspace) {
            if !backspace_down {
                backspace_down = true;
                if charge > 0 {
                    charge = charge - 1;
                }
            }
        }
    }

    on key_up(_) {
        if !is_key_down(Key.Space) {
            space_down = false;
        }
        if !is_key_down(Key.Backspace) {
            backspace_down = false;
        }
    }
}
