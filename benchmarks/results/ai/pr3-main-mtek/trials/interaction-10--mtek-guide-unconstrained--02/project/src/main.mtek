scene Demo {
    clear_color: #202020;

    camera Main {
        position: vec3(0.0, 0.0, 10.0);
        target: vec3(0.0, 0.0, 0.0);
        projection: Orthographic { height: 12.8 };
    }

    entity Field {
        position: vec3(0.0, 0.0, -1.0);
        mesh: Box { size: vec3(10.0, 10.0, 0.2) };
        material: Unlit { color: #303030 };
    }

    entity Ship {
        position: vec3(0.0, 0.0, 0.0);
        mesh: Box { size: vec3(2.0, 2.0, 0.5) };
        material: Unlit { color: #38bdf8 };

        update(dt: f32) {
            let speed = 8.0;
            var dx = 0.0;
            var dy = 0.0;

            if is_key_down(Key.ArrowRight) {
                dx += speed * dt;
            }
            if is_key_down(Key.ArrowLeft) {
                dx -= speed * dt;
            }
            if is_key_down(Key.ArrowUp) {
                dy += speed * dt;
            }
            if is_key_down(Key.ArrowDown) {
                dy -= speed * dt;
            }

            self.position.x += dx;
            self.position.y += dy;

            self.position.x = clamp(self.position.x, -4.0, 4.0);
            self.position.y = clamp(self.position.y, -4.0, 4.0);
        }
    }
}
