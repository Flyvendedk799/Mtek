scene Demo {
    clear_color: #202020;
    state power: i32 = 0;
    state space_held: bool = false;
    state stone_x: f32 = -4.0;
    state stone_color: color = #ffd24a;

    camera Main {
        position: vec3(0.0, 0.0, 10.0);
        target: vec3(0.0, 0.0, 0.0);
        projection: Orthographic { height: 12.8 };
    }

    entity Rail {
        position: vec3(0.0, -1.1, 0.0);
        mesh: Box { size: vec3(12.0, 0.2, 0.2) };
        material: Unlit { color: #404040 };
    }

    entity Stone {
        position: bind(vec3(stone_x, 0.0, 0.0));
        mesh: Box { size: vec3(2.0, 2.0, 0.5) };
        material: Unlit { color: bind(stone_color); };
    }

    entity Power {
        position: bind(vec3(-5.5 + f32(power), 3.5, 0.0));
        mesh: Box { size: vec3(1.0, 1.0, 0.5) };
        material: Unlit { color: #38bdf8 };
    }

    on key_down(Key.Space) {
        space_held = true;
        stone_color = #ff7a1a;
    }

    on key_down(Key.ArrowUp) {
        if space_held && power < 5 {
            power = power + 1;
        }
    }

    on key_up(Key.Space) {
        space_held = false;
        stone_color = #ffd24a;
        let launch_distance = f32(power) * 2.0;
        stone_x = min(stone_x + launch_distance, 5.0);
        power = 0;
    }
}
