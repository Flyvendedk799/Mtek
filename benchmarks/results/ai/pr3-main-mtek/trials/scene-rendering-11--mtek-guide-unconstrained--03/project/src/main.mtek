const SWATCH = asset.texture("../assets/swatch.png");

material PlainMaterial {
    param tex: texture = texture.white();
    param smp: sampler = sampler.nearest_clamp();
    
    fragment(input: SurfaceInput) -> color {
        let uv = input.uv;
        let sampled = sample(tex, smp, uv);
        return color.linear(sampled.xyz, 1.0);
    }
}

material TiledMaterial {
    param tex: texture = texture.white();
    param smp: sampler = sampler.nearest_repeat();
    
    fragment(input: SurfaceInput) -> color {
        let uv = input.uv * 2.0;
        let sampled = sample(tex, smp, uv);
        return color.linear(sampled.xyz, 1.0);
    }
}

material SmoothMaterial {
    param tex: texture = texture.white();
    param smp: sampler = sampler.linear_clamp();
    
    fragment(input: SurfaceInput) -> color {
        let sampled = sample(tex, smp, input.uv);
        return color.linear(sampled.xyz, 1.0);
    }
}

scene Demo {
    clear_color: #1b2430;
    
    camera Main {
        position: vec3(0.0, 11.0, 3.0);
        target: vec3(0.0, 0.0, 0.0);
        projection: Perspective {
            fov_y: 0.72;
            near: 0.1;
            far: 1000.0;
        };
    }
    
    entity Plain {
        position: vec3(-2.0, 0.0, -2.0);
        mesh: Plane { size: vec2(3.6, 3.6) };
        material: PlainMaterial { tex: SWATCH };
    }
    
    entity Tiled {
        position: vec3(0.0, 0.0, 2.0);
        mesh: Plane { size: vec2(3.6, 3.6) };
        material: TiledMaterial { tex: SWATCH };
    }
    
    entity Smooth {
        position: vec3(2.0, 0.0, -2.0);
        mesh: Plane { size: vec2(3.6, 3.6) };
        material: SmoothMaterial { tex: SWATCH };
    }
}
