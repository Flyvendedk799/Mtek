scene Demo {
    clear_color: #202020;
    
    state accumulated_time: f32 = 0.0;

    camera Main {
        position: vec3(0.0, 0.0, 10.0);
        target: vec3(0.0, 0.0, 0.0);
        projection: Orthographic { height: 12.8 };
    }

    entity Ticker {
        position: vec3(-5.5, 3.0, 0.0);
        mesh: Box { size: vec3(1.0, 1.0, 0.5) };
        material: Unlit { color: #ef4444 };

        update(dt: f32) {
            let clamped_dt: f32 = min(dt, 0.1);
            let step_duration: f32 = 1.0 / 60.0;
            accumulated_time = accumulated_time + clamped_dt;
            
            let total_ticks: i32 = i32(accumulated_time / step_duration);
            let ticks: i32 = min(total_ticks, 4);
            let movement: f32 = f32(ticks) * 0.1;
            
            self.position = vec3(self.position.x + movement, self.position.y, self.position.z);
            accumulated_time = accumulated_time - (f32(total_ticks) * step_duration);
        }
    }

    entity Glider {
        position: vec3(-5.5, -3.0, 0.0);
        mesh: Box { size: vec3(1.0, 1.0, 0.5) };
        material: Unlit { color: #38bdf8 };

        update(dt: f32) {
            let clamped_dt: f32 = min(dt, 0.1);
            self.position = vec3(self.position.x + 6.0 * clamped_dt, self.position.y, self.position.z);
        }
    }
}
