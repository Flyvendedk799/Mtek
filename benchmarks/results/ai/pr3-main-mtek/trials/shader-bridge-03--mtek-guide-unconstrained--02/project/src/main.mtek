material Sweep {
    param time: f32 = 0.0;

    fragment(input: SurfaceInput) -> color {
        // Get x coordinate in object space (runs from -2 to 2 across the panel)
        let x = input.local_position.x;
        
        // Compute the blend weight using sine wave
        let w = 0.5 + 0.5 * sin(0.8 * x + time);
        
        // Define colors in sRGB and convert to linear
        let A = color.srgb(vec3(26.0 / 255.0, 35.0 / 255.0, 126.0 / 255.0), 1.0);
        let B = color.srgb(vec3(255.0 / 255.0, 179.0 / 255.0, 0.0 / 255.0), 1.0);
        
        // Blend in linear light: (1 - w) * A + w * B
        let blended = color.linear(
            (1.0 - w) * A.rgb + w * B.rgb,
            1.0
        );
        
        return blended;
    }
}

scene Demo {
    clear_color: #202020;

    camera Main {
        position: vec3(0.0, 0.0, 6.0);
        target: vec3(0.0, 0.0, 0.0);
        projection: Perspective { fov_y: 0.9; near: 0.1; far: 1000.0; };
    }

    entity Panel {
        position: vec3(0.4, 0.0, 0.0);
        mesh: Box { size: vec3(4.0, 2.0, 0.2); };
        material: Sweep { time: bind(frame.time); };
    }
}
