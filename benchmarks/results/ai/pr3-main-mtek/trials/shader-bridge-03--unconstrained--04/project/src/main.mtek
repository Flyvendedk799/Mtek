material Sweep {
  param time: f32;

  fragment(surface: SurfaceInput) -> color {
    let x = surface.local_position.x;
    let w = 0.5 + 0.5 * sin(0.8 * x + time);
    
    // A = #1a237e in sRGB: (26/255, 35/255, 126/255) = (0.102, 0.137, 0.494)
    let A_srgb = vec3(26.0 / 255.0, 35.0 / 255.0, 126.0 / 255.0);
    // B = #ffb300 in sRGB: (255/255, 179/255, 0/255) = (1.0, 0.702, 0.0)
    let B_srgb = vec3(1.0, 179.0 / 255.0, 0.0);
    
    // Convert from sRGB to linear
    let A_linear = color.srgb(A_srgb, 1.0);
    let B_linear = color.srgb(B_srgb, 1.0);
    
    // Blend in linear light
    let result_linear = (1.0 - w) * A_linear.rgb + w * B_linear.rgb;
    
    // Return as linear color
    return color.linear(result_linear, 1.0);
  }
}

scene Demo {
  clear_color: #202020;
  
  camera Main {
    position: vec3(0.0, 0.0, 6.0);
    projection: Perspective {
      fov_y: 0.9;
      near: 0.1;
      far: 1000.0;
    };
  }
  
  entity Panel {
    position: vec3(0.4, 0.0, 0.0);
    mesh: Box {
      size: vec3(4.0, 2.0, 0.2);
    };
    material: Sweep {
      time: bind(frame.time);
    };
  }
}
