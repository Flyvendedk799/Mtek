scene Demo {
    clear_color: #202020;

    state lampA_on: bool = false;
    state lampB_on: bool = false;

    camera Main {
        position: vec3(0.0, 0.0, 10.0);
        target: vec3(0.0, 0.0, 0.0);
        projection: Orthographic { height: 12.8 };
    }

    entity LampA {
        position: vec3(-3.0, 0.0, 0.0);
        mesh: Box { size: vec3(2.0, 2.0, 0.5) };
        material: Unlit { color: bind(mix(color.srgb(#3a3a3a.rgb, 1.0), color.srgb(#ffd24a.rgb, 1.0), step(0.5, f32(lampA_on)))); };
    }

    entity LampB {
        position: vec3(3.0, 0.0, 0.0);
        mesh: Box { size: vec3(2.0, 2.0, 0.5) };
        material: Unlit { color: bind(mix(color.srgb(#3a3a3a.rgb, 1.0), color.srgb(#ffd24a.rgb, 1.0), step(0.5, f32(lampB_on)))); };
    }

    on key_down(Key.A) {
        lampA_on = !lampA_on;
    }

    on key_down(Key.B) {
        lampB_on = !lampB_on;
    }

    on key_down(Key.Space) {
        lampA_on = !lampA_on;
        lampB_on = !lampB_on;
    }

    on key_down(Key.Enter) {
        lampA_on = false;
        lampB_on = false;
    }
}
