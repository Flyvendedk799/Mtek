struct RunnerState {
    is_moving: bool;
    position_x: f32;
}

scene Demo {
    clear_color: #202020;

    camera Main {
        position: vec3(0.0, 0.0, 10.0);
        projection: Orthographic {
            height: 12.8;
            near: 0.1;
            far: 1000.0;
        };
    }

    state demo_state: RunnerState = RunnerState {
        is_moving: false;
        position_x: -5.0;
    };

    entity Track {
        position: vec3(0.0, -1.0, 0.0);
        mesh: Box { size: vec3(12.0, 0.2, 0.2); };
        material: Unlit { color: #404040; };
    }

    entity Runner {
        position: bind(vec3(demo_state.position_x, 0.0, 0.0));
        mesh: Box { size: vec3(1.0, 1.0, 0.5); };
        material: Unlit { color: #f97316; };
    }

    on key_down(Key.Space) {
        demo_state.is_moving = !demo_state.is_moving;
    }
}

fn update(dt: f32) {
    if Demo.demo_state.is_moving {
        Demo.demo_state.position_x = Demo.demo_state.position_x + 4.0 * dt;
        if Demo.demo_state.position_x >= 6.0 {
            Demo.demo_state.position_x = Demo.demo_state.position_x - 12.0;
        }
    }
}
