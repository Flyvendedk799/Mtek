material Gauge {
    param level: f32 = 0.0;

    fragment(surface: SurfaceInput) -> color {
        return color.linear(vec3(level), 1.0);
    }
}

scene Demo {
    clear_color: #202020;
    state charge: i32 = 0;
    state space_was_down: bool = false;
    state backspace_was_down: bool = false;

    camera Main {
        position: vec3(0.0, 0.0, 6.0);
        target: vec3(0.0, 0.0, 0.0);
    }

    entity Meter {
        mesh: Box { size: vec3(1.0, 1.0, 1.0) };
        material: Gauge { level: bind(charge * 0.25); };

        update(dt: f32) {
            let space_now: bool = is_key_down(Key.Space);
            let backspace_now: bool = is_key_down(Key.Backspace);

            if (space_now && !space_was_down) {
                charge = clamp(charge + 1, 0, 4);
            }
            if (backspace_now && !backspace_was_down) {
                charge = clamp(charge - 1, 0, 4);
            }

            space_was_down = space_now;
            backspace_was_down = backspace_now;
        }
    }
}
