material Gauge {
    param level: f32 = 0.0;

    fragment(surface: SurfaceInput) -> color {
        return color.linear(vec3(level), 1.0);
    }
}

scene Demo {
    clear_color: #202020;
    
    state charge: i32 = 0;

    camera Main {
        position: vec3(0.0, 0.0, 6.0);
        target: vec3(0.0, 0.0, 0.0);
    }

    entity Meter {
        mesh: Box { size: vec3(1.0, 1.0, 1.0) };
        material: Gauge { level: bind(f32(charge) / 4.0); };
    }
    
    on key_down(key: Key) {
        if key == Key.Space {
            if charge < 4 {
                charge = charge + 1;
            }
        } else if key == Key.Backspace {
            if charge > 0 {
                charge = charge - 1;
            }
        }
    }
}
