scene Demo {
    clear_color: #202020;

    state lampA_on: bool = false;
    state lampB_on: bool = false;
    state lampA_color: color = #3a3a3a;
    state lampB_color: color = #3a3a3a;
    state a_pressed: bool = false;
    state b_pressed: bool = false;
    state space_pressed: bool = false;
    state enter_pressed: bool = false;

    camera Main {
        position: vec3(0.0, 0.0, 10.0);
        target: vec3(0.0, 0.0, 0.0);
        projection: Orthographic { height: 12.8 };
    }

    entity LampA {
        position: vec3(-3.0, 0.0, 0.0);
        mesh: Box { size: vec3(2.0, 2.0, 0.5) };
        material: Unlit { color: bind(lampA_color); };
    }

    entity LampB {
        position: vec3(3.0, 0.0, 0.0);
        mesh: Box { size: vec3(2.0, 2.0, 0.5) };
        material: Unlit { color: bind(lampB_color); };
    }

    on key_down(Key.A) {
        if (!a_pressed) {
            a_pressed = true;
            lampA_on = !lampA_on;
            if (lampA_on) {
                lampA_color = #ffd24a;
            } else {
                lampA_color = #3a3a3a;
            }
        }
    }

    on key_down(Key.B) {
        if (!b_pressed) {
            b_pressed = true;
            lampB_on = !lampB_on;
            if (lampB_on) {
                lampB_color = #ffd24a;
            } else {
                lampB_color = #3a3a3a;
            }
        }
    }

    on key_down(Key.Space) {
        if (!space_pressed) {
            space_pressed = true;
            lampA_on = !lampA_on;
            lampB_on = !lampB_on;
            if (lampA_on) {
                lampA_color = #ffd24a;
            } else {
                lampA_color = #3a3a3a;
            }
            if (lampB_on) {
                lampB_color = #ffd24a;
            } else {
                lampB_color = #3a3a3a;
            }
        }
    }

    on key_down(Key.Enter) {
        if (!enter_pressed) {
            enter_pressed = true;
            lampA_on = false;
            lampB_on = false;
            lampA_color = #3a3a3a;
            lampB_color = #3a3a3a;
        }
    }

    on key_up(Key.A) {
        a_pressed = false;
    }

    on key_up(Key.B) {
        b_pressed = false;
    }

    on key_up(Key.Space) {
        space_pressed = false;
    }

    on key_up(Key.Enter) {
        enter_pressed = false;
    }
}
