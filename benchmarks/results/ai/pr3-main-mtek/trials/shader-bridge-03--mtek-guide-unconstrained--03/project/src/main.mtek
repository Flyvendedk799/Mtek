material Sweep {
    param time: f32 = 0.0;

    fragment(input: SurfaceInput) -> color {
        let x = input.local_position.x;
        let t = time;
        
        // Compute the blend factor
        let w = 0.5 + 0.5 * sin(0.8 * x + t);
        
        // Color A: #1a237e in sRGB, convert to linear
        let A = color.srgb(vec3(26.0 / 255.0, 35.0 / 255.0, 126.0 / 255.0), 1.0);
        
        // Color B: #ffb300 in sRGB, convert to linear
        let B = color.srgb(vec3(1.0, 179.0 / 255.0, 0.0), 1.0);
        
        // Linear blend: (1-w)*A + w*B
        // Both A and B are already in linear light from color.srgb
        let result_rgb = (1.0 - w) * A.rgb + w * B.rgb;
        
        // Return as linear color
        return color.linear(result_rgb, 1.0);
    }
}

scene Demo {
    clear_color: #202020;

    camera Main {
        position: vec3(0.0, 0.0, 6.0);
        target: vec3(0.0, 0.0, 0.0);
        projection: Perspective {
            fov_y: 0.9;
            near: 0.1;
            far: 1000.0;
        };
    }

    entity Panel {
        position: vec3(0.4, 0.0, 0.0);
        mesh: Box { size: vec3(4.0, 2.0, 0.2) };
        material: Sweep { time: bind(frame.time) };
    }
}
