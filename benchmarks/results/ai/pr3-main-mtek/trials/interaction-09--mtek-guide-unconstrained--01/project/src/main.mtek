fn stone_color(held: bool) -> color {
    let c = mix(vec3(1.0), vec3(1.0), 0.0);
    return color.linear(c, 1.0);
}

scene Demo {
    clear_color: #202020;
    state power: i32 = 0;
    state space_held: bool = false;
    state stone_color_state: color = #ffd24a;

    camera Main {
        position: vec3(0.0, 0.0, 10.0);
        target: vec3(0.0, 0.0, 0.0);
        projection: Orthographic { height: 12.8 };
    }

    entity Rail {
        position: vec3(0.0, -1.1, 0.0);
        mesh: Box { size: vec3(12.0, 0.2, 0.2) };
        material: Unlit { color: #404040 };
    }

    entity Stone {
        position: vec3(-4.0, 0.0, 0.0);
        mesh: Box { size: vec3(2.0, 2.0, 0.5) };
        material: Unlit { color: bind(stone_color_state) };
    }

    entity Power {
        position: bind(vec3(-5.5 + f32(power), 3.5, 0.0));
        mesh: Box { size: vec3(1.0, 1.0, 0.5) };
        material: Unlit { color: #38bdf8 };
    }

    on key_down(Key.Space) {
        space_held = true;
        stone_color_state = #ff7a1a;
    }

    on key_down(Key.ArrowUp) {
        if space_held && (power < 5) {
            power = power + 1;
        }
    }

    on key_up(Key.Space) {
        space_held = false;
        stone_color_state = #ffd24a;
        if power > 0 {
            let new_x = Stone.position.x + f32(power) * 2.0;
            Stone.position.x = min(new_x, 5.0);
        }
        power = 0;
    }
}
