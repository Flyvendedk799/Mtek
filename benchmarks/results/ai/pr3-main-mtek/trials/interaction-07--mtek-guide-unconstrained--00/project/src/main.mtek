prefab Pip {
    param x: f32;
    position: vec3(x, 0.0, 1.0);
    mesh: Box { size: vec3(0.8, 0.8, 0.1) };
    material: Unlit { color: #38bdf8 };
}

scene Demo {
    clear_color: #202020;

    state pips: array<entity_ref, 5> = [Nothing, Nothing, Nothing, Nothing, Nothing];
    state pip_count: i32 = 0;

    camera Main {
        position: vec3(0.0, 0.0, 10.0);
        target: vec3(0.0, 0.0, 0.0);
        projection: Orthographic { height: 12.8 };
    }

    entity Nothing {
        visible: false;
    }

    entity Rail {
        position: vec3(0.0, -1.5, 0.0);
        mesh: Box { size: vec3(12.0, 0.2, 0.2) };
        material: Unlit { color: #404040 };
    }

    on key_down(Key.Space) {
        if pip_count < 5 {
            let x = -6.0 + 2.0 * f32(pip_count);
            pips[pip_count] = spawn(Pip { x: x });
            pip_count = pip_count + 1;
        }
    }

    on key_down(Key.Backspace) {
        if pip_count > 0 {
            pip_count = pip_count - 1;
            destroy(pips[pip_count]);
        }
    }

    on key_down(Key.Enter) {
        for i in 0..pip_count {
            destroy(pips[i]);
        }
        pip_count = 0;
    }
}
