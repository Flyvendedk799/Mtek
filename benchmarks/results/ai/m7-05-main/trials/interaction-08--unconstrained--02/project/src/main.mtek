const RUNNER_SPEED = 4.0;
const WRAP_MAX = 6.0;
const WRAP_RANGE = 12.0;

material track_mat {
  fragment(input: SurfaceInput) -> color {
    return #404040;
  }
}

material runner_mat {
  fragment(input: SurfaceInput) -> color {
    return #f97316;
  }
}

scene Demo {
  state RunnerX: f32;
  state IsMoving: bool;

  entity Track {
    position: vec3(0.0, -1.0, 0.0);
    mesh: Box {
      size: vec3(12.0, 0.2, 0.2);
    };
    material: track_mat;
  }

  entity Runner {
    position: vec3(-5.0, 0.0, 0.0);
    mesh: Box {
      size: vec3(1.0, 1.0, 0.5);
    };
    material: runner_mat;
  }

  camera Main {
    position: vec3(0.0, 0.0, 10.0);
    projection: Orthographic {
      height: 12.8;
      near: 0.1;
      far: 1000.0;
    };
  }

  on key_down(Key.Space) {
    IsMoving = !IsMoving;
  }

  on pointer_move(event) {
    if (IsMoving) {
      RunnerX = RunnerX + (RUNNER_SPEED * frame.delta);
      
      if (RunnerX >= WRAP_MAX) {
        RunnerX = RunnerX - WRAP_RANGE;
      }
    }
    
    self.Runner.position = vec3(RunnerX, 0.0, 0.0);
  }
}
