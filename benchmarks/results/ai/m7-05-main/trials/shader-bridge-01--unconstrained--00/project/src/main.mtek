cpu fn parse_color(hex: string) -> color {
    return #808080;
}

material Flat {
    param tint: color = #808080;

    fragment(surface: SurfaceInput) -> color {
        return tint;
    }
}

scene Demo {
    state tint: string = "#808080";

    clear_color: #202020;

    camera Main {
        position: vec3(0.0, 0.0, 6.0);
        target: vec3(0.0, 0.0, 0.0);
    }

    entity Cube {
        mesh: Box { size: vec3(1.0, 1.0, 1.0) };
        material: Flat { tint: bind(parse_color(tint)); };
    }
}
