const A_sRGB = #1a237e;
const B_sRGB = #ffb300;

material Sweep {
  param time: f32 = 0.0;
  
  fragment(surface: SurfaceInput) -> color {
    let x = surface.local_position.x;
    let w = 0.5 + 0.5 * sin(0.8 * x + time);
    
    let A_linear = color.linear(vec3(0.1019607843, 0.1411764706, 0.4941176471), 1.0);
    let B_linear = color.linear(vec3(1.0, 0.7019607843, 0.0), 1.0);
    
    let result_rgb = (1.0 - w) * A_linear.rgb + w * B_linear.rgb;
    return color.linear(result_rgb, 1.0);
  }
};

scene Demo {
  clear_color: #202020;
  
  state current_time: f32 = 0.0;
  
  update(dt: f32) {
    current_time = current_time + dt;
  }
  
  camera Main {
    position: vec3(0.0, 0.0, 6.0);
    target: vec3(0.0, 0.0, 0.0);
    projection: Perspective {
      fov_y: 0.9;
      near: 0.1;
      far: 1000.0;
    };
  };
  
  entity Panel {
    position: vec3(0.4, 0.0, 0.0);
    mesh: Box {
      size: vec3(4.0, 2.0, 0.2);
    };
    material: Sweep {
      time: current_time;
    };
  };
};
