scene Demo {
    state lampA_on: bool = false;
    state lampB_on: bool = false;
    state colorA: color = #3a3a3a;
    state colorB: color = #3a3a3a;

    clear_color: #202020;

    camera Main {
        position: vec3(0.0, 0.0, 10.0);
        target: vec3(0.0, 0.0, 0.0);
        projection: Orthographic { height: 12.8 };
    }

    entity LampA {
        position: vec3(-3.0, 0.0, 0.0);
        mesh: Box { size: vec3(2.0, 2.0, 0.5) };
        material: Unlit { color: bind(colorA) };
    }

    entity LampB {
        position: vec3(3.0, 0.0, 0.0);
        mesh: Box { size: vec3(2.0, 2.0, 0.5) };
        material: Unlit { color: bind(colorB) };
    }

    on key_down(Key.A) {
        lampA_on = !lampA_on;
        if lampA_on {
            colorA = #ffd24a;
        } else {
            colorA = #3a3a3a;
        }
    }

    on key_down(Key.B) {
        lampB_on = !lampB_on;
        if lampB_on {
            colorB = #ffd24a;
        } else {
            colorB = #3a3a3a;
        }
    }

    on key_down(Key.Space) {
        lampA_on = !lampA_on;
        lampB_on = !lampB_on;
        if lampA_on {
            colorA = #ffd24a;
        } else {
            colorA = #3a3a3a;
        }
        if lampB_on {
            colorB = #ffd24a;
        } else {
            colorB = #3a3a3a;
        }
    }

    on key_down(Key.Enter) {
        lampA_on = false;
        lampB_on = false;
        colorA = #3a3a3a;
        colorB = #3a3a3a;
    }
}
