scene Demo {
    clear_color: #202020;

    state fixed_accumulator: f32 = 0.0;
    state ticks_this_frame: i32 = 0;

    camera Main {
        position: vec3(0.0, 0.0, 10.0);
        target: vec3(0.0, 0.0, 0.0);
        projection: Orthographic { height: 12.8 };
    }

    update(dt: f32) {
        let counted_dt: f32 = min(dt, 0.1);
        fixed_accumulator = fixed_accumulator + counted_dt;
        ticks_this_frame = 0;
        
        let fixed_step: f32 = 1.0 / 60.0;
        
        if fixed_accumulator >= fixed_step {
            fixed_accumulator = fixed_accumulator - fixed_step;
            ticks_this_frame = ticks_this_frame + 1;
        }
        if fixed_accumulator >= fixed_step {
            fixed_accumulator = fixed_accumulator - fixed_step;
            ticks_this_frame = ticks_this_frame + 1;
        }
        if fixed_accumulator >= fixed_step {
            fixed_accumulator = fixed_accumulator - fixed_step;
            ticks_this_frame = ticks_this_frame + 1;
        }
        if fixed_accumulator >= fixed_step {
            fixed_accumulator = fixed_accumulator - fixed_step;
            ticks_this_frame = ticks_this_frame + 1;
        }
        
        if fixed_accumulator >= fixed_step {
            fixed_accumulator = fixed_accumulator - (fixed_step * 4.0);
        }
    }

    entity Ticker {
        position: vec3(-5.5, 3.0, 0.0);
        mesh: Box { size: vec3(1.0, 1.0, 0.5) };
        material: Unlit { color: #ef4444 };

        update(dt: f32) {
            if ticks_this_frame >= 1 {
                self.position = vec3(self.position.x + 0.1, self.position.y, self.position.z);
            }
            if ticks_this_frame >= 2 {
                self.position = vec3(self.position.x + 0.1, self.position.y, self.position.z);
            }
            if ticks_this_frame >= 3 {
                self.position = vec3(self.position.x + 0.1, self.position.y, self.position.z);
            }
            if ticks_this_frame >= 4 {
                self.position = vec3(self.position.x + 0.1, self.position.y, self.position.z);
            }
        }
    }

    entity Glider {
        position: vec3(-5.5, -3.0, 0.0);
        mesh: Box { size: vec3(1.0, 1.0, 0.5) };
        material: Unlit { color: #38bdf8 };

        update(dt: f32) {
            let counted_dt: f32 = min(dt, 0.1);
            let movement: f32 = 6.0 * counted_dt;
            self.position = vec3(self.position.x + movement, self.position.y, self.position.z);
        }
    }
}
