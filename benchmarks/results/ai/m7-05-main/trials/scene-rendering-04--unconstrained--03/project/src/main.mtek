// Entry module: declare the scene Demo here.

scene Demo {
  clear_color: #9db4cc;

  camera Main {
    position: vec3(5.0, 4.0, 9.0);
    target: vec3(0.0, 1.0, 0.0);
    projection: Perspective {
      fov_y: 0.7;
      near: 0.1;
      far: 1000.0;
    };
  }

  entity Floor {
    position: vec3(0.0, 0.0, 0.0);
    scale: vec3(6.0, 1.0, 6.0);
    mesh: Plane {};
    material: Unlit {
      color: #4b5563;
    };
  }

  entity Tower {
    position: vec3(0.0, 1.5, 0.0);
    scale: vec3(1.5, 3.0, 1.5);
    mesh: Box {};
    material: Unlit {
      color: #2563eb;
    };
  }

  entity Block {
    position: vec3(1.5, 0.5, 1.8);
    scale: vec3(2.0, 1.0, 2.0);
    mesh: Box {};
    material: Unlit {
      color: #dc2626;
    };
  }

  entity Ball {
    position: vec3(-1.6, 0.8, 1.2);
    scale: vec3(0.8, 0.8, 0.8);
    mesh: Sphere {};
    material: Unlit {
      color: #eab308;
    };
  }
}
