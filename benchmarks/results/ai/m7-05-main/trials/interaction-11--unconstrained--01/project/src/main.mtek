scene Demo {
    clear_color: #202020;
    state accumulated_time: f32 = 0.0;
    const TICK_DURATION: f32 = 0.016666666666;
    const MAX_FRAME_DURATION: f32 = 0.1;
    const TICKS_PER_FRAME: i32 = 4;

    camera Main {
        position: vec3(0.0, 0.0, 10.0);
        target: vec3(0.0, 0.0, 0.0);
        projection: Orthographic { height: 12.8 };
    }

    entity Ticker {
        position: vec3(-5.5, 3.0, 0.0);
        mesh: Box { size: vec3(1.0, 1.0, 0.5) };
        material: Unlit { color: #ef4444 };

        update(dt: f32) {
            let clamped_dt = min(dt, MAX_FRAME_DURATION);
            let new_accumulated = accumulated_time + clamped_dt;
            let total_ticks_available = i32(new_accumulated / TICK_DURATION);
            let ticks_to_run = min(total_ticks_available, TICKS_PER_FRAME);
            accumulated_time = new_accumulated - f32(total_ticks_available) * TICK_DURATION;
            let move_amount = f32(ticks_to_run) * 0.1;
            self.position = self.position + vec3(move_amount, 0.0, 0.0);
        }
    }

    entity Glider {
        position: vec3(-5.5, -3.0, 0.0);
        mesh: Box { size: vec3(1.0, 1.0, 0.5) };
        material: Unlit { color: #38bdf8 };

        update(dt: f32) {
            let clamped_dt = min(dt, MAX_FRAME_DURATION);
            let move_amount = clamped_dt * 6.0;
            self.position = self.position + vec3(move_amount, 0.0, 0.0);
        }
    }
}
