// Entry module: declare the scene Demo here.

material AmberMaterial {
  fragment(input: SurfaceInput) -> color {
    return #f59e0b;
  }
}

material RedMaterial {
  fragment(input: SurfaceInput) -> color {
    return #ef4444;
  }
}

scene Demo {
  camera Main {
    position: vec3(0.0, 0.0, 8.0);
    projection: Perspective {
      fov_y: 0.8;
      near: 0.1;
      far: 100.0;
    };
  }

  entity Bar {
    position: vec3(0.0, 0.0, 0.0);
    rotation: quat.axis_angle(vec3(0.0, 0.0, 1.0), 0.9272952);
    mesh: Box {
      size: vec3(4.0, 1.0, 0.5);
    };
    material: (
      fragment(input: SurfaceInput) -> color {
        return #f59e0b;
      }
    );
  }

  entity Tip {
    position: vec3(1.2, 1.6, 0.0);
    mesh: Sphere {
      radius: 0.6;
    };
    material: (
      fragment(input: SurfaceInput) -> color {
        return #ef4444;
      }
    );
  }

  clear_color: #101820;
}
