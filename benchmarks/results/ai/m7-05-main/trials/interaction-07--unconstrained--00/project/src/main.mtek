prefab Pip {
    param x: f32;
    position: vec3(x, 0.0, 0.0);
    mesh: Box { size: vec3(0.8, 0.8, 0.5) };
    material: Unlit { color: #38bdf8 };
}

scene Demo {
    state pip_count: i32 = 0;
    state pips: array<entity_ref, 5>;
    state space_pressed: bool = false;
    state backspace_pressed: bool = false;
    state enter_pressed: bool = false;

    clear_color: #202020;

    camera Main {
        position: vec3(0.0, 0.0, 10.0);
        target: vec3(0.0, 0.0, 0.0);
        projection: Orthographic { height: 12.8 };
    }

    entity Rail {
        position: vec3(0.0, -1.5, 0.0);
        mesh: Box { size: vec3(12.0, 0.2, 0.2) };
        material: Unlit { color: #404040 };
    }

    update(dt: f32) {
        if (is_key_down(Key.Space)) {
            if (!space_pressed) {
                space_pressed = true;
                if (pip_count < 5) {
                    let x: f32 = -6.0 + 2.0 * (0.0 + pip_count);
                    pips[pip_count] = spawn(Pip { x: x });
                    pip_count = pip_count + 1;
                }
            }
        } else {
            space_pressed = false;
        }

        if (is_key_down(Key.Backspace)) {
            if (!backspace_pressed) {
                backspace_pressed = true;
                if (pip_count > 0) {
                    pip_count = pip_count - 1;
                    destroy(pips[pip_count]);
                }
            }
        } else {
            backspace_pressed = false;
        }

        if (is_key_down(Key.Enter)) {
            if (!enter_pressed) {
                enter_pressed = true;
                if (pip_count > 0) {
                    destroy(pips[0]);
                }
                if (pip_count > 1) {
                    destroy(pips[1]);
                }
                if (pip_count > 2) {
                    destroy(pips[2]);
                }
                if (pip_count > 3) {
                    destroy(pips[3]);
                }
                if (pip_count > 4) {
                    destroy(pips[4]);
                }
                pip_count = 0;
            }
        } else {
            enter_pressed = false;
        }
    }
}
