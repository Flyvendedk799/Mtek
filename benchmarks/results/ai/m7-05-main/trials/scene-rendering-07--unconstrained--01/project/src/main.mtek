// Entry module: declare the scene Demo here.

// Material for the ball
material BallMaterial {
  fragment(input: SurfaceInput) -> color {
    let base = color.srgb(vec3(0.88, 0.11, 0.28), 1.0);
    let result = lighting.pbr(
      input,
      base,
      0.0,
      0.7
    );
    return result;
  }
}

// Material for the floor
material FloorMaterial {
  fragment(input: SurfaceInput) -> color {
    let base = color.srgb(vec3(0.6, 0.65, 0.69), 1.0);
    let result = lighting.pbr(
      input,
      base,
      0.0,
      0.9
    );
    return result;
  }
}

// Scene definition
scene Demo {
  // Camera
  camera Main {
    position: vec3(0.0, 3.0, 8.0);
    target: vec3(0.0, 0.5, 0.0);
    projection: Perspective {
      fov_y: 0.8;
      near: 0.1;
      far: 1000.0;
    };
  }

  // Ball (sphere)
  entity Ball {
    position: vec3(0.0, 1.0, 0.0);
    mesh: Sphere {
      radius: 1.0;
    };
    render: Pbr {
      base_color: #e11d48;
      metalness: 0.0;
      roughness: 0.7;
    };
  }

  // Floor (plane)
  entity Floor {
    position: vec3(0.0, 0.0, 0.0);
    mesh: Plane {
      size: vec2(14.0, 14.0);
    };
    render: Pbr {
      base_color: #9aa5b1;
      metalness: 0.0;
      roughness: 0.9;
    };
  }

  // Point light
  entity Lamp {
    position: vec3(1.5, 3.0, 2.5);
    light: PointLight {
      color: color.srgb(vec3(1.0, 1.0, 1.0), 1.0);
      intensity: 9.0;
    };
  }
}
