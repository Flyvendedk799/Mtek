prefab Pip {
    param x: f32;
    position: vec3(x, 0.0, 0.0);
    mesh: Box { size: vec3(0.8, 0.8, 0.5) };
    material: Unlit { color: #38bdf8 };
}

scene Demo {
    clear_color: #202020;

    state pip_count: i32 = 0;
    state pips: array<entity_ref, 5> = [Rail, Rail, Rail, Rail, Rail];
    state space_pressed: bool = false;
    state backspace_pressed: bool = false;
    state return_pressed: bool = false;

    camera Main {
        position: vec3(0.0, 0.0, 10.0);
        target: vec3(0.0, 0.0, 0.0);
        projection: Orthographic { height: 12.8 };
    }

    entity Rail {
        position: vec3(0.0, -1.5, 0.0);
        mesh: Box { size: vec3(12.0, 0.2, 0.2) };
        material: Unlit { color: #404040 };
    }

    update(dt: f32) {
        let space_down: bool = is_key_down(Key.Space);
        let backspace_down: bool = is_key_down(Key.Backspace);
        let enter_down: bool = is_key_down(Key.Enter);

        if space_down && !space_pressed {
            if pip_count < 5 {
                let x_pos: f32 = -6.0 + 2.0 * f32(pip_count + 1);
                pips[pip_count] = spawn(Pip { x: x_pos; });
                pip_count = pip_count + 1;
            }
        }
        space_pressed = space_down;

        if backspace_down && !backspace_pressed {
            if pip_count > 0 {
                pip_count = pip_count - 1;
                destroy(pips[pip_count]);
            }
        }
        backspace_pressed = backspace_down;

        if enter_down && !return_pressed {
            let j: i32 = 0;
            for j in 0 .. pip_count {
                destroy(pips[j]);
            }
            pip_count = 0;
        }
        return_pressed = enter_down;
    }
}
