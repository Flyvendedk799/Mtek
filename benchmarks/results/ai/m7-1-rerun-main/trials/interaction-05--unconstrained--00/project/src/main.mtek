fn clamp_coordinate(value: f32) -> f32 {
    if (value < -4.5) {
        return -4.5;
    }
    if (value > 4.5) {
        return 4.5;
    }
    return value;
}

scene Demo {
    clear_color: #202020;

    cursor: vec2 = vec2(0.0, 0.0);
    state marker_pos: vec2 = vec2(0.0, 0.0);

    camera Main {
        position: vec3(0.0, 0.0, 10.0);
        target: vec3(0.0, 0.0, 0.0);
        projection: Orthographic { height: 12.8 };
    }

    entity Panel {
        position: vec3(0.0, 0.0, -1.0);
        mesh: Box { size: vec3(10.0, 10.0, 0.1) };
        material: Unlit { color: #2a2a2a };
    }

    entity Marker {
        mesh: Box { size: vec3(1.0, 1.0, 0.5) };
        material: Unlit { color: #38bdf8 };

        update(dt: f32) {
            marker_pos = vec2(clamp_coordinate(cursor.x), clamp_coordinate(cursor.y));
            if (is_key_down(Key.Space)) {
                marker_pos = vec2(0.0, 0.0);
            }
            self.position = vec3(marker_pos.x, marker_pos.y, 0.0);
        }
    }
}
