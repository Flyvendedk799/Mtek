material PlainMaterial {
  param tex: texture = asset.texture("assets/swatch.png");
  param smp: sampler = sampler.nearest_clamp();
  param uv: vec2;
  
  fragment(input: SurfaceInput) -> color {
    let sampled = sample(tex, smp, uv);
    return color.linear(vec3(sampled.x, sampled.y, sampled.z), sampled.w);
  }
}

material TiledMaterial {
  param tex: texture = asset.texture("assets/swatch.png");
  param smp: sampler = sampler.nearest_clamp();
  param uv: vec2;
  
  fragment(input: SurfaceInput) -> color {
    let sampled = sample(tex, smp, uv);
    return color.linear(vec3(sampled.x, sampled.y, sampled.z), sampled.w);
  }
}

material SmoothMaterial {
  param tex: texture = asset.texture("assets/swatch.png");
  param smp: sampler = sampler.linear_clamp();
  param uv: vec2;
  
  fragment(input: SurfaceInput) -> color {
    let sampled = sample(tex, smp, uv);
    return color.linear(vec3(sampled.x, sampled.y, sampled.z), sampled.w);
  }
}

scene Demo {
  clear_color: #1b2430;
  
  camera Main {
    position: vec3(0.0, 11.0, 3.0);
    target: vec3(0.0, 0.0, 0.0);
    projection: Perspective {
      fov_y: 0.72;
      near: 0.1;
      far: 1000.0;
    };
  }
  
  entity Plain {
    position: vec3(-2.0, 0.0, -2.0);
    mesh: Plane { size: vec2(3.6, 3.6); };
    material: PlainMaterial {
      uv: bind(input.uv);
    };
  }
  
  entity Tiled {
    position: vec3(0.0, 0.0, 2.0);
    mesh: Plane { size: vec2(3.6, 3.6); };
    material: TiledMaterial {
      uv: bind(input.uv * 2.0);
    };
  }
  
  entity Smooth {
    position: vec3(2.0, 0.0, -2.0);
    mesh: Plane { size: vec2(3.6, 3.6); };
    material: SmoothMaterial {
      uv: bind(input.uv);
    };
  }
}
