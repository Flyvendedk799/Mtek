const COLUMNS: i32 = 5;

const SPACING: f32 = 1.5;

const FIRST_ROW_Y: f32 = 2.0;

const ROW_DROP: f32 = 2.5;

prefab Marker {
    param origin: vec3 = vec3(0.0, 0.0, 0.0);

    position: origin;
    mesh: Box { size: vec3(0.8, 0.8, 0.8) };
    material: Unlit { color: #facc15 };
}

scene Demo {
    clear_color: #202020;
    // How many rows Space has placed so far.
    state rows: i32 = 0;

    camera Main {
        position: vec3(0.0, 0.0, 8.0);
        target: vec3(0.0, 0.0, 0.0);
    }

    // The shelf below the rows; it never changes.
    entity Rail {
        position: vec3(0.0, -3.0, 0.0);
        mesh: Box { size: vec3(8.0, 0.4, 1.0) };
        material: Unlit { color: #475569 };
    }

    on key_down(Key.Space) {
        let y = FIRST_ROW_Y - ROW_DROP * f32(rows);
        for i in 0..COLUMNS {
            let x = SPACING * (f32(i) - 2.0);
            spawn(Marker { origin: vec3(x, y, 0.0) });
        }
        rows += 1;
    }
}
