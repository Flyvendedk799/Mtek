material Sweep {
    param time: f32 = 0.0;

    fragment(input: SurfaceInput) -> color {
        let x = input.local_position.x;
        let t = time;
        let w = 0.5 + 0.5 * sin(0.8 * x + t);
        
        // Use color.srgb to convert sRGB to linear properly
        let A_linear = color.srgb(vec3(0.10196078, 0.13725490, 0.49411764), 1.0).rgb;  // #1a237e
        let B_linear = color.srgb(vec3(1.0, 0.7019608, 0.0), 1.0).rgb;                  // #ffb300
        
        // Blend in linear light
        let blended = (1.0 - w) * A_linear + w * B_linear;
        
        return color.linear(blended, 1.0);
    }
}

scene Demo {
    clear_color: #202020;

    camera Main {
        position: vec3(0.0, 0.0, 6.0);
        target: vec3(0.0, 0.0, 0.0);
        projection: Perspective { fov_y: 0.9; near: 0.1; far: 1000.0 };
    }

    entity Panel {
        position: vec3(0.4, 0.0, 0.0);
        mesh: Box { size: vec3(4.0, 2.0, 0.2) };
        material: Sweep { time: bind(frame.time) };
    }

    update(dt: f32) {
    }
}
