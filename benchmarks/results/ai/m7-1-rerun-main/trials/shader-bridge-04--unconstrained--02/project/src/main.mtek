material Gauge {
    param level: f32 = 0.0;

    fragment(surface: SurfaceInput) -> color {
        return color.linear(vec3(level), 1.0);
    }
}

fn charge_to_level(charge: i32) -> f32 {
    if charge == 0 {
        return 0.0;
    } else if charge == 1 {
        return 0.25;
    } else if charge == 2 {
        return 0.5;
    } else if charge == 3 {
        return 0.75;
    } else {
        return 1.0;
    }
}

scene Demo {
    state charge: i32 = 0;
    state space_down: bool = false;
    state backspace_down: bool = false;

    clear_color: #202020;

    camera Main {
        position: vec3(0.0, 0.0, 6.0);
        target: vec3(0.0, 0.0, 0.0);
    }

    entity Meter {
        mesh: Box { size: vec3(1.0, 1.0, 1.0) };
        material: Gauge { level: bind(charge_to_level(charge)); };
    }

    on key_down(Key.Space) {
        if !space_down {
            if charge < 4 {
                charge = charge + 1;
            }
            space_down = true;
        }
    }

    on key_down(Key.Backspace) {
        if !backspace_down {
            if charge > 0 {
                charge = charge - 1;
            }
            backspace_down = true;
        }
    }

    on key_up(Key.Space) {
        space_down = false;
    }

    on key_up(Key.Backspace) {
        backspace_down = false;
    }
}
