material Sweep {
  param elapsed_time: f32 = 0.0;
  
  fragment(surface: SurfaceInput) -> color {
    let x = surface.local_position.x;
    let t = elapsed_time;
    let w = 0.5 + 0.5 * sin(0.8 * x + t);
    
    // Convert sRGB colors to linear
    let A_srgb = vec3(0.1019607843, 0.1372549020, 0.4941176471);  // #1a237e
    let B_srgb = vec3(1.0, 0.7019607843, 0.0);                     // #ffb300
    
    // sRGB to linear conversion using pow
    let A_linear = pow(A_srgb, vec3(2.2, 2.2, 2.2));
    let B_linear = pow(B_srgb, vec3(2.2, 2.2, 2.2));
    
    // Blend in linear light
    let blended = (1.0 - w) * A_linear + w * B_linear;
    
    // Return as linear color
    return color.linear(blended, 1.0);
  }
}

scene Demo {
  clear_color: #202020;
  
  camera Main {
    position: vec3(0.0, 0.0, 6.0);
    projection: Perspective {
      fov_y: 0.9;
      near: 0.1;
      far: 1000.0;
    };
  }
  
  entity Panel {
    position: vec3(0.4, 0.0, 0.0);
    mesh: Box {
      size: vec3(4.0, 2.0, 0.2);
    };
    material: Sweep {
      elapsed_time: bind(frame.time);
    };
  }
}
