const CUBE_COLOR = color.linear(vec3(0.784, 0.635, 0.478), 1.0);
const FLOOR_COLOR = color.linear(vec3(0.541, 0.576, 0.612), 1.0);
const SUN_DIR = vec3(0.0, -0.6, -0.8);

scene Demo {
  clear_color: #0b0d12;
  ambient_color: #ffffff;
  ambient_intensity: 0.015;
  gravity: vec3(0.0, -9.81, 0.0);

  camera Main {
    position: vec3(2.5, 2.5, 5.0);
    target: vec3(0.0, 0.0, 0.0);
    projection: Perspective {
      fov_y: 0.9;
      near: 0.1;
      far: 1000.0;
    };
  }

  entity Cube {
    position: vec3(0.0, 0.0, 0.0);
    mesh: Box {
      size: vec3(2.0, 2.0, 2.0);
    };
    material: Pbr {
      base_color: CUBE_COLOR;
      metallic: 0.0;
      roughness: 0.8;
    };
  }

  entity Floor {
    position: vec3(0.0, -1.0, 0.0);
    mesh: Plane {
      size: vec2(10.0, 10.0);
    };
    material: Pbr {
      base_color: FLOOR_COLOR;
      metallic: 0.0;
      roughness: 0.9;
    };
  }

  entity Sun {
    rotation: quat.axis_angle(vec3(1.0, 0.0, 0.0), acos(0.8));
    light: DirectionalLight {
      color: #ffffff;
      intensity: 0.5;
    };
  }
}
