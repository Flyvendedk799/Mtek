scene Demo {
    clear_color: #202020;

    state fixed_accumulator: f32 = 0.0;

    camera Main {
        position: vec3(0.0, 0.0, 10.0);
        target: vec3(0.0, 0.0, 0.0);
        projection: Orthographic { height: 12.8 };
    }

    entity Ticker {
        position: vec3(-5.5, 3.0, 0.0);
        mesh: Box { size: vec3(1.0, 1.0, 0.5) };
        material: Unlit { color: #ef4444 };
    }

    entity Glider {
        position: vec3(-5.5, -3.0, 0.0);
        mesh: Box { size: vec3(1.0, 1.0, 0.5) };
        material: Unlit { color: #38bdf8 };
    }

    update(dt: f32) {
        let counted_dt = min(dt, 0.1);
        let new_accumulator = fixed_accumulator + counted_dt;
        var remaining = new_accumulator;
        var ticks_run = 0;

        for i in 0..4 {
            if remaining >= 0.016666668 {
                Ticker.position.x += 0.1;
                remaining -= 0.016666668;
                ticks_run = i + 1;
            }
        }

        if ticks_run == 4 {
            fixed_accumulator = remaining - floor(remaining / 0.016666668) * 0.016666668;
        } else {
            fixed_accumulator = remaining;
        }

        Glider.position.x += 6.0 * counted_dt;
    }
}
