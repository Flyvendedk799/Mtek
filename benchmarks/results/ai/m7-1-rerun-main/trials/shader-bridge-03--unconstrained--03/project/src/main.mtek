// Custom material that sweeps color with time based on object space x coordinate
material Sweep {
  param time: f32 = 0.0;
  
  fragment(surface: SurfaceInput) -> color {
    let x = surface.local_position.x;
    let w = 0.5 + 0.5 * sin(0.8 * x + time);
    
    // Define colors in sRGB and convert to linear
    // A = #1a237e, B = #ffb300
    let colorA_srgb = color.srgb(vec3(26.0 / 255.0, 35.0 / 255.0, 126.0 / 255.0), 1.0);
    let colorB_srgb = color.srgb(vec3(255.0 / 255.0, 179.0 / 255.0, 0.0 / 255.0), 1.0);
    
    // Extract linear RGB components
    let a_linear = colorA_srgb.rgb;
    let b_linear = colorB_srgb.rgb;
    
    // Blend in linear space
    let blended = (1.0 - w) * a_linear + w * b_linear;
    
    // Return as linear color
    return color.linear(blended, 1.0);
  }
}

// Scene with the panel that uses the Sweep material
scene Demo {
  clear_color: #202020;
  
  camera Main {
    position: vec3(0.0, 0.0, 6.0);
    projection: Perspective { fov_y: 0.9; near: 0.1; far: 1000.0; };
  }
  
  entity Panel {
    position: vec3(0.4, 0.0, 0.0);
    mesh: Box { size: vec3(4.0, 2.0, 0.2); };
    material: Sweep { time: bind(frame.time); };
  }
}
