material Shade {
    fragment(surface: SurfaceInput) -> color {
        return color.linear(vec3(0.25), 1.0);
    }
}

scene Demo {
    clear_color: #202020;

    camera Main {
        position: vec3(0.0, 0.0, 6.0);
        target: vec3(0.0, 0.0, 0.0);
    }

    entity Left {
        position: vec3(-1.2, 0.0, 0.0);
        mesh: Box { size: vec3(1.0, 1.0, 1.0) };
        material: Shade {};
    }

    entity Right {
        position: vec3(1.2, 0.0, 0.0);
        mesh: Box { size: vec3(1.0, 1.0, 1.0) };
        material: Shade {};
    }
}
