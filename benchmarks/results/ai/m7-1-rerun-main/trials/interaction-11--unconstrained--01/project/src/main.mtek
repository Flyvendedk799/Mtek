scene Demo {
    clear_color: #202020;

    state accumulated_time: f32 = 0.0;
    state ticks_available: i32 = 0;

    camera Main {
        position: vec3(0.0, 0.0, 10.0);
        target: vec3(0.0, 0.0, 0.0);
        projection: Orthographic { height: 12.8 };
    }

    entity Ticker {
        position: vec3(-5.5, 3.0, 0.0);
        mesh: Box { size: vec3(1.0, 1.0, 0.5) };
        material: Unlit { color: #ef4444 };

        update(dt: f32) {
            let clamped_dt = min(dt, 0.1);
            accumulated_time = accumulated_time + clamped_dt;
            
            let fixed_step = 1.0 / 60.0;
            let total_ticks = i32(accumulated_time / fixed_step);
            ticks_available = min(total_ticks, 4);
            
            self.position = self.position + vec3(0.1 * f32(ticks_available), 0.0, 0.0);
            
            accumulated_time = accumulated_time - f32(total_ticks) * fixed_step;
        }
    }

    entity Glider {
        position: vec3(-5.5, -3.0, 0.0);
        mesh: Box { size: vec3(1.0, 1.0, 0.5) };
        material: Unlit { color: #38bdf8 };

        update(dt: f32) {
            let clamped_dt = min(dt, 0.1);
            self.position = self.position + vec3(6.0 * clamped_dt, 0.0, 0.0);
        }
    }
}
