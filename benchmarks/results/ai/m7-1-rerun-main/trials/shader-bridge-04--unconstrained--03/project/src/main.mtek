cpu fn charge_to_level(charge: i32) -> f32 {
    let level: f32 = charge;
    return level / 4.0;
}

material Gauge {
    param level: f32 = 0.0;

    fragment(surface: SurfaceInput) -> color {
        return color.linear(vec3(level), 1.0);
    }
}

scene Demo {
    clear_color: #202020;
    state charge: i32 = 0;
    state space_was_down: bool = false;
    state backspace_was_down: bool = false;

    camera Main {
        position: vec3(0.0, 0.0, 6.0);
        target: vec3(0.0, 0.0, 0.0);
    }

    entity Meter {
        mesh: Box { size: vec3(1.0, 1.0, 1.0) };
        material: Gauge { level: bind(charge_to_level(charge)); };

        update(dt: f32) {
            let space_is_down = is_key_down(Key.Space);
            let backspace_is_down = is_key_down(Key.Backspace);

            if space_is_down && !space_was_down {
                if charge < 4 {
                    charge = charge + 1;
                }
            }

            if backspace_is_down && !backspace_was_down {
                if charge > 0 {
                    charge = charge - 1;
                }
            }

            space_was_down = space_is_down;
            backspace_was_down = backspace_is_down;
        }
    }
}
