material Gauge {
    param level: f32 = 0.0;

    fragment(surface: SurfaceInput) -> color {
        return color.linear(vec3(level), 1.0);
    }
}

scene Demo {
    state charge: i32 = 0;
    state space_was_down: bool = false;
    state backspace_was_down: bool = false;

    clear_color: #202020;

    camera Main {
        position: vec3(0.0, 0.0, 6.0);
        target: vec3(0.0, 0.0, 0.0);
    }

    entity Meter {
        mesh: Box { size: vec3(1.0, 1.0, 1.0) };
        material: Gauge { level: bind(charge_level(charge)); };
    }

    on key_down(k: Key) {
        if k == Key.Space {
            if !space_was_down {
                charge = min(charge + 1, 4);
                space_was_down = true;
            }
        }
        if k == Key.Backspace {
            if !backspace_was_down {
                charge = max(charge - 1, 0);
                backspace_was_down = true;
            }
        }
    }

    on key_up(k: Key) {
        if k == Key.Space {
            space_was_down = false;
        }
        if k == Key.Backspace {
            backspace_was_down = false;
        }
    }
}

fn charge_level(c: i32) -> f32 {
    return mix(0.0, 1.0, 1.0 * c) * 0.25;
}
