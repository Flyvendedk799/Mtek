material Sweep {
    param time: f32 = 0.0;

    fragment(input: SurfaceInput) -> color {
        // Get x coordinate in object space (-2 to 2 across the panel)
        let x = input.local_position.x;
        
        // Compute the wave: w = 0.5 + 0.5 * sin(0.8 * x + t)
        let w = 0.5 + 0.5 * sin(0.8 * x + time);
        
        // A = #1a237e: sRGB(0.102, 0.137, 0.494) converted to linear
        let a_linear = vec3(0.0080, 0.0155, 0.2169);
        
        // B = #ffb300: sRGB(1.0, 0.702, 0.0) converted to linear
        let b_linear = vec3(1.0, 0.4532, 0.0);
        
        // Blend in linear light: (1 - w) * A + w * B
        let blended = (1.0 - w) * a_linear + w * b_linear;
        
        // Return as linear (output directly without sRGB conversion)
        return color.linear(blended, 1.0);
    }
}

scene Demo {
    clear_color: #202020;

    camera Main {
        position: vec3(0.0, 0.0, 6.0);
        target: vec3(0.0, 0.0, 0.0);
        projection: Perspective {
            fov_y: 0.9;
            near: 0.1;
            far: 1000.0;
        };
    }

    entity Panel {
        mesh: Box { size: vec3(4.0, 2.0, 0.2) };
        material: Sweep { time: bind(frame.time) };
        position: vec3(0.4, 0.0, 0.0);
    }
}
