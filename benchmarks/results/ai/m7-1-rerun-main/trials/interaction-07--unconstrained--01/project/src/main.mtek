prefab Pip {
    param x: f32;
    position: vec3(x, 0.0, 0.0);
    mesh: Box { size: vec3(0.8, 0.8, 0.5) };
    material: Unlit { color: #38bdf8 };
}

scene Demo {
    state pip_count: i32 = 0;
    state pip0: entity_ref = Rail;
    state pip1: entity_ref = Rail;
    state pip2: entity_ref = Rail;
    state pip3: entity_ref = Rail;
    state pip4: entity_ref = Rail;

    clear_color: #202020;

    camera Main {
        position: vec3(0.0, 0.0, 10.0);
        target: vec3(0.0, 0.0, 0.0);
        projection: Orthographic { height: 12.8 };
    }

    entity Rail {
        position: vec3(0.0, -1.5, 0.0);
        mesh: Box { size: vec3(12.0, 0.2, 0.2) };
        material: Unlit { color: #404040 };
    }

    on key_down(Key.Space) {
        if pip_count < 5 {
            let x: f32 = -4.0 + 2.0 * f32(pip_count);
            if pip_count == 0 {
                pip0 = spawn(Pip { x: x; });
            } else if pip_count == 1 {
                pip1 = spawn(Pip { x: x; });
            } else if pip_count == 2 {
                pip2 = spawn(Pip { x: x; });
            } else if pip_count == 3 {
                pip3 = spawn(Pip { x: x; });
            } else if pip_count == 4 {
                pip4 = spawn(Pip { x: x; });
            }
            pip_count = pip_count + 1;
        }
    }

    on key_down(Key.Backspace) {
        if pip_count > 0 {
            pip_count = pip_count - 1;
            if pip_count == 0 {
                destroy(pip0);
            } else if pip_count == 1 {
                destroy(pip1);
            } else if pip_count == 2 {
                destroy(pip2);
            } else if pip_count == 3 {
                destroy(pip3);
            } else if pip_count == 4 {
                destroy(pip4);
            }
        }
    }

    on key_down(Key.Enter) {
        if pip_count > 0 {
            destroy(pip0);
        }
        if pip_count > 1 {
            destroy(pip1);
        }
        if pip_count > 2 {
            destroy(pip2);
        }
        if pip_count > 3 {
            destroy(pip3);
        }
        if pip_count > 4 {
            destroy(pip4);
        }
        pip_count = 0;
    }
}
