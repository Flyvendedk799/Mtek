scene Demo {
    state lamp_a_on: bool = false;
    state lamp_b_on: bool = false;
    state lamp_a_color: color = #3a3a3a;
    state lamp_b_color: color = #3a3a3a;

    clear_color: #202020;

    camera Main {
        position: vec3(0.0, 0.0, 10.0);
        target: vec3(0.0, 0.0, 0.0);
        projection: Orthographic { height: 12.8 };
    }

    entity LampA {
        position: vec3(-3.0, 0.0, 0.0);
        mesh: Box { size: vec3(2.0, 2.0, 0.5) };
        material: Unlit { color: bind(lamp_a_color) };
    }

    entity LampB {
        position: vec3(3.0, 0.0, 0.0);
        mesh: Box { size: vec3(2.0, 2.0, 0.5) };
        material: Unlit { color: bind(lamp_b_color) };
    }

    on key_down(Key.A) {
        lamp_a_on = !lamp_a_on;
        if lamp_a_on {
            lamp_a_color = #ffd24a;
        } else {
            lamp_a_color = #3a3a3a;
        }
    }

    on key_down(Key.B) {
        lamp_b_on = !lamp_b_on;
        if lamp_b_on {
            lamp_b_color = #ffd24a;
        } else {
            lamp_b_color = #3a3a3a;
        }
    }

    on key_down(Key.Space) {
        lamp_a_on = !lamp_a_on;
        lamp_b_on = !lamp_b_on;
        if lamp_a_on {
            lamp_a_color = #ffd24a;
        } else {
            lamp_a_color = #3a3a3a;
        }
        if lamp_b_on {
            lamp_b_color = #ffd24a;
        } else {
            lamp_b_color = #3a3a3a;
        }
    }

    on key_down(Key.Enter) {
        lamp_a_on = false;
        lamp_b_on = false;
        lamp_a_color = #3a3a3a;
        lamp_b_color = #3a3a3a;
    }
}
