material Sweep {
    param t: f32 = 0.0;

    fragment(input: SurfaceInput) -> color {
        let x = input.local_position.x;
        let w = 0.5 + 0.5 * sin(0.8 * x + t);
        
        // A = #1a237e, B = #ffb300 - convert from sRGB to linear
        let a_srgb = color.srgb(vec3(0.1019608, 0.1372549, 0.4941176), 1.0);
        let b_srgb = color.srgb(vec3(1.0, 0.7019608, 0.0), 1.0);
        
        // Blend in linear light
        let blended_rgb = mix(a_srgb.rgb, b_srgb.rgb, w);
        
        // Return as linear color (already converted)
        return color.linear(blended_rgb, 1.0);
    }
}

scene Demo {
    clear_color: #202020;

    camera Main {
        position: vec3(0.0, 0.0, 6.0);
        target: vec3(0.0, 0.0, 0.0);
        projection: Perspective { fov_y: 0.9; near: 0.1; far: 1000.0 };
    }

    entity Panel {
        position: vec3(0.4, 0.0, 0.0);
        mesh: Box { size: vec3(4.0, 2.0, 0.2) };
        material: Sweep { t: bind(frame.time) };
    }
}
