scene Demo {
    clear_color: #202020;
    state accumulator: f32 = 0.0;
    state clamped_frame_delta: f32 = 0.0;

    camera Main {
        position: vec3(0.0, 0.0, 10.0);
        target: vec3(0.0, 0.0, 0.0);
        projection: Orthographic { height: 12.8 };
    }

    entity Ticker {
        position: vec3(-5.5, 3.0, 0.0);
        mesh: Box { size: vec3(1.0, 1.0, 0.5) };
        material: Unlit { color: #ef4444 };

        update(dt: f32) {
            let step_size = 1.0 / 60.0;
            let ticks_to_run = min(floor((accumulator + clamped_frame_delta) / step_size), 4.0);
            
            if ticks_to_run >= 1.0 {
                self.position = self.position + vec3(0.1 * ticks_to_run, 0.0, 0.0);
            }
        }
    }

    entity Glider {
        position: vec3(-5.5, -3.0, 0.0);
        mesh: Box { size: vec3(1.0, 1.0, 0.5) };
        material: Unlit { color: #38bdf8 };

        update(dt: f32) {
            self.position = self.position + vec3(6.0 * clamped_frame_delta, 0.0, 0.0);
        }
    }

    on pointer_down(event: PointerEvent) {
        let clamped_dt = min(frame.delta, 0.1);
        clamped_frame_delta = clamped_dt;
        accumulator = accumulator + clamped_dt;
        
        let step_size = 1.0 / 60.0;
        let total_time = accumulator;
        let ticks_available = floor(total_time / step_size);
        let ticks_to_run = min(ticks_available, 4.0);
        accumulator = total_time - (ticks_to_run * step_size);
    }
}
