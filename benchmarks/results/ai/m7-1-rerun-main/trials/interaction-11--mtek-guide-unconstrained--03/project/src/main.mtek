scene Demo {
    clear_color: #202020;
    state accumulated_time: f32 = 0.0;

    camera Main {
        position: vec3(0.0, 0.0, 10.0);
        target: vec3(0.0, 0.0, 0.0);
        projection: Orthographic { height: 12.8 };
    }

    entity Ticker {
        position: vec3(-5.5, 3.0, 0.0);
        mesh: Box { size: vec3(1.0, 1.0, 0.5) };
        material: Unlit { color: #ef4444 };

        fixed_update(dt: f32) {
            self.position.x += 0.1;
        }
    }

    entity Glider {
        position: vec3(-5.5, -3.0, 0.0);
        mesh: Box { size: vec3(1.0, 1.0, 0.5) };
        material: Unlit { color: #38bdf8 };

        update(dt: f32) {
            self.position.x += 6.0 * dt;
        }
    }

    update(dt: f32) {
        accumulated_time += dt;
        var ticks = 0;
        for i in 0..4 {
            if accumulated_time >= 0.016666668 {
                accumulated_time -= 0.016666668;
                ticks += 1;
            }
        }
    }
}
