material LampMaterial {
    param is_on: bool = false;

    fragment(input: SurfaceInput) -> color {
        let on_color = color.srgb(vec3(1.0, 0.824, 0.29), 1.0);
        let off_color = color.srgb(vec3(0.227, 0.227, 0.227), 1.0);
        return mix(off_color, on_color, if is_on { 1.0 } else { 0.0 });
    }
}
===

scene Demo {
    state lampA_on: bool = false;
    state lampB_on: bool = false;

    clear_color: #202020;

    camera Main {
        position: vec3(0.0, 0.0, 10.0);
        target: vec3(0.0, 0.0, 0.0);
        projection: Orthographic { height: 12.8 };
    }

    entity LampA {
        position: vec3(-3.0, 0.0, 0.0);
        mesh: Box { size: vec3(2.0, 2.0, 0.5) };
        material: LampMaterial { is_on: bind(lampA_on); };
    }

    entity LampB {
        position: vec3(3.0, 0.0, 0.0);
        mesh: Box { size: vec3(2.0, 2.0, 0.5) };
        material: LampMaterial { is_on: bind(lampB_on); };
    }

    on key_down(Key.A) {
        lampA_on = !lampA_on;
    }

    on key_down(Key.B) {
        lampB_on = !lampB_on;
    }

    on key_down(Key.Space) {
        lampA_on = !lampA_on;
        lampB_on = !lampB_on;
    }

    on key_down(Key.Enter) {
        lampA_on = false;
        lampB_on = false;
    }
}
