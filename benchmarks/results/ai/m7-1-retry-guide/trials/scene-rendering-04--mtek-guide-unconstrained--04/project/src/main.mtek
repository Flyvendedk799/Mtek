scene Demo {
    clear_color: #9db4cc;

    camera Main {
        position: vec3(5.0, 4.0, 9.0);
        target: vec3(0.0, 1.0, 0.0);
        projection: Perspective {
            fov_y: 0.7;
            near: 0.1;
            far: 1000.0;
        };
    }

    entity Floor {
        mesh: Plane { size: vec2(12.0, 12.0) };
        material: Unlit { color: #4b5563 };
        position: vec3(0.0, 0.0, 0.0);
    }

    entity Tower {
        mesh: Box { size: vec3(1.5, 3.0, 1.5) };
        material: Unlit { color: #2563eb };
        position: vec3(0.0, 1.5, 0.0);
    }

    entity Block {
        mesh: Box { size: vec3(2.0, 1.0, 2.0) };
        material: Unlit { color: #dc2626 };
        position: vec3(1.5, 0.5, 1.8);
    }

    entity Ball {
        mesh: Sphere { radius: 0.8 };
        material: Unlit { color: #eab308 };
        position: vec3(-1.6, 0.8, 1.2);
    }
}
