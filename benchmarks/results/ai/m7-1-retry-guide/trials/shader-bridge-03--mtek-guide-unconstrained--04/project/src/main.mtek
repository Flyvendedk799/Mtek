material Sweep {
    param time: f32 = 0.0;

    fragment(input: SurfaceInput) -> color {
        let x = input.local_position.x;
        let t = time;
        let w = 0.5 + 0.5 * sin(0.8 * x + t);
        
        // Convert sRGB colors to linear
        let A_srgb = #1a237e;
        let B_srgb = #ffb300;
        let A_linear = color.linear(A_srgb.rgb, 1.0);
        let B_linear = color.linear(B_srgb.rgb, 1.0);
        
        // Blend in linear light
        let blended = color.linear(
            (1.0 - w) * A_linear.rgb + w * B_linear.rgb,
            1.0
        );
        
        return blended;
    }
}

scene Demo {
    clear_color: #202020;

    camera Main {
        position: vec3(0.0, 0.0, 6.0);
        target: vec3(0.0, 0.0, 0.0);
        projection: Perspective { fov_y: 0.9; near: 0.1; far: 1000.0; };
    }

    entity Panel {
        mesh: Box { size: vec3(4.0, 2.0, 0.2); };
        material: Sweep { time: bind(frame.time); };
        position: vec3(0.4, 0.0, 0.0);
    }
}
