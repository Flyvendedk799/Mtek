const SPEED: f32 = 4.0;

const RIGHT_END: f32 = 6.0;

const LAP: f32 = 12.0;

scene Demo {
    clear_color: #202020;
    state moving: bool = false;

    camera Main {
        position: vec3(0.0, 0.0, 10.0);
        target: vec3(0.0, 0.0, 0.0);
        projection: Orthographic { height: 12.8 };
    }

    entity Track {
        position: vec3(0.0, -1.0, 0.0);
        mesh: Box { size: vec3(12.0, 0.2, 0.2) };
        material: Unlit { color: #404040 };
    }

    entity Runner {
        position: vec3(-5.0, 0.0, 0.0);
        mesh: Box { size: vec3(1.0, 1.0, 0.5) };
        material: Unlit { color: #f97316 };

        update(dt: f32) {
            if moving {
                var x = self.position.x + SPEED * dt;
                if x >= RIGHT_END {
                    x -= LAP;
                }
                self.position.x = x;
            }
        }
    }

    on key_down(Key.Space) {
        moving = !moving;
    }
}
