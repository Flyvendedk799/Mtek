const YELLOW: color = #ffd24a;

const ORANGE: color = #ff7a1a;

const MAX_POWER: i32 = 5;

const RIGHT_LIMIT: f32 = 5.0;

fn stone_color(pulled: bool) -> color {
    if pulled {
        return ORANGE;
    }
    return YELLOW;
}

scene Demo {
    clear_color: #202020;
    state power: i32 = 0;
    state pulled: bool = false;

    camera Main {
        position: vec3(0.0, 0.0, 10.0);
        target: vec3(0.0, 0.0, 0.0);
        projection: Orthographic { height: 12.8 };
    }

    entity Rail {
        position: vec3(0.0, -1.1, 0.0);
        mesh: Box { size: vec3(12.0, 0.2, 0.2) };
        material: Unlit { color: #404040 };
    }

    entity Stone {
        position: vec3(-4.0, 0.0, 0.0);
        mesh: Box { size: vec3(2.0, 2.0, 0.5) };
        material: Unlit { color: bind(stone_color(pulled)) };
    }

    entity Power {
        position: bind(vec3(-5.5 + f32(power), 3.5, 0.0));
        mesh: Box { size: vec3(1.0, 1.0, 0.5) };
        material: Unlit { color: #38bdf8 };
    }

    on key_down(Key.Space) {
        pulled = true;
    }

    on key_down(Key.ArrowUp) {
        if pulled {
            power = min(power + 1, MAX_POWER);
        }
    }

    on key_up(Key.Space) {
        pulled = false;
        Stone.position = vec3(min(Stone.position.x + 2.0 * f32(power), RIGHT_LIMIT), 0.0, 0.0);
        power = 0;
    }
}
