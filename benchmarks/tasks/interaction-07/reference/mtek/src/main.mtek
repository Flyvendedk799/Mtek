const SLOTS: i32 = 5;

prefab Pip {
    param x: f32;
    position: vec3(x, 0.0, 0.0);
    mesh: Box { size: vec3(0.8, 0.8, 0.5) };
    material: Unlit { color: #38bdf8 };
}

scene Demo {
    clear_color: #202020;
    // The pips in the order they were added; only the first `count` entries are live references (the
    // others hold the Rail as a placeholder, a reference that is never destroyed).
    state pips: array<entity_ref, 5> = [Rail, Rail, Rail, Rail, Rail];
    state count: i32 = 0;

    camera Main {
        position: vec3(0.0, 0.0, 10.0);
        target: vec3(0.0, 0.0, 0.0);
        projection: Orthographic { height: 12.8 };
    }

    entity Rail {
        position: vec3(0.0, -1.5, 0.0);
        mesh: Box { size: vec3(12.0, 0.2, 0.2) };
        material: Unlit { color: #404040 };
    }

    on key_down(Key.Space) {
        if count < SLOTS {
            pips[count] = spawn(Pip { x: -6.0 + 2.0 * f32(count + 1) });
            count += 1;
        }
    }

    on key_down(Key.Backspace) {
        if count > 0 {
            destroy(pips[count - 1]);
            count -= 1;
        }
    }

    on key_down(Key.Enter) {
        for i in 0..count {
            destroy(pips[i]);
        }
        count = 0;
    }
}
