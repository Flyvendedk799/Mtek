scene Demo {
    clear_color: #101820;

    camera Main {
        position: vec3(0.0, 0.0, 8.0);
        target: vec3(0.0, 0.0, 0.0);
        projection: Perspective { fov_y: 0.8; near: 0.1; far: 100.0 };
    }

    entity Bar {
        rotation: quat.axis_angle(vec3(0.0, 0.0, 1.0), 0.9272952);
        mesh: Box { size: vec3(4.0, 1.0, 0.5) };
        material: Unlit { color: #f59e0b };
    }

    entity Tip {
        position: vec3(1.2, 1.6, 0.0);
        mesh: Sphere { radius: 0.6 };
        material: Unlit { color: #ef4444 };
    }
}
