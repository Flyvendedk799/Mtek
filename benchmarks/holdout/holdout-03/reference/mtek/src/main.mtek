scene Demo {
    clear_color: #0f172a;

    camera Main {
        position: vec3(0.0, 5.0, 10.0);
        target: vec3(0.0, 0.0, 0.0);
        projection: Perspective { fov_y: 0.9; near: 0.1; far: 100.0 };
    }

    entity Floor {
        mesh: Plane { size: vec2(8.0, 8.0) };
        material: Unlit { color: #4d7c0f };
    }

    entity Front {
        position: vec3(-1.3, 1.0, 0.8);
        mesh: Box { size: vec3(2.0, 2.0, 1.0) };
        material: Unlit { color: #2563eb };
    }

    entity Back {
        position: vec3(-1.5, 1.5, -1.5);
        mesh: Box { size: vec3(1.5, 3.0, 1.5) };
        material: Unlit { color: #dc2626 };
    }

    entity Tall {
        position: vec3(2.3, 1.0, -0.8);
        mesh: Box { size: vec3(1.0, 2.0, 1.0) };
        material: Unlit { color: #f97316 };
    }

    entity Orb {
        position: vec3(1.2, 0.9, -0.8);
        mesh: Sphere { radius: 0.9 };
        material: Unlit { color: #14b8a6 };
    }

    entity Ghost {
        position: vec3(0.5, 0.5, 1.0);
        visible: false;
        mesh: Box { size: vec3(1.0, 1.0, 1.0) };
        material: Unlit { color: #f8fafc };
    }
}
