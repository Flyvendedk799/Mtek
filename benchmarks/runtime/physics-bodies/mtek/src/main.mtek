// A dynamic box. Every fixed tick a small horizontal force pushes it, so the solver never lets it sleep.
prefab Crate {
    param at: vec3;
    param phase: f32;
    param tint: color;
    position: at;
    mesh: Box { size: vec3(1.0, 1.0, 1.0) };
    material: Unlit { color: tint };
    body: Dynamic { mass: 1.0 };
    collider: BoxCollider { size: vec3(1.0, 1.0, 1.0); friction: 0.5 };

    fixed_update(dt: f32) {
        self.body.apply_force(vec3(
            2.0 * sin(frame.time * 3.0 + phase),
            0.0,
            2.0 * cos(frame.time * 2.0 + 2.0 * phase)));
    }
}

