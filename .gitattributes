* text=auto eol=lf
*.png binary
*.jpg binary
*.glb binary
*.bin binary
# Audio, fonts and archives a game ships (decisions 0130, 0139): never normalise line endings.
*.wav binary
*.ogg binary
*.mp3 binary
*.flac binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.webp binary
*.zip binary

# Benchmark holdout tree hash (decision 0021): bytes are hashed as stored, so LF everywhere.
benchmarks/holdout/** text eol=lf
benchmarks/results/ai/** linguist-vendored

# Frozen definitions and captured evidence retain their hashed bytes, including
# upstream license text and Windows command output captured with CRLF.
benchmarks/runtime/animation/** -text
evidence/platform-step/** -text

# The prebuilt runtime (decision 0131): generated bundles, no text diffs.
crates/mtek-cli/prebuilt/*.js -diff linguist-generated
crates/mtek-cli/prebuilt/*.d.ts linguist-generated
