const TRAVERTINE = asset.texture("../textures/travertine.png");

const VELVET = asset.texture("../textures/velvet.png");

const WALNUT = asset.texture("../textures/walnut.png");

const STONE = asset.texture("../textures/counter.png");

const ART = asset.texture("../textures/deco.png");

// Shared geometry is authoritative for movement, sight, bullets and melee.
export const POPULATION: array<i32, 6> = [3, 4, 5, 5, 6, 7];

export const NAMES: array<string, 6> = [
    "THE LOBBY",
    "VELVET LOUNGE",
    "PRIVATE DINING",
    "THE GALLERY",
    "EXECUTIVE SUITE",
    "THE PENTHOUSE",
];

export const ACCENTS: array<color, 6> = [#57c7c1, #c96f93, #d6a566, #79a4cc, #a693d1, #e6bd75];

// Each footprint is also used by collision, rays and guard navigation.
export fn cover_count(room: i32) -> i32 {
    return [3, 6, 5, 6, 5, 6][room];
}

export fn cover_at(room: i32, i: i32) -> vec3 {
    if room == 0 {
        return [vec3(-3.5, 0.65, 1.0), vec3(4.0, 0.45, -2.0), vec3(-4.8, 1.35, -5.0)][i];
    }
    if room == 1 {
        return [
            vec3(-4.0, 0.45, -0.5),
            vec3(4.0, 0.45, -3.5),
            vec3(-4.0, 0.25, 2.0),
            vec3(4.0, 0.25, -0.5),
            vec3(-5.8, 1.4, -3.8),
            vec3(5.8, 1.4, 1.8),
        ][i];
    }
    if room == 2 {
        return [
            vec3(0.0, 0.425, -1.0),
            vec3(-5.0, 0.7, -4.0),
            vec3(5.0, 0.7, 3.0),
            vec3(-2.1, 0.4, -1.0),
            vec3(2.1, 0.4, -1.0),
        ][i];
    }
    if room == 3 {
        return [
            vec3(-2.5, 0.6, 3.0),
            vec3(2.5, 0.6, 0.6),
            vec3(-2.5, 0.6, -2.0),
            vec3(2.5, 0.6, -4.5),
            vec3(-5.0, 1.5, 0.0),
            vec3(5.0, 1.5, -1.0),
        ][i];
    }
    if room == 4 {
        return [
            vec3(2.0, 0.65, -3.0),
            vec3(-2.0, 1.4, 1.0),
            vec3(-5.0, 1.35, -4.0),
            vec3(4.7, 0.45, 2.5),
            vec3(2.5, 0.8, -6.8),
        ][i];
    }
    if room == 5 {
        return [
            vec3(3.4, 0.6, -1.0),
            vec3(1.2, 0.6, -3.4),
            vec3(-3.8, 0.425, 2.0),
            vec3(-3.8, 0.275, 0.0),
            vec3(-5.5, 1.5, -5.8),
            vec3(5.5, 1.5, -5.8),
        ][i];
    }
    return vec3(1.0, 1.0, 1.0);
}

export fn cover_size(room: i32, i: i32) -> vec3 {
    if room == 0 {
        return [vec3(4.0, 1.3, 1.6), vec3(2.0, 0.9, 3.4), vec3(1.2, 2.7, 1.2)][i];
    }
    if room == 1 {
        return [
            vec3(3.0, 0.9, 2.0),
            vec3(3.0, 0.9, 2.0),
            vec3(2.4, 0.5, 0.9),
            vec3(2.4, 0.5, 0.9),
            vec3(0.4, 2.8, 4.0),
            vec3(0.4, 2.8, 3.0),
        ][i];
    }
    if room == 2 {
        return [
            vec3(2.4, 0.85, 7.0),
            vec3(1.4, 1.4, 3.0),
            vec3(1.4, 1.4, 3.0),
            vec3(0.8, 0.8, 4.0),
            vec3(0.8, 0.8, 4.0),
        ][i];
    }
    if room == 3 {
        return [
            vec3(2.0, 1.2, 1.4),
            vec3(2.0, 1.2, 1.4),
            vec3(2.0, 1.2, 1.4),
            vec3(2.0, 1.2, 1.4),
            vec3(0.3, 3.0, 5.0),
            vec3(0.3, 3.0, 5.0),
        ][i];
    }
    if room == 4 {
        return [
            vec3(4.0, 1.3, 1.6),
            vec3(0.35, 2.8, 5.0),
            vec3(2.0, 2.7, 2.0),
            vec3(1.8, 0.9, 3.0),
            vec3(4.0, 1.6, 0.6),
        ][i];
    }
    if room == 5 {
        return [
            vec3(2.2, 1.2, 6.0),
            vec3(2.4, 1.2, 1.2),
            vec3(3.8, 0.85, 1.2),
            vec3(2.4, 0.55, 1.1),
            vec3(0.6, 3.0, 0.6),
            vec3(0.6, 3.0, 0.6),
        ][i];
    }
    return vec3(1.0, 1.0, 1.0);
}

export fn guard_at(room: i32, slot: i32) -> vec3 {
    var z = -2.5 - f32(slot / 3) * 2.0;
    var x = -4.8 + f32(slot % 3) * 4.8;
    if room == 0 && slot == 2 {
        z = -5.5;
    }
    if room == 1 {
        z = -5.9 - f32(slot / 3) * 1.0;
    }
    if room == 2 {
        x = -3.5 + f32(slot % 3) * 3.5;
        z = -5.7 - f32(slot / 3) * 1.2;
    }
    if room == 3 {
        x = -3.8 + f32(slot % 3) * 3.8;
        z = -5.8 - f32(slot / 3) * 1.1;
    }
    if room == 4 {
        x = -3.5 + f32(slot % 3) * 3.5;
        z = -5.2 - f32(slot / 3) * 1.1;
    }
    if room == 5 {
        x = -4.0 + f32(slot % 3) * 4.0;
        z = -4.7 - f32(slot / 3) * 1.2;
    }
    if room == 4 && slot == 5 {
        x = 5.7;
        z = -5.6;
    }
    return vec3(x, 0.0, z);
}

export fn blocked(p: vec3, room: i32, radius: f32) -> bool {
    if abs(p.x) > 6.6 - radius || p.z > 8.3 - radius || p.z < -9.6 + radius {
        return true;
    }
    // Doorway is the only way through the north wall.
    if p.z < -7.8 + radius && abs(p.x) > 1.35 - radius {
        return true;
    }
    for i in 0..cover_count(room) {
        let c = cover_at(room, i);
        let half = cover_size(room, i) * 0.5;
        if abs(p.x - c.x) < half.x + radius && abs(p.z - c.z) < half.z + radius {
            return true;
        }
    }
    return false;
}

// Slab ray / box intersection. Handles parallel components without division by zero.
export fn ray_box(o: vec3, d: vec3, c: vec3, h: vec3) -> f32 {
    var lo = 0.0;
    var hi = 80.0;
    for axis in 0..3 {
        var origin = o.x;
        var dir = d.x;
        var center = c.x;
        var half = h.x;
        if axis == 1 {
            origin = o.y;
            dir = d.y;
            center = c.y;
            half = h.y;
        }
        if axis == 2 {
            origin = o.z;
            dir = d.z;
            center = c.z;
            half = h.z;
        }
        if abs(dir) < 0.00001 {
            if origin < center - half || origin > center + half {
                return 80.0;
            }
        } else {
            let a = (center - half - origin) / dir;
            let b = (center + half - origin) / dir;
            lo = max(lo, min(a, b));
            hi = min(hi, max(a, b));
        }
    }
    if hi < lo {
        return 80.0;
    }
    return lo;
}

export fn obstruction(o: vec3, d: vec3, room: i32) -> f32 {
    var hit = 80.0;
    for i in 0..cover_count(room) {
        hit = min(hit, ray_box(o, d, cover_at(room, i), cover_size(room, i) * 0.5));
    }
    hit = min(hit, ray_box(o, d, vec3(-7.0, 2.0, 0.0), vec3(0.4, 2.0, 10.0)));
    hit = min(hit, ray_box(o, d, vec3(7.0, 2.0, 0.0), vec3(0.4, 2.0, 10.0)));
    hit = min(hit, ray_box(o, d, vec3(0.0, 2.0, -10.0), vec3(7.0, 2.0, 0.3)));
    hit = min(hit, ray_box(o, d, vec3(0.0, -0.2, 0.0), vec3(7.0, 0.2, 10.0)));
    return hit;
}

export fn direction(yaw: f32, pitch: f32) -> vec3 {
    return vec3(-sin(yaw) * cos(pitch), sin(pitch), -cos(yaw) * cos(pitch));
}

export fn camera_offset(v: vec3, yaw: f32, pitch: f32) -> vec3 {
    let y = v.y * cos(pitch) - v.z * sin(pitch);
    let z = v.y * sin(pitch) + v.z * cos(pitch);
    return vec3(v.x * cos(yaw) + z * sin(yaw), y, -v.x * sin(yaw) + z * cos(yaw));
}

export prefab Prop {
    param at: vec3 = vec3(0.0, 0.0, 0.0);
    param size: vec3 = vec3(1.0, 1.0, 1.0);
    param tint: color = #283137;
    tag: "decor";
    position: at;
    mesh: Box {};
    scale: size;
    material: Pbr { base_color: tint; roughness: 0.65; metallic: 0.15 };
}

export prefab Strip {
    param at: vec3 = vec3(0.0, 0.0, 0.0);
    param size: vec3 = vec3(1.0, 0.04, 0.04);
    param tint: color = #e6bd75;
    tag: "decor";
    position: at;
    mesh: Box {};
    scale: size;
    material: Unlit { color: tint };
}

// Short-lived visual feedback; never participates in collision.
export prefab Spark {
    param at: vec3 = vec3(0.0, 0.0, 0.0);
    param tint: color = #ffd997;
    tag: "effect";
    state life: f32 = 0.12;
    position: at;
    mesh: Sphere { radius: 0.075; segments: 6; rings: 4 };
    material: Unlit { color: tint };
    scale: bind(vec3(1.0, 1.0, 1.0) * max(life * 12.0, 0.01));
    update(dt: f32) {
        self.life -= dt;
        if self.life <= 0.0 {
            destroy(self);
        }
    }
}

export prefab Trace {
    param at: vec3 = vec3(0.0, 0.0, 0.0);
    param yaw: f32 = 0.0;
    param pitch: f32 = 0.0;
    param span: f32 = 1.0;
    param tint: color = #f9dca0;
    tag: "effect";
    state life: f32 = 0.055;
    position: at;
    rotation: quat.euler(pitch, yaw, 0.0);
    mesh: Box {};
    scale: vec3(0.012, 0.012, span);
    material: Unlit { color: tint };
    update(dt: f32) {
        self.life -= dt;
        if self.life <= 0.0 {
            destroy(self);
        }
    }
}

// Navigation uses expanded versions of the same furniture, not a separate approximate map.
export fn walk_clear(a: vec3, b: vec3, room: i32) -> bool {
    let delta = vec3(b.x - a.x, 0.0, b.z - a.z);
    let span = length(delta);
    for i in 0..cover_count(room) {
        let c = cover_at(room, i);
        let h = cover_size(room, i) * 0.5;
        if ray_box(
            vec3(a.x, 0.5, a.z),
            normalize(delta),
            vec3(c.x, 0.5, c.z),
            vec3(h.x + 0.36, 2.0, h.z + 0.36),
        )
            < span {
            return false;
        }
    }
    return true;
}

export fn route_direction(a: vec3, b: vec3, room: i32) -> vec3 {
    let target = vec3(b.x, 0.0, b.z);
    if walk_clear(a, target, room) {
        return normalize(target - a);
    }
    var best = 1000.0;
    var waypoint = a;
    for i in 0..cover_count(room) {
        let c = cover_at(room, i);
        let h = cover_size(room, i) * 0.5 + vec3(0.52, 0.0, 0.52);
        for corner in 0..4 {
            let sx = f32(corner % 2) * 2.0 - 1.0;
            let sz = f32(corner / 2) * 2.0 - 1.0;
            let point = vec3(c.x + sx * h.x, 0.0, c.z + sz * h.z);
            if distance(a, point) > 0.2
                && !blocked(point, room, 0.36)
                && walk_clear(a, point, room) {
                var cost = distance(a, point) + distance(point, target);
                if !walk_clear(point, target, room) {
                    cost += 4.0;
                }
                if cost < best {
                    best = cost;
                    waypoint = point;
                }
            }
        }
    }
    return normalize(waypoint - a);
}

export prefab Solid {
    param at: vec3 = vec3(0.0, 0.0, 0.0);
    param size: vec3 = vec3(1.0, 1.0, 1.0);
    param tint: color = #34313a;
    tag: "cover";
    position: at;
    mesh: Box {};
    scale: size;
    material: Pbr { base_color: tint; base_color_texture: WALNUT; roughness: 0.48 };
}

export prefab Casing {
    param at: vec3 = vec3(0.0, 0.0, 0.0);
    param velocity: vec3 = vec3(2.0, 1.0, 0.0);
    tag: "effect";
    state age: f32 = 0.0;
    position: bind(at + velocity * age - vec3(0.0, 4.9 * age * age, 0.0));
    rotation: bind(quat.euler(age * 18.0, age * 11.0, age * 9.0));
    mesh: Box { size: vec3(0.013, 0.013, 0.027) };
    material: Pbr { base_color: #c8a566; metallic: 0.8; roughness: 0.3 };
    update(dt: f32) {
        self.age += dt;
        if self.age > 0.55 {
            destroy(self);
        }
    }
}

