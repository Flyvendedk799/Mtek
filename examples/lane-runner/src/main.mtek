// Lane Runner: a small game in three scenes (decisions 0140 to 0144).
//
// Title    Enter starts a run; Backspace clears the best score (`reset()` restarts the scene,
//          shared state included).
// Run      ArrowLeft/ArrowRight change lanes, rocks fall in the three lanes, every second survived
//          is a point. Escape pauses and resumes; R restarts the run (`go_to(Run)` keeps `best`).
//          A rock in the player's lane at the player's height ends the run.
// GameOver shows the result for three seconds, then returns to the title; Enter starts a new run.
//
// `score` and `best` are `shared state`: they are copied into the next scene by name.

const LANES: array<f32, 3> = [-2.0, 0.0, 2.0];
const PARKED: f32 = 12.0;
const TOP: f32 = 9.0;
const PLAYER_Y: f32 = 0.0;

// A pseudo-random lane in 0..2.
cpu fn random_lane() -> i32 {
    return min(i32(random() * 3.0), 2);
}

scene Title {
    clear_color: #10141c;
    shared state score: i32 = 0;
    shared state best: i32 = 0;
    state started: bool = false;
    state prompt: bool = true;
    state spin: f32 = 0.0;

    camera Main {
        position: vec3(0.0, 1.0, 8.0);
        target: vec3(0.0, 0.5, 0.0);
    }

    entity Logo {
        mesh: Box { size: vec3(1.5, 1.5, 1.5) };
        material: Unlit { color: #f2b134 };
        position: vec3(0.0, 1.5, 0.0);
        rotation: bind(quat.euler(0.3, spin, 0.0));
    }

    // "Press Enter": blinks twice a second.
    entity Prompt {
        mesh: Box { size: vec3(3.0, 0.3, 0.3) };
        material: Unlit { color: #ffffff };
        position: vec3(0.0, -0.8, 0.0);
        visible: bind(prompt);
    }

    // The best score as a bar, 0.2 m per point.
    entity Best {
        mesh: Box {};
        material: Unlit { color: #3ec46d };
        position: vec3(0.0, -2.0, 0.0);
        scale: bind(vec3(0.2 * f32(best) + 0.01, 0.2, 0.2));
    }

    update(dt: f32) {
        spin += 0.8 * dt;
        if !started {
            started = true;
            every(0.5) { prompt = !prompt; }
        }
    }

    on key_down(Key.Enter) {
        score = 0;
        go_to(Run);
    }

    on key_down(Key.Backspace) {
        reset();
    }
}

scene Run {
    clear_color: #0b0e14;
    shared state score: i32 = 0;
    shared state best: i32 = 0;
    state started: bool = false;
    state lane: i32 = 1;
    state fall_speed: f32 = 5.0;
    state rocks: array<f32, 3> = [12.0, 12.0, 12.0];

    camera Main {
        position: vec3(0.0, 3.0, 10.0);
        target: vec3(0.0, 3.0, 0.0);
    }

    entity Player {
        mesh: Box { size: vec3(1.0, 1.0, 1.0) };
        material: Unlit { color: #4aa3ff };
        position: bind(vec3(LANES[lane], PLAYER_Y, 0.0));
    }

    entity RockLeft {
        mesh: Sphere { radius: 0.5 };
        material: Unlit { color: #e0584f };
        position: bind(vec3(LANES[0], rocks[0], 0.0));
    }

    entity RockMiddle {
        mesh: Sphere { radius: 0.5 };
        material: Unlit { color: #e0584f };
        position: bind(vec3(LANES[1], rocks[1], 0.0));
    }

    entity RockRight {
        mesh: Sphere { radius: 0.5 };
        material: Unlit { color: #e0584f };
        position: bind(vec3(LANES[2], rocks[2], 0.0));
    }

    // The score as a bar along the top, 0.2 m per point.
    entity Score {
        mesh: Box {};
        material: Unlit { color: #3ec46d };
        position: vec3(0.0, 7.0, 0.0);
        scale: bind(vec3(0.2 * f32(score) + 0.01, 0.2, 0.2));
    }

    update(dt: f32) {
        if !started {
            started = true;
            // A point per second survived.
            every(1.0) { score += 1; }
            // A new rock every 0.8 s, in a lane that has none falling: try the lanes in turn.
            every(0.8) {
                var pick = random_lane();
                var tries = 0;
                while rocks[pick] < PARKED && tries < 3 {
                    pick = (pick + 1) % 3;
                    tries += 1;
                }
                if tries < 3 {
                    rocks[pick] = TOP;
                }
            }
            // After 20 s the rocks fall faster.
            after(20.0) { fall_speed = 8.0; }
        }
        for i in 0..3 {
            if rocks[i] < PARKED {
                rocks[i] -= fall_speed * dt;
                if rocks[i] < -2.0 {
                    rocks[i] = PARKED;
                }
            }
        }
        let hit = rocks[lane] < PLAYER_Y + 1.0 && rocks[lane] > PLAYER_Y - 1.0;
        if hit {
            if score > best {
                best = score;
            }
            go_to(GameOver);
        }
    }

    on key_down(Key.ArrowLeft) {
        if !paused() && lane > 0 {
            lane -= 1;
        }
    }

    on key_down(Key.ArrowRight) {
        if !paused() && lane < 2 {
            lane += 1;
        }
    }

    on key_down(Key.Escape) {
        if paused() {
            resume();
        } else {
            pause();
        }
    }

    on key_down(Key.R) {
        score = 0;
        go_to(Run);
    }
}

scene GameOver {
    clear_color: #1c0b0b;
    shared state score: i32 = 0;
    shared state best: i32 = 0;
    state started: bool = false;

    camera Main {
        position: vec3(0.0, 0.0, 8.0);
        target: vec3(0.0, 0.0, 0.0);
    }

    entity Result {
        mesh: Box {};
        material: Unlit { color: #e0584f };
        position: vec3(0.0, 0.5, 0.0);
        scale: bind(vec3(0.2 * f32(score) + 0.01, 0.4, 0.4));
    }

    entity Best {
        mesh: Box {};
        material: Unlit { color: #3ec46d };
        position: vec3(0.0, -0.5, 0.0);
        scale: bind(vec3(0.2 * f32(best) + 0.01, 0.2, 0.2));
    }

    update(dt: f32) {
        if !started {
            started = true;
            after(3.0) { go_to(Title); }
        }
    }

    on key_down(Key.Enter) {
        score = 0;
        go_to(Run);
    }
}
