// Lane Runner: a small game in three scenes (decisions 0140 to 0146).
//
// Title    Enter starts a run. ArrowLeft/ArrowRight choose the difficulty, a setting that is
//          stored by itself. Backspace deletes the stored best score and setting (`clear_saved()`)
//          and restarts the title (`reset()`).
// Run      ArrowLeft/ArrowRight change lanes, rocks fall in the three lanes, every second survived
//          is a point. Escape pauses and resumes, and the pause menu (`ui`, decision 0175) offers
//          Resume, Restart and Title; R restarts the run (`go_to(Run)` keeps `best`).
//          A rock in the player's lane at the player's height ends the run.
// GameOver shows the result for three seconds, then returns to the title; Enter starts a new run.
//
// `score` and `best` are `shared state`: they are copied into the next scene by name. `best` is
// also `saved`: `save()` at the end of a run stores it, and the next visit starts with it.
// `difficulty` is a `setting`: stored whenever it changes.

const LANES: array<f32, 3> = [-2.0, 0.0, 2.0];

prefab Rock {
    param lane: i32 = 1;
    param speed: f32 = 5.0;
    tag: "rock";
    mesh: Sphere { radius: 0.5 };
    material: Unlit { color: #e0584f };
    position: vec3(LANES[lane], 9.0, 0.0);
    update(dt: f32) {
        self.position.y -= speed * dt;
        for player in tagged("player") {
            if overlap_spheres(self.position, 0.5, player.position, 0.5) {
                send(player, "hit");
                destroy(self);
            }
        }
        if self.position.y < -2.0 {
            destroy(self);
        }
    }
}

const TOP: f32 = 9.0;

const PLAYER_Y: f32 = 0.0;

enum Difficulty { Easy, Normal, Hard }

// How fast the rocks fall at the start of a run.
fn fall_speed_of(difficulty: Difficulty) -> f32 {
    return match difficulty {
        Difficulty.Easy => 3.5,
        Difficulty.Normal => 5.0,
        Difficulty.Hard => 7.0,
    };
}

// A pseudo-random lane in 0..2.
cpu fn random_lane() -> i32 {
    return min(i32(random() * 3.0), 2);
}

scene Title {
    clear_color: #10141c;
    shared state score: i32 = 0;
    shared saved state best: i32 = 0;
    setting state difficulty: Difficulty = Difficulty.Normal;

    state prompt: bool = true;
    state spin: f32 = 0.0;

    camera Main {
        position: vec3(0.0, 1.0, 8.0);
        target: vec3(0.0, 0.5, 0.0);
    }

    entity Logo {
        mesh: Box { size: vec3(1.5, 1.5, 1.5) };
        material: Unlit { color: #f2b134 };
        position: vec3(0.0, 1.5, 0.0);
        rotation: bind(quat.euler(0.3, spin, 0.0));
    }

    // "Press Enter": blinks twice a second.
    entity Prompt {
        mesh: Box { size: vec3(3.0, 0.3, 0.3) };
        material: Unlit { color: #ffffff };
        position: vec3(0.0, -0.8, 0.0);
        visible: bind(prompt);
    }

    // The best score as a bar, 0.2 m per point.
    entity Best {
        mesh: Box {};
        material: Unlit { color: #3ec46d };
        position: vec3(0.0, -2.0, 0.0);
        scale: bind(vec3(0.2 * f32(best) + 0.01, 0.2, 0.2));
    }

    update(dt: f32) {
        // The logo turns faster on a harder difficulty.
        spin += 0.16 * fall_speed_of(difficulty) * dt;
    }

    init() {
        every(0.5) {
            prompt = !prompt;
        }
    }

    on key_down(Key.Enter) {
        score = 0;
        go_to(Run);
    }

    on key_down(Key.ArrowLeft) {
        difficulty = match difficulty {
            Difficulty.Hard => Difficulty.Normal,
            _ => Difficulty.Easy,
        };
    }

    on key_down(Key.ArrowRight) {
        difficulty = match difficulty {
            Difficulty.Easy => Difficulty.Normal,
            _ => Difficulty.Hard,
        };
    }

    // Forget the stored best score and difficulty, then start the title over from its initial values.
    on key_down(Key.Backspace) {
        clear_saved();
        reset();
    }
}

scene Run {
    clear_color: #0b0e14;
    shared state score: i32 = 0;
    shared saved state best: i32 = 0;
    setting state difficulty: Difficulty = Difficulty.Normal;

    state lane: i32 = 1;
    state fall_speed: f32 = 5.0;

    camera Main {
        position: vec3(0.0, 3.0, 10.0);
        target: vec3(0.0, 3.0, 0.0);
    }

    entity Player {
        tag: "player";
        state hits: i32 = 0;
        on message(value: string) {
            self.hits += 1;
            if score > best {
                best = score;
                save();
            }
            go_to(GameOver);
        }
        mesh: Box { size: vec3(1.0, 1.0, 1.0) };
        material: Unlit { color: #4aa3ff };
        position: bind(vec3(LANES[lane], PLAYER_Y, 0.0));
    }

    // The score as a bar along the top, 0.2 m per point.
    entity Score {
        mesh: Box {};
        material: Unlit { color: #3ec46d };
        position: vec3(0.0, 7.0, 0.0);
        scale: bind(vec3(0.2 * f32(score) + 0.01, 0.2, 0.2));
    }

    // Init sees the restored difficulty setting and starts each timer once.
    init() {
        fall_speed = fall_speed_of(difficulty);
        every(1.0) {
            score += 1;
        }
        every(0.8) {
            spawn(Rock { lane: random_lane(); speed: fall_speed });
        }
        after(20.0) {
            fall_speed += 3.0;
        }
    }
    // Runs in every frame, also while the game is paused: the pause menu.
    ui(dt: f32) {
        hud.text("Score ${score}", vec2(-0.95, 0.9), 24.0, #ffffff, 0.0, hud.pixel_font());
        if paused() {
            hud.rect(vec2(0.0, 0.05), vec2(280.0, 240.0), #000000c0, 0.5);
            hud.text("PAUSED", vec2(0.0, 0.32), 32.0, #ffffff, 0.5, hud.pixel_font());
            if hud.button("Resume", vec2(0.0, 0.14), 22.0) {
                resume();
            }
            if hud.button("Restart", vec2(0.0, 0.0), 22.0) {
                score = 0;
                go_to(Run);
            }
            if hud.button("Title", vec2(0.0, -0.14), 22.0) {
                go_to(Title);
            }
        }
    }

    on key_down(Key.ArrowLeft) {
        if !paused() && lane > 0 {
            lane -= 1;
        }
    }

    on key_down(Key.ArrowRight) {
        if !paused() && lane < 2 {
            lane += 1;
        }
    }

    on key_down(Key.Escape) {
        if paused() {
            resume();
        } else {
            pause();
        }
    }

    on key_down(Key.R) {
        score = 0;
        go_to(Run);
    }
}

scene GameOver {
    clear_color: #1c0b0b;
    shared state score: i32 = 0;
    shared saved state best: i32 = 0;

    camera Main {
        position: vec3(0.0, 0.0, 8.0);
        target: vec3(0.0, 0.0, 0.0);
    }

    entity Result {
        mesh: Box {};
        material: Unlit { color: #e0584f };
        position: vec3(0.0, 0.5, 0.0);
        scale: bind(vec3(0.2 * f32(score) + 0.01, 0.4, 0.4));
    }

    entity Best {
        mesh: Box {};
        material: Unlit { color: #3ec46d };
        position: vec3(0.0, -0.5, 0.0);
        scale: bind(vec3(0.2 * f32(best) + 0.01, 0.2, 0.2));
    }

    init() {
        after(3.0) {
            go_to(Title);
        }
    }

    on key_down(Key.Enter) {
        score = 0;
        go_to(Run);
    }
}
