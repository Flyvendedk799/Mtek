// The model: one GLB, declared once and used through its accessors everywhere else (spec/assets.md section 2). The file is
// generated from explicit data by tests/assets/tools/make-glb.mjs; the compiler opens it while it checks this module, so a
// misspelled name or an unsupported feature is a compile error at the path below, never a black canvas.
export const CHAIR = asset.glb("../models/chair.glb");

// The factors of the model's own materials: the starting values of the configurable inputs.
export const FABRIC_COLOR = CHAIR.material_base_color("Fabric");
export const FABRIC_METALLIC = CHAIR.material_metallic("Fabric");
export const FABRIC_ROUGHNESS = CHAIR.material_roughness("Fabric");
export const STEEL_COLOR = CHAIR.material_base_color("Steel");
export const STEEL_METALLIC = CHAIR.material_metallic("Steel");
export const STEEL_ROUGHNESS = CHAIR.material_roughness("Steel");
