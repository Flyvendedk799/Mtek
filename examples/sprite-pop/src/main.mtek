// A sprite, a fade and a bob (decisions 0135, 0138, 0139, 0153, 0170).
// The sheet is the built-in white texture, so the cells look the same; the bob,
// the fade and the pointer marker are what you see.
scene Pop {
    clear_color: #101418;
    state t: f32 = 0.0;

    camera Cam2D {
        position: vec3(0.0, 0.0, 10.0);
        projection: Orthographic { height: 8.0 };
    }

    entity Hero {
        mesh: Plane { size: vec2(2.2, 2.2) };
        rotation: quat.euler(1.5707964, 0.0, 0.0);
        position: bind(vec3(0.0, easing.in_out_sine(fract(t)) * 0.6, 0.0));
        material: Sprite {
            columns: 4.0;
            rows: 2.0;
            cell: bind(t * 8.0);
            tint: bind(
                color.linear(vec3(0.35, 0.7, 1.0), 0.35 + 0.65 * easing.out_cubic(fract(t)))
            );
        };
    }

    update(dt: f32) {
        t = t + dt;
    }

    ui(dt: f32) {
        hud.text("SPRITE", vec2(0.0, 0.72), 32.0, #ffffff, 0.5, hud.pixel_font());
        let at = pointer_position();
        hud.rect(at, vec2(14.0, 14.0), #ffd040, 0.5);
        if is_pointer_down(0) {
            hud.text("click", vec2(0.0, -0.72), 18.0, #ffd040, 0.5, hud.pixel_font());
        }
    }
}
