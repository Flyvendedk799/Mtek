// The physics playground (decision 0002, second release demonstration): a floor, a crate called First, and
// crates that rain down on request.
//
//   Space   gives First an impulse straight up
//   C       spawns a crate at a seeded random position above the floor (`random()`, the mount option `seed`)
//
// The floor is narrower than the area crates are spawned over, so some of them miss it and fall forever: a crate
// that sinks below KILL_HEIGHT destroys itself. A sensor zone over the right half of the floor counts the crates
// that enter it, and a bar above the scene grows with that count.

// Below this height a crate destroys itself.
const KILL_HEIGHT: f32 = -10.0;

// Crates appear at this height, so they always fall onto (or past) the floor.
const SPAWN_HEIGHT: f32 = 6.0;

// Newly spawned crates are scattered over x in [-SPAWN_RANGE_X, SPAWN_RANGE_X) ...
const SPAWN_RANGE_X: f32 = 9.0;

// ... and z in [-SPAWN_RANGE_Z, SPAWN_RANGE_Z).
const SPAWN_RANGE_Z: f32 = 2.5;

// The impulse of Space, in newton-seconds: First has a mass of 2 kg, so it leaves the floor at 5 m/s.
const JUMP_IMPULSE: f32 = 10.0;

// A crate is a dynamic unit cube. The solver owns its pose from the moment it exists, so the prefab only gives
// the starting position (`origin`) and never assigns `position` or `rotation` (E5071).
prefab Crate {
    param origin: vec3 = vec3(0.0, 0.5, 0.0);
    param tint: color = #5b8def;
    position: origin;
    mesh: Box { size: vec3(1.0, 1.0, 1.0) };
    material: Pbr { base_color: tint; roughness: 0.65 };
    body: Dynamic { mass: 2.0 };
    collider: BoxCollider { size: vec3(1.0, 1.0, 1.0); friction: 0.6 };

    // Reading `self.position` is fine: it is the pose the solver wrote last tick. A destroy is queued and happens
    // at the start of the next tick.
    fixed_update(dt: f32) {
        if self.position.y < KILL_HEIGHT {
            destroy(self);
        }
    }
}

scene Playground {
    clear_color: #14181f;
    ambient_color: #ffffff;
    ambient_intensity: 0.15;

    // How many crates have entered the sensor zone, and how many are inside it now.
    state entered: i32 = 0;
    // Test probe: fixtures check balanced sensor enter/exit events.
    state inside: i32 = 0;
    // Test probe: how many crates the C key has spawned.
    state spawned: i32 = 0;

    camera Main {
        position: vec3(0.0, 8.0, 17.0);
        target: vec3(0.0, 1.5, 0.0);
        projection: Perspective { fov_y: 0.8; near: 0.1; far: 100.0 };
        // EV100 -log2(1.2): an exposure scale of 1, as in examples/material-configurator (decision 0081).
        exposure: -0.2630344;
    }

    entity Sun {
        rotation: quat.euler(-0.9, 0.4, 0.0);
        light: DirectionalLight { color: #fff4e0; intensity: 3.0 };
    }

    // Static geometry never moves; its top face is the plane y = 0, 14 x 8 units.
    entity Floor {
        position: vec3(0.0, -0.5, 0.0);
        mesh: Box { size: vec3(14.0, 1.0, 8.0) };
        material: Pbr { base_color: #3a4150; roughness: 0.9 };
        body: Static {};
        collider: BoxCollider { size: vec3(14.0, 1.0, 8.0); friction: 0.8 };
    }

    // A named instance of the prefab. Its body can be commanded by name: `First.body.apply_impulse(..)`.
    entity First: Crate {
        origin: vec3(-4.5, 0.5, 0.0);
        tint: #ff8a3d;
    }

    // The sensor zone: a collider that reports overlaps and pushes nothing. It floats half a unit above the floor,
    // so only crates (and not the floor) touch it, and it spans x in [2, 6], z in [-3, 3], y in [0.5, 2.5].
    entity Zone {
        position: vec3(4.0, 1.5, 0.0);
        body: Static {};
        collider: BoxCollider { size: vec3(4.0, 2.0, 6.0); sensor: true };

        // `other` is a reference; comparing it with a named entity is allowed, reading its fields is not (E5074).
        on collision_enter(other: entity_ref) {
            if other != First {
                entered += 1;
                inside += 1;
            }
        }
        on collision_exit(other: entity_ref) {
            if other != First {
                inside -= 1;
            }
        }
    }

    // What the zone covers, drawn as a thin plate on the floor (the sensor itself has no mesh).
    entity ZoneMarker {
        position: vec3(4.0, 0.01, 0.0);
        mesh: Box { size: vec3(4.0, 0.02, 6.0) };
        material: Unlit { color: #2f9e6a };
    }

    // The visible count: a bar that starts at x = -8 and grows by half a unit for every crate that has entered.
    // `bind` re-evaluates the expressions every frame; no handler writes the bar's position or scale.
    entity Meter {
        position: bind(vec3(-8.0 + (0.4 + 0.5 * f32(entered)) * 0.5, 6.0, -3.0));
        scale: bind(vec3(0.4 + 0.5 * f32(entered), 0.4, 0.4));
        mesh: Box { size: vec3(1.0, 1.0, 1.0) };
        material: Unlit { color: #ffd040 };
    }

    on key_down(Key.Space) {
        First.body.apply_impulse(vec3(0.0, JUMP_IMPULSE, 0.0));
    }

    // random() is seeded per application; the same seed gives the same sequence of positions.
    on key_down(Key.C) {
        let x = (random() * 2.0 - 1.0) * SPAWN_RANGE_X;
        let z = (random() * 2.0 - 1.0) * SPAWN_RANGE_Z;
        spawn(Crate { origin: vec3(x, SPAWN_HEIGHT, z) });
        spawned += 1;
    }
}
