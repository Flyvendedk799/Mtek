const RIG = asset.glb("../models/model.glb");
const DANCER = asset.glb("../models/dancer.glb");

prefab Marcher {
    param origin: vec3 = vec3(0.0, 0.0, 0.0);
    position: origin;
    mesh: RIG.mesh("Caster");
    clips_from: DANCER;
    clip: "March";
}

scene Demo {
    camera Main {}
    entity Actor {
        mesh: RIG.mesh("Caster");
        clips_from: DANCER;
        clip: "Nope";
    }
    entity Plain {
        mesh: RIG.mesh("Caster");
        clips_from: DANCER;
    }
    on key_down(Key.Space) {
        spawn(Marcher { origin: vec3(2.0, 0.0, 0.0); });
    }
}
