// Fonts for hud.text (decision 0139): a TTF file and the built-in pixel font.
const TITLE = asset.font("../fonts/RussoOne-Regular.ttf");

scene Demo {
    state score: i32 = 0;
    camera Main {}
    update(dt: f32) {
        hud.text("SCORE ${score}", vec2(0.0, 0.8), 32.0, #ffffff, 0.5, TITLE);
        hud.text("PRESS SPACE", vec2(0.0, -0.8), 16.0, #ffd060, 0.5, hud.pixel_font());
        hud.text("default family", vec2(-0.9, 0.9), 14.0, #ffffff, 0.0);
    }
}
