 "examples": [
  {
   "title": "Physics bodies and collision events",
   "source": "// A dynamic body falls onto a static one; `on collision_enter(other)` needs a collider on its host.\nscene Demo {\n    state hits: i32 = 0;\n\n    camera Main {\n        position: vec3(0.0, 3.0, 9.0);\n        target: vec3(0.0, 1.0, 0.0);\n    }\n\n    entity Floor {\n        position: vec3(0.0, -0.5, 0.0);\n        mesh: Box { size: vec3(8.0, 1.0, 8.0); };\n        body: Static {};\n        collider: BoxCollider { size: vec3(8.0, 1.0, 8.0); };\n    }\n\n    entity Ball {\n        position: vec3(0.0, 4.0, 0.0);\n        mesh: Sphere { radius: 0.5; };\n        body: Dynamic { mass: 1.0; };\n        collider: SphereCollider { radius: 0.5; restitution: 0.6; };\n\n        on collision_enter(other: entity_ref) {\n            hits += 1;\n        }\n    }\n}\n"
  },
  {
   "title": "Lights and the Pbr material",
   "source": "// Lights are entity fields; `Pbr` is the physically based built-in material.\nscene Demo {\n    ambient_color: #ffffff;\n    ambient_intensity: 0.1;\n\n    camera Main {\n        position: vec3(0.0, 2.0, 5.0);\n        target: vec3(0.0, 0.5, 0.0);\n    }\n\n    entity Sun {\n        rotation: quat.euler(-0.9, 0.4, 0.0);\n        light: DirectionalLight { color: #fff4e0; intensity: 3.0; };\n    }\n\n    entity Ball {\n        mesh: Sphere { radius: 0.6; };\n        position: vec3(0.0, 0.6, 0.0);\n        material: Pbr { base_color: #b04a2f; metallic: 0.2; roughness: 0.4; };\n    }\n}\n"
  },
  {
   "title": "A HUD, pause menu, saved score and scene change",
   "source": "// `on key_down(Key.Space)` runs when the key goes down; handlers may assign scene state.\nscene Demo {\n    state speed: f32 = 0.7;\n    state score: i32 = 0;\n    shared saved state best: i32 = 0;\n\n    init() {\n        after(30.0) {\n            go_to(Demo);\n        }\n    }\n\n    camera Main {\n        position: vec3(0.0, 2.0, 5.0);\n        target: vec3(0.0, 0.5, 0.0);\n    }\n\n    entity Cube {\n        mesh: Box {};\n\n        update(dt: f32) {\n            self.rotation *= quat.axis_angle(vec3(0.0, 1.0, 0.0), speed * dt);\n        }\n    }\n\n    on key_down(Key.Space) {\n        speed = -speed;\n        score += 1;\n        if score > best {\n            best = score;\n            save();\n        }\n    }\n\n    ui(dt: f32) {\n        hud.text(\"Best ${best}\", vec2(0.0, 0.8), 24.0, #ffffff, 0.5);\n        if paused() {\n            if hud.button(\"Resume\", vec2(0.0, 0.0), 24.0) {\n                resume();\n            }\n        } else if hud.button(\"Pause\", vec2(0.0, 0.0), 24.0) {\n            pause();\n        }\n    }\n\n    on key_down(Key.Enter) {\n        go_to(Demo);\n    }\n}\n"
  },
  {
   "title": "Pointer events and arrays",
   "source": "// `on pointer_down(event: PointerEvent)` receives a click; arrays have a fixed length and index with `[i]`.\nconst PALETTE: array<color, 3> = [#ff5a5f, #ffd166, #06d6a0];\n\nscene Demo {\n    state index: i32 = 0;\n    state tint: color = #ff5a5f;\n\n    camera Main {\n        position: vec3(0.0, 2.0, 5.0);\n        target: vec3(0.0, 0.5, 0.0);\n    }\n\n    entity Cube {\n        mesh: Box {};\n        material: Unlit { color: bind(tint); };\n    }\n\n    on pointer_down(event: PointerEvent) {\n        index = (index + 1) % 3;\n        tint = PALETTE[index];\n    }\n}\n"
  }
 ],
