        "base_color: color = #ffffff [WB]",
        "metallic: f32 = 0.0 [WB]",
        "roughness: f32 = 0.5 [WB]",
        "base_color_texture: texture = texture.white() [C]",
        "base_color_sampler: sampler = sampler.linear_repeat() [C]"
      ]
    },
    {
      "name": "Perspective",
      "fields": [
