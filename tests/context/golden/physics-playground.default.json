  "schemaGuide": "A field line reads `name: type = default [flags]`; R required, W writable, B bindable, C construction-only.",
  "schemas": [
    {
      "name": "Box",
      "fields": [
        "size: vec3 = vec3(1.0, 1.0, 1.0) [C]"
      ]
    },
    {
      "name": "BoxCollider",
      "fields": [
        "size: vec3 [RC]",
        "sensor: bool = false [C]",
        "friction: f32 = 0.5 [C]",
        "restitution: f32 = 0.0 [C]"
      ]
    },
    {
      "name": "Camera",
      "fields": [
        "position: vec3 = vec3(0.0, 0.0, 5.0) [WB]",
        "target: vec3 [WB]",
        "rotation: quat = quat.identity() [WB]",
        "projection: projection = Perspective {} [C]",
        "active: bool [C]",
        "exposure: f32 = -1.9145305 [C]"
      ]
    },
    {
      "name": "DirectionalLight",
      "fields": [
        "color: color = #ffffff [WB]",
        "intensity: f32 = 1.0 [WB]"
      ]
    },
    {
      "name": "Entity",
      "fields": [
        "position: vec3 = vec3(0.0, 0.0, 0.0) [WB]",
        "rotation: quat = quat.identity() [WB]",
        "scale: vec3 = vec3(1.0, 1.0, 1.0) [WB]",
        "visible: bool = true [WB]",
        "mesh: mesh [C]",
        "material: material = Unlit {} [C]",
        "light: light [C]",
        "body: body [C]",
        "collider: collider [C]",
        "tag: string [C]",
        "particles: emitter [C]",
        "clip: string [C]"
      ]
    },
    {
      "name": "Pbr",
