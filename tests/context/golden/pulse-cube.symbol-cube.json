  "schemaGuide": "A field line reads `name: type = default [flags]`; R required, W writable, B bindable, C construction-only.",
  "schemas": [
    {
      "name": "Box",
      "fields": [
        "size: vec3 = vec3(1.0, 1.0, 1.0) [C]"
      ]
    },
    {
      "name": "Entity",
      "fields": [
        "position: vec3 = vec3(0.0, 0.0, 0.0) [WB]",
        "rotation: quat = quat.identity() [WB]",
        "scale: vec3 = vec3(1.0, 1.0, 1.0) [WB]",
        "visible: bool = true [WB]",
        "mesh: mesh [C]",
        "material: material = Unlit {} [C]",
        "light: light [C]",
        "body: body [C]",
        "collider: collider [C]",
        "tag: string [C]",
        "particles: emitter [C]",
        "clip: string [C]"
      ]
    }
