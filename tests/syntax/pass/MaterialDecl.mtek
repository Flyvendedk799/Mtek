material Empty {}
material OnlyStage {
    fragment(input: SurfaceInput) -> color { return #ffffff; }
}
export material Pulse {
    param tint: color = #6b5cff;
    param phase: f32 = 0.0;
    fragment(input: SurfaceInput) -> color {
        return color.linear(tint.rgb * pulse(phase), tint.a);
    }
}
fn pulse(t: f32) -> f32 { return 0.65 + 0.35 * sin(t); }
