prefab Crate {
    param origin: vec3 = vec3(0.0, 2.0, 0.0);

    position: origin;
    mesh: Box { size: vec3(1.0, 1.0, 1.0) };
    material: Unlit { color: #6b5cff };
    body: Dynamic { mass: 1.0 };
    collider: BoxCollider { size: vec3(1.0, 1.0, 1.0) };
}

scene Playground {
    camera Main {
        position: vec3(0.0, 3.0, 8.0);
        target: vec3(0.0, 1.0, 0.0);
    }

    entity Floor {
        position: vec3(0.0, -0.25, 0.0);
        mesh: Box { size: vec3(12.0, 0.5, 12.0) };
        material: Unlit { color: #303540 };
        body: Static {};
        collider: BoxCollider { size: vec3(12.0, 0.5, 12.0) };
    }

    entity First: Crate {
        origin: vec3(0.0, 3.0, 0.0);
    }

    on key_down(Key.Space) {
        First.body.apply_impulse(vec3(0.0, 4.0, 0.0));
    }
}
