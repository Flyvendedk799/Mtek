import { Shared } from "./shared.mtek";
export const LIMIT: i32 = 3;
export struct Pair {
    a: f32;
    b: f32;
}

cpu fn log_all(count: i32) {
    var total: i32 = 0;
    for i in 0..count {
        if i == 1 { continue; } else { total += i; }
        if total > 100 { break; }
    }
    let done = true;
    let pending = false;
    return;
}

material Flat {
    param tint: color = #808080;
    fragment(input: SurfaceInput) -> color { return tint; }
}

prefab Marker {
    param origin: vec3 = vec3(0.0);
    position: origin;
    state hits: i32 = 0;
    on pointer_down(event: PointerEvent) { self.hits += 1; }
}

scene Main {
    entity Point: Marker { origin: vec3(1.0); }
    camera Cam {
        position: vec3(0.0, 0.0, 5.0);
        target: bind(Point.position);
    }
}
