// The tween example of spec/tweens.md section 2 (decision 0135).
scene Tween {
    // 0 at the start of the tween, 1 at its end.
    state t: f32 = 0.0;
    camera Cam {
        position: vec3(0.0, 0.0, 6.0);
    }
    entity Ball {
        position: bind(mix(vec3(-2.0, 0.0, 0.0), vec3(2.0, 0.0, 0.0), easing.in_out_cubic(t)));
        mesh: Sphere { radius: 0.5 };
    }
    update(dt: f32) {
        // A one-second tween.
        t = min(t + dt / 1.0, 1.0);
    }
    on key_down(Key.Space) {
        t = 0.0;
    }
}
