const NAME: f32 = 1.0;
const UNTYPED = 2;
fn name(p: f32, q: i32) -> f32 { return p; }
cpu fn cpu_name(p: f32) { print("x"); }
struct Name { field: f32; other: vec3; }
material Mat { fragment(input: SurfaceInput) -> color { return #ffffff; } }
prefab Pre { position: vec3(0.0); }
scene Sc { }
