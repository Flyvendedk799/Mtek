// A line comment.
/// A doc comment
/// on two lines.
fn /* inline */ f() { }

/* A block comment
   over several lines. */

/* nested /* inside */ still comment */
const A: i32 = 1; // trailing
/**/ /***/ //// four slashes are an ordinary comment
