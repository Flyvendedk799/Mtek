;; array literals separate elements with commas and allow a trailing comma
; [1, 2, 3]
(array (lit int 1) (lit int 2) (lit int 3))

; [1, 2, 3,]
(array (lit int 1) (lit int 2) (lit int 3))

; [1]
(array (lit int 1))

; [a + b, c * d]
(array (binary + (name a) (name b)) (binary * (name c) (name d)))

; [[1, 2], [3, 4]]
(array (array (lit int 1) (lit int 2)) (array (lit int 3) (lit int 4)))

; [vec3(0.0, 1.0, 0.0), vec3(1.0)]
(array
  (call (name vec3) (lit float 0.0) (lit float 1.0) (lit float 0.0))
  (call (name vec3) (lit float 1.0)))

; [Box { size: 1.0 }, Sphere { radius: 2.0 }]
(array
  (desc Box (field size (lit float 1.0)))
  (desc Sphere (field radius (lit float 2.0))))

; [1, 2, 3][i]
(index (array (lit int 1) (lit int 2) (lit int 3)) (name i))

; [a, b].x
(field (array (name a) (name b)) x)

; f([1, 2], [3])
(call (name f) (array (lit int 1) (lit int 2)) (array (lit int 3)))
