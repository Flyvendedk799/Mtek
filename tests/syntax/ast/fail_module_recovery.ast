(module
  (fn pulse
    (params (param t (type f32)))
    (ret (type f32))
    (block
      (let amplitude (error))
      (let phase (type (error)) (lit float 1.0))
      (return
        (binary *
          (name amplitude)
          (call (name sin) (binary + (name t) (name phase)))))))
  (scene Main
    (state speed (type f32) (lit float 0.7))
    (init speed2 (lit float 0.5))
    (entity Cube
      (init position (call (name vec3) (lit float 0.0)))
      (init scale (error)))
    (lifecycle update
      (params (param dt (type f32)))
      (block (assign += (name speed) (name dt)))))
  (error)
  (struct Pair (field a (type f32)) (field b (type f32))))
