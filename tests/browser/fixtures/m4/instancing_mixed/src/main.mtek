// M4-08 compatible instancing fixture with groups that must stay apart. Seventeen entities, five kinds:
//
//   A0..A5   six boxes (1 x 1 x 1), Shade with the default tint X         group 1: 6 instances (A5 moves with mover_x)
//   S0..S3   four spheres (radius 0.5), Shade with tint X                 group 2: 4 instances (another mesh)
//   C0..C2   three boxes (1 x 1 x 1), Shade with tint Y                   group 3: 3 instances (another parameter block)
//   U0..U2   three boxes (1 x 1 x 1), Unlit                               group 4: 3 instances (another material, pipeline)
//   E0       one box (1.5 x 1.5 x 1.5), Shade with tint X                 alone: drawn individually (another mesh)
//
// A, S and E have the same material and the same parameters: they share one parameter block (the lowest
// instance, A0's, names it) but differ in mesh, so they are separate groups. The expected counters are
// 17 entities, 5 draw calls, 4 instanced draws, 3 shared parameter blocks (X, Y, Unlit) and none owned.
// Every entity has its own rotation, so the per-instance normal matrices differ; the material reads the
// world normal and position, so a wrong matrix shows in the pixels.
material Shade {
    param tint: color = #ffc040;

    fragment(input: SurfaceInput) -> color {
        let shade = 0.2 + 0.5 * abs(input.world_normal.y) + 0.3 * abs(input.world_normal.x);
        let height = 0.02 * abs(input.world_position.y);
        return color.linear(tint.rgb * shade + vec3(height, height, height), 1.0);
    }
}

scene Mixed {
    clear_color: #202830;
    state mover_x: f32 = 0.0;

    camera Main {
        position: vec3(0.0, 0.0, 16.0);
        target: vec3(0.0, 0.0, 0.0);
    }

    entity A0 { position: vec3(-10.0, 4.0, 0.0); rotation: quat.euler(0.3, 0.5, 0.0); mesh: Box { size: vec3(1.0, 1.0, 1.0) }; material: Shade { tint: #ffc040 }; }
    entity A1 { position: vec3(-8.0, 4.0, 0.0); rotation: quat.euler(0.9, 0.2, 0.0); mesh: Box { size: vec3(1.0, 1.0, 1.0) }; material: Shade { tint: #ffc040 }; }
    entity A2 { position: vec3(-6.0, 4.0, 0.0); rotation: quat.euler(0.1, 1.1, 0.0); mesh: Box { size: vec3(1.0, 1.0, 1.0) }; material: Shade { tint: #ffc040 }; }
    entity A3 { position: vec3(-4.0, 4.0, 0.0); rotation: quat.euler(1.3, 0.7, 0.0); mesh: Box { size: vec3(1.0, 1.0, 1.0) }; material: Shade { tint: #ffc040 }; }
    entity A4 { position: vec3(-2.0, 4.0, 0.0); rotation: quat.euler(0.6, 1.5, 0.0); mesh: Box { size: vec3(1.0, 1.0, 1.0) }; material: Shade { tint: #ffc040 }; }
    entity A5 { position: bind(vec3(mover_x, 4.0, 0.0)); rotation: quat.euler(0.4, 0.4, 0.0); mesh: Box { size: vec3(1.0, 1.0, 1.0) }; material: Shade { tint: #ffc040 }; }

    entity S0 { position: vec3(-9.0, 1.5, 0.0); mesh: Sphere { radius: 0.5 }; material: Shade { tint: #ffc040 }; }
    entity S1 { position: vec3(-6.0, 1.5, 0.0); mesh: Sphere { radius: 0.5 }; material: Shade { tint: #ffc040 }; }
    entity S2 { position: vec3(-3.0, 1.5, 0.0); mesh: Sphere { radius: 0.5 }; material: Shade { tint: #ffc040 }; }
    entity S3 { position: vec3(0.0, 1.5, 0.0); mesh: Sphere { radius: 0.5 }; material: Shade { tint: #ffc040 }; }

    entity C0 { position: vec3(-6.0, -1.0, 0.0); rotation: quat.euler(0.5, 0.3, 0.0); mesh: Box { size: vec3(1.0, 1.0, 1.0) }; material: Shade { tint: #40ff80 }; }
    entity C1 { position: vec3(-3.0, -1.0, 0.0); rotation: quat.euler(1.0, 0.8, 0.0); mesh: Box { size: vec3(1.0, 1.0, 1.0) }; material: Shade { tint: #40ff80 }; }
    entity C2 { position: vec3(0.0, -1.0, 0.0); rotation: quat.euler(0.2, 1.2, 0.0); mesh: Box { size: vec3(1.0, 1.0, 1.0) }; material: Shade { tint: #40ff80 }; }

    entity U0 { position: vec3(-6.0, -3.5, 0.0); rotation: quat.euler(0.7, 0.1, 0.0); mesh: Box { size: vec3(1.0, 1.0, 1.0) }; material: Unlit { color: #40c0ff }; }
    entity U1 { position: vec3(-3.0, -3.5, 0.0); rotation: quat.euler(0.2, 0.6, 0.0); mesh: Box { size: vec3(1.0, 1.0, 1.0) }; material: Unlit { color: #40c0ff }; }
    entity U2 { position: vec3(0.0, -3.5, 0.0); rotation: quat.euler(1.1, 0.9, 0.0); mesh: Box { size: vec3(1.0, 1.0, 1.0) }; material: Unlit { color: #40c0ff }; }

    entity E0 { position: vec3(6.0, -4.0, 0.0); rotation: quat.euler(0.5, 0.5, 0.0); mesh: Box { size: vec3(1.5, 1.5, 1.5) }; material: Shade { tint: #ffc040 }; }
}
