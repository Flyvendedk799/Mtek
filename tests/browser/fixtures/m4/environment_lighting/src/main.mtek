scene Demo {
    clear_color: #000000;
    ambient_intensity: 0.0;

    state metal: f32 = 0.0;
    state rough: f32 = 0.5;

    camera Main {
        position: vec3(0.0, 0.0, 3.0);
        target: vec3(0.0, 0.0, 0.0);
        projection: Orthographic { height: 2.0; near: 0.1; far: 10.0 };
        exposure: -0.2630344;
    }

    entity Product {
        rotation: quat.euler(1.5707963, 0.0, 0.0);
        mesh: Plane { size: vec2(4.0, 4.0) };
        material: Pbr { base_color: #808080; metallic: bind(metal); roughness: bind(rough) };
    }
}
