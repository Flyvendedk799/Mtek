material Direct {
    param tint: color = #ffffff;
    fragment(surface: SurfaceInput) -> color {
        return lighting.pbr(surface, tint, 0.0, 0.5);
    }
}

material Mapped {
    param tint: color = #ffffff;
    fragment(surface: SurfaceInput) -> color {
        return lighting.pbr_mapped(
            surface,
            tint,
            0.0,
            0.5,
            vec3(0.5, 0.5, 1.0),
            0.0,
            1.0,
            vec3(0.0),
        );
    }
}

scene Alpha {
    clear_color: #000000;
    ambient_color: #ffffff;
    ambient_intensity: 1.0;
    state opacity: f32 = 0.35;
    camera Main {
        position: vec3(0.0, 0.0, 3.0);
        target: vec3(0.0);
        projection: Orthographic { height: 2.0; near: 0.1; far: 10.0 };
        exposure: -0.2630344;
    }
    entity Backdrop {
        position: vec3(0.0, 0.0, -0.5);
        mesh: Box { size: vec3(5.0, 3.0, 0.1) };
        material: Unlit { color: color.linear(vec3(0.08, 0.14, 0.2), 1.0) };
    }
    entity Builtin {
        position: vec3(-1.2, 0.0, 0.0);
        mesh: Box { size: vec3(0.8, 1.2, 0.05) };
        material: Pbr { base_color: bind(color.linear(vec3(0.7, 0.3, 0.1), opacity)) };
    }
    entity Authored {
        mesh: Box { size: vec3(0.8, 1.2, 0.05) };
        material: Direct { tint: bind(color.linear(vec3(0.7, 0.3, 0.1), opacity)) };
    }
    entity AuthoredMapped {
        position: vec3(1.2, 0.0, 0.0);
        mesh: Box { size: vec3(0.8, 1.2, 0.05) };
        material: Mapped { tint: bind(color.linear(vec3(0.7, 0.3, 0.1), opacity)) };
    }
}
