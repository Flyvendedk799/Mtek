// M4-08 compatible instancing fixture (generated, then committed): 500 boxes
// in a 25 x 20 grid with the same mesh and the same material parameters, so they share one parameter
// block and are one group. Each box has its own rotation and its own scale, so the per-instance model
// and normal matrices all differ, and the material reads the world normal and the world position, so a
// wrong matrix shows in the pixels. The camera is moved sideways through the host input camera_x.
// Box (col, row), col 0..24, row 0..19: position (col - 12, row - 9.5, 0), rotation euler(0.28 * ((7 col + 3 row) mod 11),
// 0.24 * ((5 col + 11 row) mod 13), 0), scale (1 + 0.15 * ((col + row) mod 3), 1 + 0.1 * ((2 col + row) mod 3), 1).
material Shade {
    param tint: color = #ffc040;

    fragment(input: SurfaceInput) -> color {
        let shade = 0.2 + 0.5 * abs(input.world_normal.y) + 0.3 * abs(input.world_normal.x);
        let height = 0.02 * abs(input.world_position.y);
        return color.linear(tint.rgb * shade + vec3(height, height, height), 1.0);
    }
}

scene Grid {
    clear_color: #202830;
    state camera_x: f32 = 0.0;

    camera Main {
        position: bind(vec3(camera_x, 0.0, 26.0));
        target: bind(vec3(camera_x, 0.0, 0.0));
    }

    entity B000 { position: vec3(-12.0, -9.5, 0.0); rotation: quat.euler(0.0, 0.0, 0.0); scale: vec3(1.0, 1.0, 1.0); mesh: Box { size: vec3(0.7, 0.7, 0.7) }; material: Shade { tint: #ffc040 }; }
    entity B001 { position: vec3(-11.0, -9.5, 0.0); rotation: quat.euler(1.96, 1.2, 0.0); scale: vec3(1.15, 1.2, 1.0); mesh: Box { size: vec3(0.7, 0.7, 0.7) }; material: Shade { tint: #ffc040 }; }
