// The CPU emitter's execution fixture (decision 0040): a function per emission rule, called by
// tests/codegen/exec.test.ts with the rows of exec.json against the real runtime bundle.
import { scale, util_pulse, wrap_add } from "./util.mtek";

struct Wave {
    amplitude: f32;
    offset: vec3;
}

const TABLE: array<f32, 4> = [1.5, 2.5, 3.5, 4.5];

// f32: every operation is rounded to binary32 (no fused multiply-add, no wider sum).
fn mul_add(a: f32, b: f32, c: f32) -> f32 {
    return a * b + c;
}

fn sum3(a: f32, b: f32, c: f32) -> f32 {
    return a + b + c;
}

// A folded literal is exactly the binary32 value.
fn tenth() -> f32 {
    return 0.1;
}

fn add_tenth(x: f32) -> f32 {
    return x + 0.1;
}

fn third(x: f32) -> f32 {
    return x / 3.0;
}

// Integers: WGSL semantics.
fn idiv(a: i32, b: i32) -> i32 {
    return a / b;
}

fn irem(a: i32, b: i32) -> i32 {
    return a % b;
}

fn imul(a: i32, b: i32) -> i32 {
    return a * b;
}

fn iadd(a: i32, b: i32) -> i32 {
    return a + b;
}

fn ineg(a: i32) -> i32 {
    return -a;
}

fn usub(a: u32, b: u32) -> u32 {
    return a - b;
}

fn udiv(a: u32, b: u32) -> u32 {
    return a / b;
}

fn urem(a: u32, b: u32) -> u32 {
    return a % b;
}

fn umul(a: u32, b: u32) -> u32 {
    return a * b;
}

// Conversions.
fn to_i32(x: f32) -> i32 {
    return i32(x);
}

fn to_u32(x: f32) -> u32 {
    return u32(x);
}

fn i_to_u(x: i32) -> u32 {
    return u32(x);
}

fn u_to_i(x: u32) -> i32 {
    return i32(x);
}

fn i_to_f(x: i32) -> f32 {
    return f32(x);
}

fn u_to_f(x: u32) -> f32 {
    return f32(x);
}

// Indexing: constant indices read directly, run-time indices are clamped (W8030).
fn pick(i: i32) -> f32 {
    return TABLE[i];
}

fn pick_u(i: u32) -> f32 {
    return TABLE[i];
}

fn second() -> f32 {
    let values = [10.0, 20.0, 30.0];
    return values[1];
}

fn nth(values: array<i32, 3>, i: u32) -> i32 {
    return values[i];
}

fn column(m: mat4, i: i32) -> vec4 {
    return m[i];
}

fn last_column(m: mat4) -> vec4 {
    return m[3];
}

// Assignment: components build new vectors, compound assignment rounds.
fn lift(v: vec3, h: f32) -> vec3 {
    var p = v;
    p.y = h;
    p.x += 1.0;
    p.z -= 0.1;
    p *= 2.0;
    return p;
}

fn count_down(n: i32) -> i32 {
    var k = n;
    k -= 3;
    k *= 2;
    k /= 0;
    return k;
}

// Swizzles and components.
fn zyx(v: vec4) -> vec3 {
    return v.zyx;
}

fn xxyy(v: vec2) -> vec4 {
    return v.xxyy;
}

fn rgb(c: color) -> vec3 {
    return c.rgb;
}

fn alpha(c: color) -> f32 {
    return c.a;
}

fn quat_w(q: quat) -> f32 {
    return q.w;
}

// Control flow.
fn sum_to(n: i32) -> i32 {
    var total = 0;
    for i in 0..n {
        if i == 3 {
            continue;
        }
        if i == 7 {
            break;
        }
        total += i;
    }
    return total;
}

fn count_u(n: u32) -> u32 {
    var c: u32 = 0;
    for i in 1..n {
        c += i;
    }
    return c;
}

fn sum_each(values: array<f32, 3>) -> f32 {
    var s = 0.0;
    for v in values {
        s += v;
    }
    return s;
}

fn classify(x: f32) -> i32 {
    if x < 0.0 {
        return -1;
    } else if x == 0.0 {
        return 0;
    } else if x > 0.0 {
        return 1;
    }
    return 2;
}

fn xor(a: bool, b: bool) -> bool {
    return a && !b || b && !a;
}

fn in_range(x: i32, lo: i32, hi: i32) -> bool {
    return lo <= x && x < hi;
}

// Structs.
fn make_wave(a: f32) -> Wave {
    return Wave { offset: vec3(a, 0.0, -a); amplitude: a * 2.0 };
}

fn wave_at(w: Wave, t: f32) -> vec3 {
    return w.offset * (w.amplitude * t);
}

fn wave_sum(waves: array<Wave, 2>) -> f32 {
    var total = 0.0;
    for w in waves {
        total += w.amplitude;
    }
    return total;
}

// Vectors, quaternions and matrices through rt.
fn rotate(q: quat, v: vec3) -> vec3 {
    return q * v;
}

fn transform(m: mat4, v: vec4) -> vec4 {
    return m * v;
}

fn spin(angle: f32) -> quat {
    return quat.axis_angle(vec3(0.0, 1.0, 0.0), angle);
}

fn hypot(v: vec2) -> f32 {
    return length(v);
}

fn half_way(a: vec3, b: vec3) -> vec3 {
    return mix(a, b, 0.5);
}

fn tinted(base: vec3) -> color {
    return color.linear(base * 0.5, 1.0);
}

// Transcendental functions: compared within a tolerance.
fn wave(t: f32) -> f32 {
    return sin(t) * 0.5 + 0.5;
}

fn decay(t: f32) -> f32 {
    return exp(-t) * pow(2.0, t);
}

// Calls, within the module and into src/util.mtek.
fn pulse(t: f32) -> f32 {
    return t + 1.0;
}

cpu fn combined(t: f32) -> f32 {
    return pulse(t) + util_pulse(t);
}

fn doubled(v: vec3) -> vec3 {
    return scale(v, 2.0);
}

fn add_wrapped(a: u32) -> u32 {
    return wrap_add(a, 4294967295);
}

// Makes every function above CPU-reachable (decision 0038).
cpu fn reach_all() {
    mul_add(0.0, 0.0, 0.0);
    sum3(0.0, 0.0, 0.0);
    tenth();
    add_tenth(0.0);
    third(0.0);
    idiv(0, 1);
    irem(0, 1);
    imul(0, 0);
    iadd(0, 0);
    ineg(0);
    usub(0, 0);
    udiv(0, 1);
    urem(0, 1);
    umul(0, 0);
    to_i32(0.0);
    to_u32(0.0);
    i_to_u(0);
    u_to_i(0);
    i_to_f(0);
    u_to_f(0);
    pick(0);
    pick_u(0);
    second();
    nth([0, 0, 0], 0);
    column(mat4.identity(), 0);
    last_column(mat4.identity());
    lift(vec3(0.0), 0.0);
    count_down(0);
    zyx(vec4(0.0));
    xxyy(vec2(0.0));
    rgb(color.linear(vec3(0.0), 1.0));
    alpha(color.linear(vec3(0.0), 1.0));
    quat_w(quat.identity());
    sum_to(0);
    count_u(0);
    sum_each([0.0, 0.0, 0.0]);
    classify(0.0);
    xor(false, false);
    in_range(0, 0, 1);
    make_wave(0.0);
    wave_at(make_wave(0.0), 0.0);
    wave_sum([make_wave(0.0), make_wave(1.0)]);
    rotate(quat.identity(), vec3(0.0));
    transform(mat4.identity(), vec4(0.0));
    spin(0.0);
    hypot(vec2(0.0));
    half_way(vec3(0.0), vec3(1.0));
    tinted(vec3(0.0));
    wave(0.0);
    decay(0.0);
    combined(0.0);
    doubled(vec3(0.0));
    add_wrapped(0);
}

scene Functions {
    camera Main {}
}
