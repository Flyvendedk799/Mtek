      "layout": "material:src/main.mtek::Ocean",
      "wgsl": "struct MtekLight {\n    color: vec3<f32>,\n    kind: u32,\n    position: vec3<f32>,\n    range: f32,\n    direction: vec3<f32>,\n    reserved: f32,\n}\n\nstruct MtekFrame {\n    view_proj: mat4x4<f32>,\n    camera_position: vec3<f32>,\n    light_count: u32,\n    ambient: vec3<f32>,\n    reserved0: f32,\n    @align(16) lights: array<MtekLight, 4>,\n}\n\nstruct S_e2cab98b_Wave {\n    @size(8) u_amplitude: f32,\n    u_direction: vec2<f32>,\n}\n\nstruct MtekPad16_f32 {\n    @size(16) value: f32,\n}\n\nstruct MtekParams_e2cab98b_Ocean {\n    u_base: vec4<f32>,\n    u_depth: f32,\n    u_count: u32,\n    u_enabled: u32,\n    u_offset: i32,\n    u_spin: vec4<f32>,\n    u_warp: mat4x4<f32>,\n    u_tint: vec4<f32>,\n    @align(16) u_wave: S_e2cab98b_Wave,\n    @align(16) u_weights: array<MtekPad16_f32, 3>,\n}\n\nstruct MtekObject {\n    model: mat4x4<f32>,\n    normal_matrix: mat4x4<f32>,\n}\n\nstruct MtekVertexOutput {\n    @builtin(position) clip_position: vec4<f32>,\n}\n\n@group(0) @binding(0) var<uniform> mtek_frame: MtekFrame;\n@group(1) @binding(0) var<uniform> mtek_params: MtekParams_e2cab98b_Ocean;\n@group(2) @binding(0) var<uniform> mtek_object: MtekObject;\n\nfn mtek_fragment() -> vec4<f32> {\n    var u_l_level = (mtek_params.u_depth * mtek_params.u_weights[0i].value) + mtek_params.u_wave.u_amplitude;\n    if ((mtek_params.u_enabled != 0u) && (mtek_params.u_count > 2u)) && (mtek_params.u_offset < 0i) {\n        u_l_level = u_l_level * 0.5;\n    }\n    return vec4<f32>((mtek_params.u_base.xyz * u_l_level) * mtek_params.u_tint.w, 1.0);\n}\n\n@vertex\nfn mtek_vs(@location(0) mtek_position: vec3<f32>) -> MtekVertexOutput {\n    let mtek_world = mtek_object.model * vec4<f32>(mtek_position, 1.0);\n    return MtekVertexOutput(mtek_frame.view_proj * mtek_world);\n}\n\n@fragment\nfn mtek_fs() -> @location(0) vec4<f32> {\n    let mtek_color = mtek_fragment();\n    return vec4<f32>(mtek_color.xyz, 1.0);\n}\n",
