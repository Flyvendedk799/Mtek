// Scene state, entity state, writes to state, entity fields, camera fields and material params
// from lifecycle functions and handlers, and the single writer rule's allowed forms.
material Pulse {
    param tint: color = #6b5cff;
    param phase: f32 = 0.0;

    fragment(input: SurfaceInput) -> color {
        return color.linear(tint.rgb * (0.65 + 0.35 * sin(phase)), tint.a);
    }
}

cpu fn bump(x: i32) -> i32 {
    print("bump");
    return x + 1;
}

scene Demo {
    clear_color: #101418;
    state speed: f32 = 0.7;
    state angle: f32 = 0.0;
    state ticks: i32 = 0;
    state limit: f32 = speed * 10.0;

    camera Main {
        position: vec3(0.0, 0.0, 6.0);
        target: vec3(0.0, 0.0, 0.0);
    }

    entity Cube {
        state hits: i32 = bump(0);
        mesh: Box { size: vec3(1.0, 1.0, 1.0) };
        material: Pulse { phase: 0.25 };

        update(dt: f32) {
            self.hits = bump(self.hits);
            self.rotation = quat.axis_angle(vec3(0.0, 1.0, 0.0), angle);
        }

        on key_down(Key.Enter) {
            hits += 1;
        }
    }

    update(dt: f32) {
        angle += speed * dt;
        ticks = bump(ticks);
        Cube.position.y = 0.5;
        Cube.material.phase = angle;
        Cube.material.tint = #ff0000;
        Main.position = vec3(0.0, f32(Cube.hits), 6.0);
    }

    fixed_update(step: f32) {
        speed = speed - step;
    }

    on key_down(Key.Space) {
        speed = -speed;
        Cube.hits = 0;
    }

    on key_up(Key.Space) {
        print("released");
    }

    on pointer_down(event: PointerEvent) {
        angle = event.position.x;
    }
}
