// The HUD (spec/hud.md, decision 0134): text, a bar and a button, drawn every frame.
scene Main {
    state points: i32 = 0;

    camera Cam {
        position: vec3(0.0, 0.0, 5.0);
        target: vec3(0.0, 0.0, 0.0);
    }

    update(dt: f32) {
        hud.text("Score: ${points}", vec2(-0.95, 0.9), 28.0, #ffffff, 0.0);
        hud.text("centred", vec2(0.0, 0.0));
        hud.rect(vec2(-0.95, 0.8), vec2(4.0 * f32(points), 12.0), #40d070, 0.0);
        if hud.button("Add a point", vec2(0.0, -0.8), 20.0) {
            points += 1;
        }
    }
}
