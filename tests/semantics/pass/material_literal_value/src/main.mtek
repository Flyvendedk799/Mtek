// A descriptor literal of a user material whose value is not constant, as a value in a handler
// (spec/materials.md section 4; the typed IR keeps it, a constant one is folded).
material Tinted {
    param tint: color = #ffffff;
    fragment(input: SurfaceInput) -> color {
        return tint;
    }
}

scene Demo {
    state level: f32 = 0.5;
    camera Main {
        position: vec3(0.0, 1.0, 5.0);
        target: vec3(0.0, 0.0, 0.0);
    }
    entity Cube {
        mesh: Box { size: vec3(1.0, 1.0, 1.0) };
        material: Tinted { tint: #6b5cff };
    }
    update(dt: f32) {
        let candidate = Tinted { tint: color.linear(vec3(level, 0.0, 0.0), 1.0) };
    }
}
