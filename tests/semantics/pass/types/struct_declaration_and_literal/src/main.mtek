// D02 5.5: struct declarations, struct literals in the descriptor form
// (every field once, in any order; literals adopt the field types), nested
// structs and arrays of structs, field reads; folded in declaration order.
struct Light {
    intensity: f32;
    offset: vec3;
}

struct Rig {
    key: Light;
    fills: array<Light, FILLS>;
    count: u32;
}

const FILLS: u32 = 2;
const KEY = Light { offset: vec3(0, 3, 4); intensity: 1 };
const RIG: Rig = Rig {
    key: KEY;
    fills: [Light { intensity: 0.25; offset: vec3(-2.0, 1.0, 0.0) }, Light { intensity: 0.5; offset: vec3(2.0, 1.0, 0.0) }];
    count: FILLS + 1
};

scene Demo {
    camera Main {
        position: RIG.key.offset + vec3(0.0, RIG.fills[1].intensity, 0.0);
    }
    entity Lamp {
        position: RIG.fills[0].offset * KEY.intensity;
        mesh: Sphere { segments: RIG.count * 4 };
    }
}
