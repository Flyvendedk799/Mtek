// D02 5.6: `array<T, N>` with a literal or constant length, array literals
// (literals adopt the element type) and constant indexing; D02 5.3: `m[i]`
// is column `i` of a mat4.
const COUNT: u32 = 3;
const HEIGHTS: array<f32, COUNT> = [0, 0.5, 1];
const STEPS = [1, 2, 3, 4];
const OFFSETS = [vec3(0.0), vec3(1.0, 0.0, 0.0)];
const GRID: array<array<i32, 2>, 2> = [[1, 2], [3, 4]];
const MIDDLE = HEIGHTS[1];
const LAST = STEPS[COUNT];
const CORNER = GRID[1][0];
const MOVE = mat4.translation(vec3(0.0, 1.0, 5.0));

scene Demo {
    camera Main {
        position: MOVE[3].xyz;
    }
    entity Ball {
        position: OFFSETS[1] + vec3(0.0, MIDDLE, f32(LAST + CORNER));
        mesh: Sphere { segments: COUNT * 8 };
    }
}
