// D02 6.2 row 2: `+ - * /` on vectors of the same dimension, component-wise.
const A2 = vec2(1.0, 2.0) + vec2(0.5, 0.5);
const A3 = vec3(1.0, 2.0, 3.0) - vec3(0.5);
const A4 = vec4(1.0, 2.0, 3.0, 4.0) * vec4(2.0, 0.5, 1.0, 0.25);
const B3 = vec3(3.0, 6.0, 9.0) / vec3(3.0);

scene Demo {
    camera Main {
        position: A3 + B3 + vec3(A2, A4.w);
    }
}
