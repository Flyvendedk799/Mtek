// D06 6: the geometric intrinsics and `transpose`.
const LENGTH = length(vec2(3.0, 4.0));
const SCALAR_LENGTH = length(-2.0);
const DISTANCE = distance(vec3(1.0), vec3(1.0, 4.0, 5.0));
const DOT = dot(vec4(1.0), vec4(1.0, 2.0, 3.0, 4.0));
const CROSS = cross(vec3(1, 0, 0), vec3(0, 1, 0));
const NORMAL = normalize(vec3(0.0, 3.0, 4.0));
const REFLECTED = reflect(vec2(1.0, -1.0), vec2(0.0, 1.0));
const TRANSPOSED = transpose(mat4.translation(vec3(1, 2, 3)));

scene Demo {
    camera Main {}
}
