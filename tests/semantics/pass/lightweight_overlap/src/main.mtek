scene Demo {
    camera Main {}
    state hit: bool = false;
    update(dt: f32) {
        hit = overlap_spheres(vec3(0.0, 0.0, 0.0), 1.0, vec3(1.0, 0.0, 0.0), 1.0);
        hit = overlap_boxes(vec3(0.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0), quat.identity(), vec3(1.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0), quat.identity());
    }
}
