// The prefab of blueprint section 3.3 without its physics fields (M5-03): params with defaults,
// fields and a material param that read them, per-instance state, a handler, and static
// instances that set only params.
prefab Crate {
    param origin: vec3 = vec3(0.0, 2.0, 0.0);
    param tint: color = #6b5cff;
    position: origin;
    mesh: Box { size: vec3(1.0, 1.0, 1.0) };
    material: Unlit { color: tint };
    state bounces: i32 = 0;
    on key_down(Key.Space) {
        self.bounces += 1;
    }
}

scene Demo {
    camera Main {
        position: vec3(0.0, 2.0, 8.0);
        target: vec3(0.0, 1.0, 0.0);
    }
    entity First: Crate { origin: vec3(0.0, 3.0, 0.0); }
    entity Second: Crate { tint: #ff4040; }
    entity Third: Crate {}
}
