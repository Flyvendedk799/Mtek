// Dynamic entities (spec/scenes.md section 9, decision 0064): `spawn(Crate { .. })` in handlers
// and lifecycle functions returns an entity_ref whose parameters may be computed at run time; a
// reference is compared, tested with `alive` and destroyed; a named entity converts to a
// reference where one is expected; a prefab can spawn and destroy itself and others.
prefab Crate {
    param origin: vec3 = vec3(0.0, 2.0, 0.0);
    param tint: color = #6b5cff;
    param life: f32 = 2.0;
    position: origin;
    mesh: Box { size: vec3(1.0, 1.0, 1.0) };
    material: Unlit { color: tint };
    state age: f32 = 0.0;
    state child: entity_ref = self;
    update(dt: f32) {
        self.age += dt;
        if self.age > life {
            destroy(self);
        }
    }
    on key_down(Key.Enter) {
        self.child = spawn(Crate { origin: origin + vec3(0.0, 1.0, 0.0); tint: tint; life: life / 2.0; });
    }
}

scene Demo {
    state last: entity_ref = Floor;
    state spawned: i32 = 0;
    camera Main {
        position: vec3(0.0, 2.0, 8.0);
        target: vec3(0.0, 1.0, 0.0);
    }
    entity Floor {
        position: vec3(0.0, 0.0, 0.0);
        mesh: Plane { size: vec2(10.0, 10.0) };
    }
    entity Seed: Crate {}
    on key_down(Key.Space) {
        let x = f32(spawned) * 0.5;
        last = spawn(Crate { origin: vec3(x, 3.0, 0.0); tint: #ff4040; });
        spawned += 1;
    }
    on key_down(Key.Escape) {
        if alive(last) && last != Floor {
            destroy(last);
        }
        let other = last;
        if other == last {
            spawned = 0;
        }
    }
}
