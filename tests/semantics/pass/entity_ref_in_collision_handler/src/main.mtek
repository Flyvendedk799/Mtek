// A named entity compared with an `entity_ref` (spec/scenes.md section 8.3): the named entity converts to a
// reference (`other == Floor`), `self` is a reference too (decision 0064), and a body command by name is
// implemented (decision 0065).
scene Demo {
    camera Main {}
    entity Floor {
        mesh: Box {};
        body: Static {};
        collider: BoxCollider { size: vec3(1.0, 1.0, 1.0); };
    }
    entity Ball {
        mesh: Sphere {};
        body: Dynamic {};
        collider: SphereCollider { radius: 0.5; };
        on collision_enter(other: entity_ref) {
            if other == Floor {
                self.body.apply_impulse(vec3(0.0, 1.0, 0.0));
            }
            let me = self;
        }
    }
}
