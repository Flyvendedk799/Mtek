// The body of an instance holds `name: value;` of params and nothing else: a `state`, a `const`,
// a handler, a lifecycle function and a nested entity are each E5042.
prefab Crate {
    param lift: f32 = 1.0;
    position: vec3(0.0, lift, 0.0);
    mesh: Box {};
}

scene Demo {
    camera Main {}
    entity First: Crate {
        lift: 2.0;
        state hits: i32 = 0;
        const LIMIT = 3;
        update(dt: f32) {}
        on key_down(Key.Space) {}
        entity Lid { mesh: Box {}; }
    }
}
// covers: [S: prefab-instance-params]
