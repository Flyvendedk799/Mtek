// The value of a param has the param's type, however it is computed.
prefab Crate {
    param origin: vec3 = vec3(0.0, 2.0, 0.0);
    param tint: color = #6b5cff;
    position: origin;
    mesh: Box {};
    material: Unlit { color: tint };
}

scene Demo {
    state offset: f32 = 1.0;
    camera Main {}
    on key_down(Key.Space) {
        spawn(Crate { origin: offset; });
        spawn(Crate { origin: vec2(offset); });
    }
}
