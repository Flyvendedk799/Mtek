// Nine textures and samplers: one more than a material binds (E6002), at the ninth.
material Atlas {
    param t0: texture = texture.white();
    param s0: sampler = sampler.linear_repeat();
    param t1: texture = texture.white();
    param s1: sampler = sampler.linear_repeat();
    param t2: texture = texture.white();
    param s2: sampler = sampler.linear_repeat();
    param t3: texture = texture.white();
    param s3: sampler = sampler.linear_repeat();
    param t4: texture = texture.white();
    fragment(input: SurfaceInput) -> color {
        let a = sample(t0, s0, input.uv) + sample(t1, s1, input.uv);
        let b = sample(t2, s2, input.uv) + sample(t3, s3, input.uv);
        return color.linear((a + b + sample(t4, s0, input.uv)).xyz * 0.2, 1.0);
    }
}

scene Demo {
    camera Main {}
}
