// A prefab's handlers write the entity it describes through `self`.
prefab Ball {
    mesh: Sphere {};
    body: Dynamic {};
    collider: SphereCollider { radius: 0.5; };
    on key_down(Key.Space) {
        self.position = vec3(0.0, 2.0, 0.0);
    }
}

scene Demo {
    camera Main {}
    entity One: Ball {}
}
