// Everything in this prefab literal is unimplemented in this build (spawning is M5), but the
// literal is reported once. Its names are still resolved.
prefab Crate {
    param lift: f32 = 1.0;
    mesh: Box {};
}

scene Demo {
    camera Main {}
    on key_down(Key.Space) {
        let crate = Crate { lift: missing; };
    }
}
