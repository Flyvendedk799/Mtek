// Everything in this lifecycle function is unimplemented in M1 (`frame`,
// `print`, the lifecycle function itself), but the lifecycle function is
// reported once. Its names are still resolved.
scene Demo {
    camera Main {}
    update(dt: f32) {
        let xs = [1.0, 2.0];
        var total = 0.0;
        for i in 0..2 {
            total += sin(xs[i]) + frame.time;
        }
        print("done");
        total = total + missing;
    }
}
