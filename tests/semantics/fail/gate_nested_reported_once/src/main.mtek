// Everything in this function is unimplemented in M1 (statements, arrays,
// indexing, `sin`, `frame`, `print`, strings), but the function is
// reported once. Its names are still resolved.
fn everything(n: i32) -> f32 {
    let xs = [1.0, 2.0];
    var total = 0.0;
    for i in 0..n {
        total += sin(xs[i]) + frame.time;
    }
    print("done");
    return total + missing;
}

