cpu fn sample_noise(p: vec3) -> f32 {
    return p.x;
}

fn noise(p: vec3) -> f32 {
    return sample_noise(p) * 0.5;
}

fn turbulence(p: vec3) -> f32 {
    return noise(p) + noise(p * 2.0) * 0.5;
}

fn shade(p: vec3) -> f32 {
    let t = turbulence(p);
    return t * t;
}

cpu fn tick(p: vec3) -> f32 {
    return sample_noise(p) + shade(p);
}

scene Demo {
    camera Main {}
}
