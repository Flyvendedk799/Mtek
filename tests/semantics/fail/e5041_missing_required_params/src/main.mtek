// A param without a default is required at every instance: each missing one is E5041, at the
// instance's name. A param with a default may be left out.
prefab Crate {
    param origin: vec3;
    param tint: color;
    param spin: f32 = 1.0;
    position: origin;
    mesh: Box {};
    material: Unlit { color: tint };
}

scene Demo {
    camera Main {}
    entity Both: Crate { }
    entity One: Crate { origin: vec3(1.0, 0.0, 0.0); }
    entity None: Crate { origin: vec3(2.0, 0.0, 0.0); tint: #ff0000; }
}
