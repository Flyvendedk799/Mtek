// position, rotation, scale and visible can be read (decision 0151). Other fields cannot.
prefab Crate {
    param origin: vec3 = vec3(0.0, 2.0, 0.0);
    param tint: color = #6b5cff;
    position: origin;
    mesh: Box {};
    material: Unlit { color: tint };
}

scene Demo {
    camera Main {}
    entity Floor { mesh: Plane {}; }
    state last: entity_ref = Floor;
    on key_down(Key.Space) {
        last = spawn(Crate {});
        let p = last.hits;
    }
}
