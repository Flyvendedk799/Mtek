// `spawn` takes a prefab literal, `Crate { .. }`; any other value is rejected.
prefab Crate {
    param origin: vec3 = vec3(0.0, 2.0, 0.0);
    param tint: color = #6b5cff;
    position: origin;
    mesh: Box {};
    material: Unlit { color: tint };
}

scene Demo {
    camera Main {}
    on key_down(Key.Space) {
        spawn(5);
        spawn(Crate);
    }
}
