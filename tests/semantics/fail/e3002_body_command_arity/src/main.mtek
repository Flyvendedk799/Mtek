// Each command has the parameters of spec/physics.md section 3.
scene Demo {
    camera Main {}
    entity Ball {
        mesh: Sphere {};
        body: Dynamic {};
        collider: SphereCollider { radius: 0.5; };
        on key_down(Key.Space) {
            self.body.apply_impulse();
            self.body.teleport(vec3(0.0), quat.identity());
        }
    }
}
