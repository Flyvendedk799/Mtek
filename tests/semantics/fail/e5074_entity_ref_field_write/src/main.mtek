// Nor is anything written through an entity_ref.
prefab Crate {
    param origin: vec3 = vec3(0.0, 2.0, 0.0);
    param tint: color = #6b5cff;
    position: origin;
    mesh: Box {};
    material: Unlit { color: tint };
}

scene Demo {
    camera Main {}
    entity Floor { mesh: Plane {}; }
    state last: entity_ref = Floor;
    on key_down(Key.Space) {
        last = spawn(Crate {});
        last.position = vec3(0.0, 1.0, 0.0);
        last.hits += 1;
    }
}
