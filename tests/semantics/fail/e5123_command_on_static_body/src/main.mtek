// A static body takes no commands.
scene Demo {
    camera Main {}
    entity Floor {
        mesh: Box {};
        body: Static {};
        collider: BoxCollider { size: vec3(1.0, 1.0, 1.0); };
        on key_down(Key.Space) {
            Floor.body.apply_impulse(vec3(0.0, 1.0, 0.0));
        }
    }
}
