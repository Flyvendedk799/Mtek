// Each param is given once.
prefab Crate {
    param origin: vec3 = vec3(0.0, 2.0, 0.0);
    param tint: color = #6b5cff;
    position: origin;
    mesh: Box {};
    material: Unlit { color: tint };
}

scene Demo {
    camera Main {}
    on key_down(Key.Space) {
        spawn(Crate { tint: #ff0000; tint: #00ff00; });
    }
}
