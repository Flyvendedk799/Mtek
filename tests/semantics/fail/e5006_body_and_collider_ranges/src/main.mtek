// Mass is positive, damping and friction are not negative, restitution is between 0 and 1, and
// sizes are positive.
scene Demo {
    camera Main {}
    entity Heavy {
        mesh: Box {};
        body: Dynamic { mass: 0.0; linear_damping: -1.0; angular_damping: -0.5; };
        collider: BoxCollider { size: vec3(1.0, 0.0, 1.0); friction: -0.1; restitution: 1.5; };
    }
    entity Ball {
        mesh: Sphere {};
        body: Dynamic { mass: -2.0; };
        collider: SphereCollider { radius: 0.0; };
    }
}
