// An arm whose patterns were all matched by earlier arms can never run.
// covers: [S: match-patterns]
enum Phase { Menu, Playing, GameOver }

fn speed(phase: Phase) -> f32 {
    return match phase {
        Phase.Menu => 0.0,
        _ => 1.0,
        Phase.Playing => 2.0,
    };
}

fn level(phase: Phase) -> i32 {
    return match phase {
        Phase.Menu | Phase.Playing => 0,
        Phase.Menu => 1,
        Phase.GameOver => 2,
    };
}

scene Demo {
    camera Main {}
}
