// set_kinematic_target applies to kinematic bodies only.
scene Demo {
    camera Main {}
    entity Ball {
        mesh: Sphere {};
        body: Dynamic {};
        collider: SphereCollider { radius: 0.5; };
        on key_down(Key.Space) {
            self.body.set_kinematic_target(vec3(0.0), quat.identity());
        }
    }
}
