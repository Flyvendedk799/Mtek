// A scale a prefab computes from its params cannot be checked, so a dynamic body rejects it.
prefab Crate {
    param size: f32 = 1.0;
    scale: vec3(size);
    mesh: Box {};
    body: Dynamic {};
    collider: BoxCollider { size: vec3(1.0, 1.0, 1.0); };
}

scene Demo {
    camera Main {}
    entity One: Crate {}
}
