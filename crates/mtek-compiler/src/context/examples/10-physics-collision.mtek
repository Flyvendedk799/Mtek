// A dynamic body falls onto a static one; `on collision_enter(other)` needs a collider on its host.
scene Demo {
    state hits: i32 = 0;

    camera Main {
        position: vec3(0.0, 3.0, 9.0);
        target: vec3(0.0, 1.0, 0.0);
    }

    entity Floor {
        position: vec3(0.0, -0.5, 0.0);
        mesh: Box { size: vec3(8.0, 1.0, 8.0); };
        body: Static {};
        collider: BoxCollider { size: vec3(8.0, 1.0, 8.0); };
    }

    entity Ball {
        position: vec3(0.0, 4.0, 0.0);
        mesh: Sphere { radius: 0.5; };
        body: Dynamic { mass: 1.0; };
        collider: SphereCollider { radius: 0.5; restitution: 0.6; };

        on collision_enter(other: entity_ref) {
            hits += 1;
        }
    }
}
