// A material's `fragment` runs per pixel on the GPU; the `fn` helpers it calls must be GPU-safe.
fn pulse(t: f32) -> f32 {
    return 0.65 + 0.35 * sin(t);
}

material Pulse {
    param tint: color = #6b5cff;
    param phase: f32 = 0.0;

    fragment(input: SurfaceInput) -> color {
        return color.linear(tint.rgb * pulse(phase), tint.a);
    }
}

scene Demo {
    camera Main {
        position: vec3(0.0, 2.0, 5.0);
        target: vec3(0.0, 0.5, 0.0);
    }

    entity Cube {
        mesh: Box {};
        material: Pulse { phase: bind(frame.time); };
    }
}
