// Spawn tagged sprites, expire them, and start timers once in init.
prefab Spark {
    tag: "spark";
    mesh: Plane {};
    material: Sprite { columns: 1.0; rows: 1.0 };
    state age: f32 = 0.0;
    update(dt: f32) {
        age += dt;
        if age > 1.0 {
            destroy(self);
        }
    }
}

scene Demo {
    camera Main {
        position: vec3(0.0, 0.0, 6.0);
    }
    init() {
        every(0.5) {
            spawn(Spark {});
        }
        after(10.0) {
            for spark in tagged("spark") {
                destroy(spark);
            }
        }
    }
}
