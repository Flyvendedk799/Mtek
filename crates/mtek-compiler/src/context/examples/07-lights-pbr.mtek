// Lights are entity fields; `Pbr` is the physically based built-in material.
scene Demo {
    ambient_color: #ffffff;
    ambient_intensity: 0.1;

    camera Main {
        position: vec3(0.0, 2.0, 5.0);
        target: vec3(0.0, 0.5, 0.0);
    }

    entity Sun {
        rotation: quat.euler(-0.9, 0.4, 0.0);
        light: DirectionalLight { color: #fff4e0; intensity: 3.0; };
    }

    entity Ball {
        mesh: Sphere { radius: 0.6; };
        position: vec3(0.0, 0.6, 0.0);
        material: Pbr { base_color: #b04a2f; metallic: 0.2; roughness: 0.4; };
    }
}
