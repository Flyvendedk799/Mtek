// `on key_down(Key.Space)` runs when the key goes down; handlers may assign scene state.
scene Demo {
    state speed: f32 = 0.7;

    camera Main {
        position: vec3(0.0, 2.0, 5.0);
        target: vec3(0.0, 0.5, 0.0);
    }

    entity Cube {
        mesh: Box {};

        update(dt: f32) {
            self.rotation *= quat.axis_angle(vec3(0.0, 1.0, 0.0), speed * dt);
        }
    }

    on key_down(Key.Space) {
        speed = -speed;
    }
}
