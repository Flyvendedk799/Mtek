// The built-in materials (spec/materials.md section 9). Ordinary Mtek source, compiled by the
// same pipeline as user materials (decision 0044). A compiler build compiles the materials
// whose milestone it has reached; all of them since M4-03.

export material Unlit {
    param color: color = #ffffff;
    fragment(surface: SurfaceInput) -> color { return color; }
}

export material Pbr {
    param base_color: color = #ffffff;
    param metallic: f32 = 0.0;
    param roughness: f32 = 0.5;
    param base_color_texture: texture = texture.white();
    param base_color_sampler: sampler = sampler.linear_repeat();
    fragment(surface: SurfaceInput) -> color {
        let texel = sample(base_color_texture, base_color_sampler, surface.uv);
        let albedo = color.linear(base_color.rgb * texel.xyz, 1.0);
        return lighting.pbr(surface, albedo, metallic, roughness);
    }
}

// Sprites (decision 0170, spec/materials.md section 9.1): one cell of a sprite sheet of
// `columns` x `rows` equal cells, numbered left to right and top to bottom from 0, tinted.
// Its draws are always translucent, so transparent texels show what is behind them.
export material Sprite {
    param sheet: texture = texture.white();
    param sheet_sampler: sampler = sampler.nearest_clamp();
    param tint: color = #ffffff;
    param cell: f32 = 0.0;
    param columns: f32 = 1.0;
    param rows: f32 = 1.0;
    fragment(surface: SurfaceInput) -> color {
        let count = max(columns * rows, 1.0);
        let index = clamp(floor(cell - count * floor(cell / count)), 0.0, count - 1.0);
        let row = floor(index / columns);
        let column = index - row * columns;
        let uv = (surface.uv + vec2(column, row)) / vec2(columns, rows);
        let texel = sample(sheet, sheet_sampler, uv);
        return color.linear(tint.rgb * texel.xyz, tint.a * texel.w);
    }
}
