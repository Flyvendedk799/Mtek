// A small game (decisions 0140, 0145, 0150, 0151, 0152, 0153, 0175).
//
// Title   Enter starts a run. The best score is saved.
// Play    ArrowLeft and ArrowRight change lane (one step per press). Gems fall;
//         touching the player scores. Escape or the Pause button pauses the game
//         (`pause()`, spec/scenes.md §15.4): `update` stops, but `ui` (decision 0175) runs in
//         every frame, so the pause menu (Resume, Restart, Title) is drawn and its buttons
//         work. Escape resumes.
//         Miss three gems to lose. Enter on the result screen starts another run.

const LANES: array<f32, 3> = [-1.6, 0.0, 1.6];

prefab Gem {
    param lane: i32 = 1;
    tag: "gem";
    mesh: Sphere { radius: 0.35 };
    material: Unlit { color: #3ec46d };
    position: vec3(LANES[lane], 3.2, 0.0);

    update(dt: f32) {
        self.position.y -= 2.4 * dt;
    }
}

scene Title {
    clear_color: #10141c;
    shared state score: i32 = 0;
    shared saved state best: i32 = 0;

    camera Main {
        position: vec3(0.0, 0.0, 8.0);
        target: vec3(0.0, 0.0, 0.0);
    }

    ui(dt: f32) {
        hud.text("SMALL GAME", vec2(0.0, 0.35), 48.0, #ffffff, 0.5, hud.pixel_font());
        hud.text("Best ${best}", vec2(0.0, 0.05), 24.0, #ffd040, 0.5, hud.pixel_font());
        hud.text("Enter to play", vec2(0.0, -0.25), 20.0, #a0b0c0, 0.5, hud.pixel_font());
    }

    on key_down(Key.Enter) {
        score = 0;
        go_to(Play);
    }
}

scene Play {
    clear_color: #10141c;
    shared state score: i32 = 0;
    shared saved state best: i32 = 0;
    state lane: i32 = 1;
    state missed: i32 = 0;
    state game_over: bool = false;
    state spawn_in: f32 = 0.0;

    camera Main {
        position: vec3(0.0, 0.0, 8.0);
        target: vec3(0.0, 0.0, 0.0);
    }

    entity Player {
        tag: "player";
        mesh: Box { size: vec3(0.7, 0.7, 0.7) };
        material: Unlit { color: #4fa3ff };
        position: vec3(0.0, -2.0, 0.0);
    }

    update(dt: f32) {
        if game_over {
            return;
        }
        if key_pressed(Key.ArrowLeft) && lane > 0 {
            lane -= 1;
        }
        if key_pressed(Key.ArrowRight) && lane < 2 {
            lane += 1;
        }
        Player.position = vec3(LANES[lane], -2.0, 0.0);
        spawn_in -= dt;
        if spawn_in <= 0.0 {
            spawn(Gem { lane: choose([0, 1, 2]) });
            spawn_in = 0.8;
        }
        for gem in tagged("gem") {
            if distance(gem.position, Player.position) < 0.8 {
                score += 1;
                if score > best {
                    best = score;
                    save();
                }
                destroy(gem);
            } else if gem.position.y < -3.4 {
                missed += 1;
                destroy(gem);
                if missed >= 3 {
                    game_over = true;
                }
            }
        }
    }

    // Runs in every frame, also while the game is paused: the score, the Pause button and the pause menu.
    ui(dt: f32) {
        hud.text("Score ${score}", vec2(-0.95, 0.88), 24.0, #ffffff, 0.0, hud.pixel_font());
        hud.text("Best ${best}", vec2(0.95, 0.88), 24.0, #ffd040, 1.0, hud.pixel_font());
        hud.text("Missed ${missed}/3", vec2(0.0, 0.75), 18.0, #ff8060, 0.5, hud.pixel_font());
        if game_over {
            hud.text("GAME OVER", vec2(0.0, 0.2), 36.0, #ff8060, 0.5, hud.pixel_font());
            hud.text("Enter to play again", vec2(0.0, -0.1), 20.0, #ffffff, 0.5, hud.pixel_font());
        } else if paused() {
            hud.rect(vec2(0.0, 0.05), vec2(300.0, 260.0), #000000c0, 0.5);
            hud.text("PAUSED", vec2(0.0, 0.35), 36.0, #ffffff, 0.5, hud.pixel_font());
            if hud.button("Resume", vec2(0.0, 0.15), 24.0) {
                resume();
            }
            if hud.button("Restart", vec2(0.0, 0.0), 24.0) {
                score = 0;
                go_to(Play);
            }
            if hud.button("Title", vec2(0.0, -0.15), 24.0) {
                go_to(Title);
            }
        } else if hud.button("Pause", vec2(0.95, -0.88), 18.0) {
            pause();
        }
    }

    on key_down(Key.Escape) {
        if game_over {
            return;
        }
        if paused() {
            resume();
        } else {
            pause();
        }
    }

    on key_down(Key.Enter) {
        if game_over {
            score = 0;
            go_to(Play);
        }
    }
}
